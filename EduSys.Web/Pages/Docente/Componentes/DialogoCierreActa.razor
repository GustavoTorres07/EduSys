@using EduSys.Shared.DTOs

<style>
    /* --- ESTILOS UNIFICADOS DE MODAL --- */
    .mud-dialog-close-icon {
        display: none !important;
    }

    .mud-dialog-content {
        padding: 0 !important;
    }

    .dialog-container {
        display: flex;
        flex-direction: column;
        background-color: white;
        min-width: 500px;
    }

    /* HEADER AZUL CORPORATIVO */
    .dialog-header-integrated {
        background: #456990;
        color: white;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }

    .dialog-body {
        padding: 24px;
        overflow-y: auto;
        flex-grow: 1;
    }

    .actions-footer {
        padding: 16px 24px;
        border-top: 1px solid #e2e8f0;
        background-color: #f8fafc;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        flex-shrink: 0;
    }

    /* --- INPUTS FORZADOS --- */
    .force-black-text input,
    .force-black-text .mud-input-slot {
        color: #1e293b !important;
        font-weight: 600 !important;
        -webkit-text-fill-color: #1e293b !important;
    }

    .force-black-text .mud-input-label {
        color: #456990 !important;
        background-color: white !important;
        padding: 0 5px;
        font-weight: 600;
    }

    .force-black-text .mud-input-outlined-border {
        border-color: #cbd5e1 !important;
        transition: border-color 0.2s;
    }

    .force-black-text:hover .mud-input-outlined-border {
        border-color: #456990 !important;
    }

    .force-black-text.mud-input-control.mud-input-focused .mud-input-outlined-border {
        border-color: #456990 !important;
        border-width: 2px !important;
    }

    .section-title {
        color: #456990;
        font-weight: 800;
        font-size: 0.85rem;
        text-transform: uppercase;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 6px;
        margin-bottom: 12px;
        margin-top: 8px;
        letter-spacing: 0.5px;
    }
</style>

<MudDialog DisableSidePadding="true" Class="rounded-lg overflow-hidden">
    <DialogContent>
        <div class="dialog-container">

            @* --- CABECERA DINÁMICA --- *@
            <div class="dialog-header-integrated">
                <div class="d-flex align-center">
                    <MudIcon Icon="@(IdEvaluacion == 0 ? Icons.Material.Filled.LibraryBooks : Icons.Material.Filled.Lock)" Class="mr-3" />
                    <div>
                        <MudText Typo="Typo.h6" Style="font-weight: 700; line-height: 1.2; letter-spacing: -0.5px;">
                            @(IdEvaluacion == 0 ? "Cerrar Cursada Definitiva" : "Cerrar Acta de Examen")
                        </MudText>
                        <MudText Typo="Typo.caption" Style="opacity: 0.9;">
                            Formalización y archivo documental
                        </MudText>
                    </div>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="Cancel" Size="Size.Small" />
            </div>

            @* --- CUERPO --- *@
            <div class="dialog-body">
                @* Alerta de Advertencia *@
                <div class="pa-4 mb-4 rounded-lg" style="background-color: #fffbeb; border-left: 4px solid #f59e0b;">
                    <div class="d-flex align-start gap-3">
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Style="color: #d97706; margin-top: 2px;" />
                        <MudText Typo="Typo.body2" Style="color: #92400e; font-weight: 500; line-height: 1.4;">
                            <b>ATENCIÓN:</b> Al confirmar este cierre, las calificaciones quedarán en estado de <b>solo lectura</b>.
                            Esta acción es formal, irreversible por el docente y se notificará en los legajos.
                        </MudText>
                    </div>
                </div>

                @* Formulario *@
                <MudForm @bind-IsValid="@success" Model="@model">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <div class="section-title">Datos del Registro Físico</div>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="model.Libro"
                                          Label="Número de Libro"
                                          Required="true"
                                          RequiredError="Requerido"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Placeholder="Ej: 2026-A"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.MenuBook"
                                          Class="force-black-text" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="model.Folio"
                                          Label="Número de Folio"
                                          Required="true"
                                          RequiredError="Requerido"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Placeholder="Ej: 142"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Numbers"
                                          Class="force-black-text" />
                        </MudItem>

                        @* Información adicional *@
                        <MudItem xs="12" Class="mt-4">
                            <div class="pa-4 rounded-lg" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="color: #456990;" />
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 800; color: #1e3a58; text-transform: uppercase;">
                                        Instrucciones
                                    </MudText>
                                </div>
                                <MudText Typo="Typo.body2" Style="color: #64748b; font-size: 0.8rem; line-height: 1.4;">
                                    Los datos de <b>Libro</b> y <b>Folio</b> deben coincidir con el acta física firmada entregada en Secretaría Académica.
                                </MudText>
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudForm>
            </div>

            @* --- FOOTER --- *@
            <div class="actions-footer">
                <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Default" Class="rounded-lg font-weight-bold">
                    Cancelar
                </MudButton>
                <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!success)" Class="rounded-lg px-6 font-weight-bold" StartIcon="@Icons.Material.Filled.Lock">
                    Confirmar Cierre
                </MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public int IdEvaluacion { get; set; }

    private CierreActaDTO model = new();
    private bool success;

    protected override void OnInitialized()
    {
        model.IdEvaluacion = IdEvaluacion;
    }

    private void Cancel() => MudDialog.Cancel();
    
    private void Submit()
    {
        if (success)
        {
            MudDialog.Close(DialogResult.Ok(model));
        }
    }
}