@page "/mis-comisiones"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject IDocenteService DocenteService
@inject IPeriodoService PeriodoService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@attribute [Authorize(Roles = "Docente")]

<style>
    /* --- SISTEMA DE DISEÑO EDUSYS --- */
    :root {
        --edusys-primary: #1e3a58;
        --edusys-primary-light: #2c5282;
        --edusys-accent: #49BEAA;
        --edusys-text-primary: #1e293b;
        --edusys-text-secondary: #64748b;
        --edusys-border: #e2e8f0;
        --edusys-bg: #f8fafc;
    }

    /* Selectores */
    .custom-select .mud-input-outlined-border {
        border-color: var(--edusys-border) !important;
        transition: border-color 0.2s;
    }
    .custom-select:hover .mud-input-outlined-border {
        border-color: var(--edusys-primary) !important;
    }
    .custom-select.mud-input-control.mud-input-focused .mud-input-outlined-border {
        border-color: var(--edusys-primary) !important;
        border-width: 2px !important;
    }

    /* Tarjetas de Comisión */
    .comision-card {
        border: 1px solid var(--edusys-border);
        border-radius: 12px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
        background-color: white;
        overflow: hidden;
    }

    .comision-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 20px -5px rgba(30, 58, 88, 0.15) !important;
        border-color: var(--edusys-primary);
    }

    .comision-header {
        background: linear-gradient(135deg, var(--edusys-bg) 0%, white 100%);
        border-bottom: 1px solid var(--edusys-border);
        padding: 1.25rem 1.5rem;
    }

    .comision-body {
        padding: 1.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .comision-footer {
        background-color: var(--edusys-bg);
        border-top: 1px dashed var(--edusys-border);
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
    }

    .info-row {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .info-icon {
        color: var(--edusys-primary);
        margin-top: 2px;
        font-size: 1.1rem;
    }

    .info-text {
        color: var(--edusys-text-primary);
        font-size: 0.9rem;
        font-weight: 500;
        line-height: 1.4;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: var(--edusys-bg);
        border-radius: 16px;
        border: 2px dashed var(--edusys-border);
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-12">
    
    @* --- ENCABEZADO --- *@
    <div class="d-flex align-center justify-space-between mb-8 flex-wrap gap-4">
        <div class="d-flex align-center gap-4">
            <div style="background-color: #e0f2fe; padding: 12px; border-radius: 12px;">
                <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Large" Color="Color.Primary" />
            </div>
            <div>
                <MudText Typo="Typo.h4" Style="font-weight: 800; color: var(--edusys-primary); letter-spacing: -0.5px;">Mis Comisiones</MudText>
                <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Gestión operativa de cursos, asistencias y calificaciones.</MudText>
            </div>
        </div>

        @* SELECTOR DE PERÍODOS *@
        @if (periodos != null && periodos.Any())
        {
            <MudSelect T="int" Value="idPeriodoSeleccionado" ValueChanged="OnPeriodoChanged" 
                       Label="Filtrar por Período" Variant="Variant.Outlined" Margin="Margin.Dense" 
                       Class="custom-select bg-white" Style="min-width: 250px;">
                <MudSelectItem Value="0">Todos los períodos históricos</MudSelectItem>
                @foreach (var p in periodos)
                {
                    <MudSelectItem Value="@p.Id">@p.Nombre</MudSelectItem>
                }
            </MudSelect>
        }
    </div>

    @* --- CONTENIDO --- *@
    @if (cargando)
    {
        <MudGrid>
            @for (int i = 0; i < 6; i++)
            {
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Elevation="0" Class="rounded-lg" Style="border: 1px solid #e2e8f0;">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudSkeleton Width="70%" Height="30px" />
                                <MudSkeleton Width="40%" Height="20px" Class="mt-2" />
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudSkeleton Width="100%" Height="20px" Class="mb-3" />
                            <MudSkeleton Width="100%" Height="20px" Class="mb-3" />
                            <MudSkeleton Width="60%" Height="20px" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else if (comisionesFiltradas == null || !comisionesFiltradas.Any())
    {
        <div class="empty-state animate__animated animate__fadeIn">
            <MudIcon Icon="@Icons.Material.Filled.FolderOff" Style="font-size: 5rem; color: #cbd5e1;" Class="mb-4" />
            <MudText Typo="Typo.h5" Style="font-weight: 800; color: #475569;">Sin asignaciones</MudText>
            <MudText Typo="Typo.body1" Style="color: #64748b;" Class="mt-2">
                No tienes comisiones asignadas para el período seleccionado.
            </MudText>
        </div>
    }
    else
    {
        <MudGrid Spacing="4">
            @foreach (var comision in comisionesFiltradas)
            {
                <MudItem xs="12" md="6" lg="4">
                    <div class="comision-card animate__animated animate__fadeInUp">
                        
                        <div class="comision-header">
                            <div class="d-flex justify-space-between align-start mb-2">
                                <MudText Typo="Typo.h6" Style="font-weight: 800; color: var(--edusys-primary); line-height: 1.2;" Class="pr-2">
                                    @comision.Materia.ToUpper()
                                </MudText>
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Style="font-weight: 700;">
                                    @comision.CodigoComision
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Style="color: var(--edusys-text-secondary); font-weight: 600; text-transform: uppercase;">
                                @comision.Carrera
                            </MudText>
                        </div>

                        <div class="comision-body">
                            <div class="info-row">
                                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Class="info-icon" />
                                <span class="info-text">
                                    @(string.IsNullOrWhiteSpace(comision.Horario) ? "Horario a confirmar" : comision.Horario)
                                </span>
                            </div>
                            
                            <div class="info-row">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Class="info-icon" />
                                <span class="info-text">
                                    @comision.Sede - @(string.IsNullOrWhiteSpace(comision.Aula) ? "Aula a definir" : comision.Aula)
                                </span>
                            </div>
                            
                            <div class="info-row">
                                <MudIcon Icon="@Icons.Material.Filled.People" Class="info-icon" />
                                <span class="info-text">
                                    <b>@comision.CantidadAlumnos</b> alumnos inscritos
                                </span>
                            </div>

                            <MudSpacer />
                            
                            <div class="d-flex align-center gap-2 mt-2" style="background: #f1f5f9; padding: 8px 12px; border-radius: 8px;">
                                <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Size="Size.Small" Style="color: #64748b;" />
                                <MudText Typo="Typo.caption" Style="color: #475569;">
                                    Rol asignado: <b>@comision.Rol</b>
                                </MudText>
                            </div>
                        </div>

                        <div class="comision-footer">
                            <MudTooltip Text="Registro de Asistencia">
                                <MudIconButton Icon="@Icons.Material.Filled.FactCheck" 
                                               Color="Color.Secondary" 
                                               Variant="Variant.Outlined"
                                               Style="border-radius: 8px;"
                                               OnClick="@(() => Navegar($"/docente/asistencia/{comision.IdComision}"))" />
                            </MudTooltip>
                            
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       StartIcon="@Icons.Material.Filled.Grading"
                                       Style="border-radius: 8px; font-weight: 700; letter-spacing: 0.5px;"
                                       OnClick="@(() => Navegar($"/docente/calificaciones/{comision.IdComision}"))">
                                CALIFICACIONES
                            </MudButton>
                        </div>
                    </div>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private bool cargando = true;
    private List<ComisionDocenteDTO> todasLasComisiones = new();
    private List<ComisionDocenteDTO> comisionesFiltradas = new();
    
    private List<PeriodoAcademicoDTO> periodos = new();
    private int idPeriodoSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            // Ejecutamos ambas peticiones en paralelo para mayor velocidad
            var tPeriodos = PeriodoService.GetAllAsync();
            var tComisiones = DocenteService.GetMisComisionesAsync();

            await Task.WhenAll(tPeriodos, tComisiones);

            periodos = tPeriodos.Result ?? new();
            todasLasComisiones = tComisiones.Result ?? new();

            var periodoActivo = periodos.FirstOrDefault(p => p.Activo);
            if (periodoActivo != null)
            {
                idPeriodoSeleccionado = periodoActivo.Id;
            }

            AplicarFiltro();
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudieron cargar tus comisiones. Verifica tu conexión.", Severity.Error);
        }
        finally
        {
            cargando = false;
        }
    }

    private void OnPeriodoChanged(int nuevoId)
    {
        idPeriodoSeleccionado = nuevoId;
        AplicarFiltro();
    }

    private void AplicarFiltro()
    {
        // 💡 NOTA ARQUITECTÓNICA:
        // Si a futuro agregas 'IdPeriodo' al 'ComisionDocenteDTO', puedes activar este filtro real:
        // if (idPeriodoSeleccionado == 0) { comisionesFiltradas = todasLasComisiones; }
        // else { comisionesFiltradas = todasLasComisiones.Where(c => c.IdPeriodo == idPeriodoSeleccionado).ToList(); }
        
        comisionesFiltradas = todasLasComisiones;
    }

    private void Navegar(string url) => Navigation.NavigateTo(url);
}