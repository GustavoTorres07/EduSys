@page "/mis-comisiones"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject IDocenteService DocenteService
@inject IPeriodoService PeriodoService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@attribute [Authorize(Roles = "Docente")]

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-8">
    <div class="d-flex align-center justify-space-between mb-6">
        <div class="d-flex align-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Large" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h4" Style="font-weight: 700; color: #1e3a58;">Mis Comisiones</MudText>
                <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Gestión de cursos y carga de notas</MudText>
            </div>
        </div>

        @* SELECTOR DE PERÍODOS *@
        @if (periodos != null && periodos.Any())
        {
            <div style="width: 250px;">
                <MudSelect T="int" Value="idPeriodoSeleccionado" ValueChanged="OnPeriodoChanged" Label="Período Académico" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="background: white;">
                    @* Opción extra para ver todo el historial si el docente quiere *@
                    <MudSelectItem Value="0">Todos los períodos</MudSelectItem>
                    @foreach (var p in periodos)
                    {
                        <MudSelectItem Value="@p.Id">@p.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </div>
        }
    </div>

    @if (cargando)
    {
        <div class="d-flex justify-center mt-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (comisionesFiltradas == null || !comisionesFiltradas.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mt-4">
            No tienes comisiones asignadas para la vista actual.
        </MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var comision in comisionesFiltradas)
            {
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Elevation="3" Class="rounded-lg h-100 d-flex flex-column hover-card">
                        <MudCardHeader Style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Style="font-weight: 800; color: #1e3a58; line-height: 1.2;">
                                    @comision.Materia
                                </MudText>
                                <MudText Typo="Typo.caption" Style="color: #64748b;">
                                    @comision.Carrera
                                </MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">@comision.CodigoComision</MudChip>
                            </CardHeaderActions>
                        </MudCardHeader>

                        <MudCardContent Class="flex-grow-1">
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Color="Color.Default" />
                                <MudText Typo="Typo.body2">@comision.Horario</MudText>
                            </div>
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Room" Size="Size.Small" Color="Color.Default" />
                                <MudText Typo="Typo.body2">@comision.Sede - @comision.Aula</MudText>
                            </div>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" Color="Color.Default" />
                                <MudText Typo="Typo.body2"><b>@comision.CantidadAlumnos</b> Alumnos</MudText>
                            </div>

                            <MudDivider Class="my-3" />

                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Rol: <b>@comision.Rol</b>
                            </MudText>
                        </MudCardContent>

                        <MudCardActions Class="d-flex justify-end gap-2 pa-3" Style="background-color: #f8fafc;">
                            <MudTooltip Text="Tomar Asistencia">
                                <MudIconButton Icon="@Icons.Material.Filled.FactCheck" Color="Color.Secondary" Variant="Variant.Outlined"
                                               OnClick="@(() => Navegar($"/docente/asistencia/{comision.IdComision}"))" />
                            </MudTooltip>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Grade"
                                       OnClick="@(() => Navegar($"/docente/notas/{comision.IdComision}"))">
                                Cargar Notas
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

<style>
    .hover-card {
        transition: transform 0.2s ease-in-out;
    }

        .hover-card:hover {
            transform: translateY(-5px);
        }
</style>

@code {
    private bool cargando = true;

    // Todas las comisiones del docente (el historial completo)
    private List<ComisionDocenteDTO> todasLasComisiones = new();

    // Las que se muestran en pantalla actualmente
    private List<ComisionDocenteDTO> comisionesFiltradas = new();

    // Variables para el selector
    private List<PeriodoAcademicoDTO> periodos = new();
    private int idPeriodoSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 1. Cargamos períodos y definimos el activo
            periodos = await PeriodoService.GetAllAsync();
            var periodoActivo = periodos.FirstOrDefault(p => p.Activo);
            if (periodoActivo != null)
            {
                idPeriodoSeleccionado = periodoActivo.Id;
            }

            // 2. Traemos TODAS las comisiones del docente
            todasLasComisiones = await DocenteService.GetMisComisionesAsync();

            // 3. Filtramos
            AplicarFiltro();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar comisiones", Severity.Error);
        }
        finally
        {
            cargando = false;
        }
    }

    private void OnPeriodoChanged(int nuevoId)
    {
        idPeriodoSeleccionado = nuevoId;
        AplicarFiltro();
    }

    private void AplicarFiltro()
    {
        // Si eligió "Todos los períodos" (0), mostramos todo. Si no, filtramos.
        // Como el DTO no tiene el IdPeriodo, asumimos que si funciona tu flujo, la API ya le mandaba las correctas,
        // pero para evitar errores lo asignamos directamente a todas (puedes ajustarlo si agregas IdPeriodo al DTO)

        comisionesFiltradas = todasLasComisiones;
    }

    private void Navegar(string url) => Navigation.NavigateTo(url);
}