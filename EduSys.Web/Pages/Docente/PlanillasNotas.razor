    private Color GetEstadoColor(string estado) => estado switch
    {
        "Promocionado" => Color.Success,
        "Regular" => Color.Info,
        "Desaprobado" => Color.Warning,
        "Libre" => Color.Error,
        "Aprobada" => Color.Success, 
        _ => Color.Default
    };

