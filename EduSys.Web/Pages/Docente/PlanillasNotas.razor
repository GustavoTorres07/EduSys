            Nombre = evaluacion.Nombre,
            Fecha = evaluacion.Fecha,
            EsRecuperatorio = evaluacion.EsRecuperatorio,
            EsIntegrador = evaluacion.EsIntegrador,
            IdEvaluacionPadre = evaluacion.IdEvaluacionPadre
        };

        var parameters = new DialogParameters { ["model"] = evalClone, ["EvaluacionesAnteriores"] = planilla?.Evaluaciones ?? new() };

        var dialog = await DialogService.ShowAsync<DialogoEvaluacion>("Modificar Evaluación", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false });
        var result = await dialog.Result;
        
        if (!result.Canceled && result.Data is EvaluacionDTO evalEditada)
        {
            _procesando = true;
            StateHasChanged();

            try
            {
                if (await NotasService.EditarEvaluacionAsync(evalEditada)) 
                { 
                    Snackbar.Add("Evaluación modificada.", Severity.Success); 
                    await CargarDatos(); 
                }
            }
            finally { _procesando = false; }
        }
    }

