    private async Task AbrirDialogoNuevaEvaluacion()
    {
        var parameters = new DialogParameters { ["ListaAlumnos"] = planilla?.Alumnos ?? new(), ["EvaluacionesAnteriores"] = planilla?.Evaluaciones ?? new() };

        var dialog = await DialogService.ShowAsync<DialogoEvaluacion>("Nueva Instancia de Evaluación", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false });
        var result = await dialog.Result;
        
        if (!result.Canceled && result.Data is EvaluacionDTO nuevaEval)
        {
            _procesando = true;
            StateHasChanged();

            try
            {
                if (await NotasService.CrearEvaluacionAsync(IdComision, nuevaEval)) 
                { 
                    Snackbar.Add("Evaluación añadida al cronograma.", Severity.Success); 
                    await CargarDatos(); 
                }
            }
            finally { _procesando = false; }
        }
    }

    private async Task AbrirDialogoEditarEvaluacion(EvaluacionDTO evaluacion)
