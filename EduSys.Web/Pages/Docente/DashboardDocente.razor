@code {
    private string NombreDocente = "Docente";
    private List<ComisionDocenteDTO> comisiones = new();

    private List<ComisionDocenteDTO> ClasesHoy => comisiones
        .Where(c => c.Horario.ToLower().Contains(ObtenerDiaSemanaHoy()))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            NombreDocente = user.FindFirst(ClaimTypes.Name)?.Value ?? "Docente";
        }

        try
        {
            comisiones = await DocenteService.GetMisComisionesAsync();
        }
        catch { /* Manejo silencioso */ }
    }

    private void Navegar(string url) => Navigation.NavigateTo(url);

    private string ObtenerDiaSemanaHoy()
    {
        var dia = DateTime.Now.DayOfWeek;
        return dia switch
        {
            DayOfWeek.Monday => "lun",
            DayOfWeek.Tuesday => "mar",
            DayOfWeek.Wednesday => "mie",
            DayOfWeek.Thursday => "jue",
            DayOfWeek.Friday => "vie",
            DayOfWeek.Saturday => "sab",
            _ => "dom"
        };
    }

    private int ObtenerMateriasUnicas()
    {
        return comisiones.Select(c => c.Materia).Distinct().Count();
    }

    private int ObtenerSedesDistintas()
    {
        return comisiones.Select(c => c.Sede).Distinct().Count();
    }
}
