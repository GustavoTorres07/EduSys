@page "/admin/roles"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@* 🔒 CAMBIO CLAVE: Ahora protegemos por permiso granular, no por el nombre del rol "Administrador" *@
@attribute [Authorize(Roles = "SEG_ROLES_ABM, Administrador")]

@inject IRolService RolService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
    --blue:        #456990;
    --blue-dark:   #344f6e;
    --blue-mid:    #5a7fa8;
    --blue-pale:   #edf2f7;
    --teal:        #49BEAA;
    --teal-pale:   #e8faf6;
    --coral:       #EF767A;
    --coral-pale:  #fff1f2;
    --bg:          #f7f9fc;
    --surface:     #ffffff;
    --border:      #dde3ea;
    --border-dark: #c4cdd8;
    --text:        #1a2733;
    --text-mid:    #4a5568;
    --text-soft:   #8a9ab0;
    --radius:      #8px;
    --shadow:      0 1px 4px rgba(69,105,144,0.10);
    --shadow-md:   0 4px 16px rgba(69,105,144,0.13);
    --shadow-lg:   0 8px 32px rgba(69,105,144,0.16);
    --font-serif:  'Source Serif 4', Georgia, serif;
    --font-ui:     'Inter', system-ui, sans-serif;
}

.page-wrap {
    font-family: var(--font-ui);
    background: var(--bg);
    min-height: 100vh;
    padding: 28px;
    color: var(--text);
    -webkit-font-smoothing: antialiased;
}

.page-header {
    background: linear-gradient(135deg, var(--blue-dark) 0%, var(--blue) 60%, var(--blue-mid) 100%);
    border-radius: 14px;
    padding: 24px 32px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}
.header-title   { font-family: var(--font-serif); font-size: 1.6rem; font-weight: 700; color: #fff; letter-spacing: -0.3px; line-height: 1.2; }
.header-badge {
    background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);
    border-radius: 8px; padding: 8px 16px; text-align: center;
    backdrop-filter: blur(4px); flex-shrink: 0;
}
.header-badge-val { font-size: 1.4rem; font-weight: 800; color: #fff; line-height: 1; }
.header-badge-lbl { font-size: 0.6rem; font-weight: 600; color: rgba(255,255,255,0.55); text-transform: uppercase; letter-spacing: 0.5px; }

.split-layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 20px;
    align-items: start;
}

.panel-left {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    height: calc(100vh - 220px);
    min-height: 400px;
}
.panel-left-head {
    padding: 16px 18px;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    background: var(--blue-pale);
}

.search-wrap { padding: 12px 14px; border-bottom: 1px solid var(--border); position: relative; }
.search-input {
    width: 100%; background: var(--bg); border: 1.5px solid var(--border); border-radius: 8px;
    padding: 8px 10px 8px 34px; font-size: 0.82rem; font-weight: 500; outline: none;
}

.rol-list { flex: 1; overflow-y: auto; }
.rol-item {
    display: flex; align-items: center; gap: 12px; padding: 12px 18px; border-bottom: 1px solid var(--bg); cursor: pointer;
}
.rol-item.selected { background: var(--blue-pale); border-left: 3px solid var(--blue); }

.panel-right {
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
    overflow: hidden; box-shadow: var(--shadow); display: flex; flex-direction: column;
    height: calc(100vh - 220px); min-height: 400px;
}

.panel-right-head { padding: 16px 20px; border-bottom: 1px solid var(--border); background: var(--bg); display: flex; gap: 16px; }
.field-input, .field-textarea {
    background: var(--surface); border: 1.5px solid var(--border); border-radius: 8px;
    padding: 8px 12px; font-size: 0.875rem; font-weight: 600; outline: none; width: 100%;
}

.modulo-toggle {
    width: 100%; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px;
    display: flex; align-items: center; justify-content: space-between; cursor: pointer;
}

.modulo-permisos {
    border: 1px solid var(--blue); border-top: none; padding: 14px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; background: var(--surface);
}

.permiso-item { display: flex; align-items: flex-start; gap: 8px; padding: 8px 10px; border-radius: 6px; cursor: pointer; }
.permiso-item.checked { background: var(--teal-pale); }

.sk { background: linear-gradient(90deg,#eaedf1 25%,#f4f6f9 50%,#eaedf1 75%); background-size:1200px 100%; animation:sk 1.4s infinite linear; border-radius:8px; }
@@keyframes sk { 0%{background-position:-600px 0} 100%{background-position:600px 0} }
</style>

<div class="page-wrap">
    <div class="page-header">
        <div>
            <div style="font-size: 0.65rem; font-weight: 700; color: rgba(255,255,255,0.5); text-transform: uppercase;">Administración · EduSys</div>
            <div class="header-title">Roles y Permisos</div>
        </div>
        <div style="display:flex;gap:10px;">
            <div class="header-badge">
                <div class="header-badge-val">@roles.Count(r => r.Activo)</div>
                <div class="header-badge-lbl">Activos</div>
            </div>
            <div class="header-badge">
                <div class="header-badge-val">@catalogoPermisos.Count</div>
                <div class="header-badge-lbl">Permisos</div>
            </div>
        </div>
    </div>

    <div class="split-layout">
        <div class="panel-left">
            <div class="panel-left-head">
                <span style="font-size: 0.7rem; font-weight: 800; color: var(--blue); text-transform: uppercase;">Roles</span>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="NuevoRol" StartIcon="@Icons.Material.Filled.Add">Nuevo</MudButton>
            </div>
            <div class="search-wrap">
                <MudIcon Icon="@Icons.Material.Filled.Search" Style="position:absolute; left:24px; top:50%; transform:translateY(-50%); color:gray;" />
                <input class="search-input" placeholder="Buscar rol…" @bind="searchString" @bind:event="oninput" />
            </div>
            <div class="rol-list">
                @if (loadingRoles)
                {
                    <div class="pa-4"><div class="sk" style="height:200px;"></div></div>
                }
                else
                {
                    @foreach (var rol in roles.Where(r => string.IsNullOrEmpty(searchString) || r.Nombre.Contains(searchString, StringComparison.OrdinalIgnoreCase)))
                    {
                        <div class="@(rol.Id == idRolSeleccionado ? "rol-item selected" : "rol-item")" @onclick="() => CargarDetalleRol(rol.Id)">
                            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="@(rol.Activo ? Color.Success : Color.Default)" Class="mr-3" />
                            <div style="flex:1;">
                                <div style="font-size:0.85rem; font-weight:700;">@rol.Nombre</div>
                                @if (!rol.Activo) { <span style="font-size:0.6rem; color:red;">INACTIVO</span> }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="panel-right">
            @if (rolSeleccionado == null)
            {
                <div style="flex:1; display:flex; flex-direction:column; align-center:center; justify-content:center; text-align:center; color:gray; padding:40px;">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Style="font-size:3rem; margin-bottom:10px;" />
                    <MudText>Seleccioná un rol para gestionar sus permisos.</MudText>
                </div>
            }
            else
            {
                <div class="panel-right-head">
                    <div style="flex:1; display:flex; flex-direction:column; gap:10px;">
                        <input class="field-input" @bind="rolSeleccionado.Nombre" placeholder="Nombre del rol" />
                        <textarea class="field-textarea" rows="2" @bind="rolSeleccionado.Descripcion" placeholder="Descripción..."></textarea>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:8px;">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarCambios" StartIcon="@Icons.Material.Filled.Save">Guardar</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DesactivarRol" Disabled="@(!rolSeleccionado.Activo)">Baja</MudButton>
                    </div>
                </div>

                <div style="flex:1; overflow-y:auto; padding:20px;">
                    @foreach (var modulo in catalogoPermisos.GroupBy(p => p.Modulo).OrderBy(g => g.Key))
                    {
                        var abierto = modulosAbiertos.Contains(modulo.Key);
                        <div style="margin-bottom:8px;">
                            <button class="modulo-toggle" @onclick="() => ToggleModulo(modulo.Key)">
                                <span style="font-weight:800; font-size:0.8rem;">@modulo.Key.ToUpper()</span>
                                <MudIcon Icon="@(abierto ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
                            </button>
                            @if (abierto)
                            {
                                <div class="modulo-permisos">
                                    @foreach (var p in modulo.OrderBy(x => x.Descripcion))
                                    {
                                        <label class="@(p.Asignado ? "permiso-item checked" : "permiso-item")">
                                            <input type="checkbox" @bind="p.Asignado" style="margin-right:8px;" />
                                            <div>
                                                <div style="font-size:0.75rem; font-weight:700;">@p.Descripcion</div>
                                                <div style="font-size:0.6rem; color:gray;">@p.Codigo</div>
                                            </div>
                                        </label>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<RolRequestDTO> roles = new();
    private List<PermisoDTO> catalogoPermisos = new();
    private RolRequestDTO? rolSeleccionado;
    private int idRolSeleccionado;
    private string searchString = "";
    private bool loadingRoles = true;
    private HashSet<string> modulosAbiertos = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarRoles();
        catalogoPermisos = await RolService.GetCatalogoPermisosAsync() ?? new();
    }

    private async Task CargarRoles()
    {
        loadingRoles = true;
        roles = await RolService.GetAllAsync() ?? new();
        loadingRoles = false;
    }

    private async Task CargarDetalleRol(int id)
    {
        idRolSeleccionado = id;
        rolSeleccionado = await RolService.GetByIdAsync(id);
        if (rolSeleccionado == null) return;

        foreach (var p in catalogoPermisos)
            p.Asignado = rolSeleccionado.IdsPermisos.Contains(p.Id);

        modulosAbiertos = catalogoPermisos.Where(p => p.Asignado).Select(p => p.Modulo).ToHashSet();
    }

    private void NuevoRol()
    {
        rolSeleccionado = new RolRequestDTO { Nombre = "", Activo = true, IdsPermisos = new() };
        idRolSeleccionado = 0;
        foreach (var p in catalogoPermisos) p.Asignado = false;
    }

    private async Task GuardarCambios()
    {
        if (rolSeleccionado == null || string.IsNullOrWhiteSpace(rolSeleccionado.Nombre)) return;
        rolSeleccionado.IdsPermisos = catalogoPermisos.Where(p => p.Asignado).Select(p => p.Id).ToList();
        
        if (await RolService.GuardarAsync(rolSeleccionado))
        {
            Snackbar.Add("Cambios guardados.", Severity.Success);
            await CargarRoles();
        }
    }

    private async Task DesactivarRol()
    {
        if (rolSeleccionado == null || rolSeleccionado.Id == 0) return;
        if (await RolService.EliminarAsync(rolSeleccionado.Id))
        {
            Snackbar.Add("Rol desactivado.", Severity.Warning);
            await CargarRoles();
            rolSeleccionado = null;
        }
    }

    private void ToggleModulo(string modulo)
    {
        if (modulosAbiertos.Contains(modulo)) modulosAbiertos.Remove(modulo);
        else modulosAbiertos.Add(modulo);
    }
}