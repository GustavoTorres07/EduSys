@page "/legajos"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using EduSys.Web.Pages.Admin.Components
@using Microsoft.AspNetCore.Authorization

@inject IAlumnoService AlumnoService
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@attribute [Authorize(Roles = "Administrador, Secretaria Academica")]

<style>
    /* HEADER TABLA CONSISTENTE */
    .table-header-custom .mud-table-head .mud-table-cell {
        color: #456990 !important;
        font-weight: 800 !important;
        background-color: #f8fafc !important;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
    }

    .row-hover-effect:hover {
        background-color: #f1f5f9 !important;
        cursor: pointer;
    }

    /* Buscador consistente */
    .custom-filter-input .mud-input-outlined-border {
        border-color: #cbd5e1 !important;
        transition: border-color 0.2s;
    }
    
    .custom-filter-input:hover .mud-input-outlined-border {
        border-color: #456990 !important;
    }

    .custom-filter-input.mud-input-control.mud-input-focused .mud-input-outlined-border {
        border-color: #456990 !important;
        border-width: 2px !important;
    }

    .custom-filter-input .mud-input-label {
        color: #456990 !important;
        background-color: white !important;
        padding: 0 5px;
        font-weight: 600;
    }

    .custom-filter-input input, .custom-filter-input .mud-select-input {
        color: #1e293b !important;
        font-weight: 500;
    }

    /* ESTILO BOTÓN LIMPIAR */
    .btn-filter-height {
        height: 40px;
        border-width: 1px;
        font-weight: 600;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-10">

    @* --- ENCABEZADO --- *@
    <div class="d-flex align-center justify-space-between mb-6 flex-wrap gap-4">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 800; color: #456990; letter-spacing: -0.5px;">Gestión de Legajos</MudText>
            <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Directorio de alumnos y revisión de documentación digital.</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Color="Color.Primary"
                   Size="Size.Large"
                   Style="font-weight: 700; border-radius: 8px;"
                   Disabled="@cargando"
                   OnClick="CargarDatos">
            Actualizar
        </MudButton>
    </div>

    @* --- TABLA DE DATOS --- *@
    <MudTable T="AlumnoListadoDTO"
              Items="@listaAlumnos"
              Dense="true"
              Hover="true"
              Bordered="false"
              Striped="false"
              Filter="new Func<AlumnoListadoDTO, bool>(FiltrarAlumnos)"
              Elevation="2"
              Class="rounded-lg table-header-custom overflow-hidden"
              Loading="@cargando"
              LoadingProgressColor="Color.Primary"
              RowClass="row-hover-effect"
              OnRowClick="@((TableRowClickEventArgs<AlumnoListadoDTO> args) => VerLegajo(args.Item))">

        <ToolBarContent>
            <MudGrid Class="pt-2 pb-2 align-center" Spacing="2">
                @* FILTRO CARRERA *@
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="filtroCarrera" Label="Filtrar por Carrera" Variant="Variant.Outlined" Margin="Margin.Dense" AdornmentIcon="@Icons.Material.Filled.School" AdornmentColor="Color.Primary" Class="custom-filter-input" FullWidth="true">
                        <MudSelectItem Value="@("Todas")">Todas las Carreras</MudSelectItem>
                        @foreach (var carrera in listaCarrerasDisponibles)
                        {
                            <MudSelectItem Value="@carrera">@carrera</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                @* BUSCADOR *@
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="searchString"
                                  Label="Buscar Alumno"
                                  Placeholder="Legajo, DNI o Nombre..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  AdornmentColor="Color.Primary"
                                  Class="custom-filter-input"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  FullWidth="true"
                                  Immediate="true"
                                  DebounceInterval="300"
                                  Clearable="true" />
                </MudItem>

                @* BOTÓN LIMPIAR *@
                <MudItem xs="12" md="2">
                    <MudButton Variant="Variant.Outlined" OnClick="LimpiarFiltros" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterAltOff" FullWidth="true" Class="btn-filter-height rounded-lg">Limpiar</MudButton>
                </MudItem>
            </MudGrid>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>Perfil</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<AlumnoListadoDTO, object>(x => x.Legajo)">Legajo</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<AlumnoListadoDTO, object>(x => x.NombreCompleto)">Apellido y Nombre</MudTableSortLabel></MudTh>
            <MudTh>DNI</MudTh>
            <MudTh>Carrera</MudTh>
            <MudTh Style="text-align:center;">Estado</MudTh>
            <MudTh Style="text-align:center;">Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Perfil">
                @if (!string.IsNullOrEmpty(context.FotoPerfilUrl))
                {
                    <MudImage Src="@context.FotoPerfilUrl" ObjectFit="ObjectFit.Cover" Style="width:35px; height:35px; border-radius:50%; border: 1px solid #cbd5e1;" />
                }
                else
                {
                    <MudAvatar Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Style="font-weight: 600;">
                        @(string.IsNullOrWhiteSpace(context.NombreCompleto) ? "?" : context.NombreCompleto.Trim().Substring(0, 1).ToUpper())
                    </MudAvatar>
                }
            </MudTd>

            <MudTd DataLabel="Legajo">
                <MudText Typo="Typo.body2" Style="font-weight: 700; color: #456990;">@context.Legajo</MudText>
            </MudTd>
            
            <MudTd DataLabel="Nombre">
                <MudText Typo="Typo.body2" Style="font-weight: 600; color: #1e293b;">@context.NombreCompleto</MudText>
            </MudTd>
            
            <MudTd DataLabel="DNI">
                <MudText Typo="Typo.body2" Style="color: #475569;">@context.Dni</MudText>
            </MudTd>
            
            <MudTd DataLabel="Carrera">
                <MudText Typo="Typo.caption" Style="font-weight:600; color: #334155;">@context.NombreCarrera</MudText>
            </MudTd>
            
            <MudTd DataLabel="Estado" Style="text-align:center;">
                @if (context.Activo)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined" Style="font-weight: 600;">ACTIVO</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined" Style="font-weight: 600;">INACTIVO</MudChip>
                }
            </MudTd>
            
            <MudTd Style="text-align:center;" DataLabel="Acciones">
                <MudTooltip Text="Ver Legajo Digital">
                    <MudIconButton Icon="@Icons.Material.Filled.FolderShared" Color="Color.Primary" Size="Size.Small" OnClick="@(() => VerLegajo(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>

        <LoadingContent>
            <MudText Typo="Typo.body1" Class="pa-4 text-center" Style="color: #64748b;">
                Cargando directorio de legajos...
            </MudText>
        </LoadingContent>

        <NoRecordsContent>
            <div class="d-flex flex-column align-center justify-center pa-8">
                <MudIcon Icon="@Icons.Material.Filled.FolderOff" Style="font-size: 4rem; color: #cbd5e1;" Class="mb-3" />
                <MudText Typo="Typo.h6" Style="font-weight: 700; color: #475569;">Sin resultados</MudText>
                <MudText Typo="Typo.body2" Style="color: #94a3b8;">No se encontraron legajos con los filtros actuales.</MudText>
            </div>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página:" InfoFormat="{first_item}-{last_item} de {all_items}" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private List<AlumnoListadoDTO> listaAlumnos = new();
    private List<string> listaCarrerasDisponibles = new();
    private string searchString = "";
    private string filtroCarrera = "Todas";
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            // ✅ CORRECCIÓN: Se cambió GetAlumnosAsync() por GetAllAsync()
            var resultado = await AlumnoService.GetAllAsync();
            listaAlumnos = resultado ?? new List<AlumnoListadoDTO>();
            
            if (listaAlumnos.Any())
            {
                listaCarrerasDisponibles = listaAlumnos
                    .Where(a => !string.IsNullOrWhiteSpace(a.NombreCarrera))
                    .Select(a => a.NombreCarrera)
                    .Distinct()
                    .OrderBy(c => c)
                    .ToList();
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Error al cargar el directorio de legajos.", Severity.Error);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void LimpiarFiltros()
    {
        searchString = "";
        filtroCarrera = "Todas";
    }

    private bool FiltrarAlumnos(AlumnoListadoDTO element)
    {
        if (element == null) return false;
        
        // 1. Filtro por Carrera
        if (filtroCarrera != "Todas" && element.NombreCarrera != filtroCarrera)
            return false;
            
        // 2. Buscador de Texto
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        var term = searchString.Trim().ToLower();

        return (element.Legajo?.ToLower().Contains(term) ?? false) ||
               (element.NombreCompleto?.ToLower().Contains(term) ?? false) ||
               (element.Dni?.Contains(term) ?? false);
    }

    private void VerLegajo(AlumnoListadoDTO alumno)
    {
        if (alumno == null) return;

        var parameters = new DialogParameters
        {
            ["IdAlumno"] = alumno.IdAlumno,
            ["AlumnoNombre"] = alumno.NombreCompleto
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            NoHeader = true,
            CloseButton = false,
            BackdropClick = false
        };

        DialogService.Show<LegajoDigitalDialog>("", parameters, options);
    }
}