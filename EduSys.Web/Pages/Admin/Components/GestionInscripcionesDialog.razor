@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@inject IInscripcionService InscripcionService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<style>
    .dialog-header {
        background: linear-gradient(135deg, #456990 0%, #2c4a6e 100%);
        color: white;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .custom-tab-panel {
        height: 550px;
        overflow-y: auto;
        padding: 16px;
        background-color: #f8fafc;
    }

    /* Input Fix Visibility */
    .fix-visibility .mud-input-slot {
        color: #1e293b !important;
        font-weight: 500;
    }

    .fix-visibility .mud-icon-root {
        color: #456990 !important;
    }

    .fix-visibility .mud-input-outlined-border {
        border-color: #cbd5e1 !important;
    }

    .fix-visibility input::placeholder {
        color: #94a3b8 !important;
    }

    /* Separador Año */
    .year-separator {
        background-color: #e2e8f0;
        color: #456990;
        font-weight: 800;
        letter-spacing: 1px;
        padding: 0.75rem 1rem;
        border-radius: 4px;
        margin-top: 15px;
        margin-bottom: 5px;
    }

    .mini-table-header {
        color: #64748b;
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
    }
</style>

<MudDialog DisableSidePadding="true" Class="rounded-lg overflow-hidden">
    <DialogContent>
        <div class="d-flex flex-column" style="height: 700px; background: white;">
            <div class="dialog-header">
                <div>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Gestión de Inscripciones</MudText>
                    <MudText Typo="Typo.body2" Style="opacity: 0.9;">Alumno: <b>@AlumnoNombre</b></MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="Cancel" />
            </div>

            <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" PanelClass="custom-tab-panel" Class="flex-grow-1" Color="Color.Primary">
                <MudTabPanel Text="Cursadas Vigentes" Icon="@Icons.Material.Filled.ListAlt">
                    @if (cargandoCursadas)
                    {
                        <div class="d-flex justify-center mt-10"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
                    }
                    else if (cursadas.Count == 0)
                    {

                        <MudAlert Severity="Severity.Info" Class="mt-2" Variant="Variant.Filled">No hay inscripciones vigentes.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="@cursadas" Dense="true" Hover="true" Striped="true" Elevation="1">
                            <HeaderContent><MudTh>Materia</MudTh> <MudTh>Comisión</MudTh> <MudTh>Estado</MudTh> <MudTh Style="text-align:center">Baja</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd><b>@context.Materia</b></MudTd> <MudTd>@context.Comision (@context.Turno)</MudTd> <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Success">@context.Estado</MudChip></MudTd>
                                <MudTd Style="text-align:center"><MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Error" Size="Size.Small" OnClick="@(() => DarDeBaja(context))" /></MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Nueva Inscripción" Icon="@Icons.Material.Filled.PostAdd">
                    @* ✅ BUSCADOR CON FIX VISUAL *@
                    <MudTextField @bind-Value="searchOferta" Placeholder="Buscar materia..." Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Class="fix-visibility mb-2 bg-white" />

                    @if (cargandoOferta)
                    {
                        <div class="d-flex justify-center mt-10"><MudProgressCircular Indeterminate="true" Color="Color.Secondary" /></div>
                    }
                    else if (!OfertaAgrupadaPorAnio.Any())
                    {

                        <MudAlert Severity="Severity.Info" Class="my-2">No se encontraron materias disponibles.</MudAlert>
                    }
                    else
                    {
                        @* ✅ AGRUPACIÓN POR AÑO *@
                        @foreach (var grupoAnio in OfertaAgrupadaPorAnio)
                        {
                            <div class="year-separator shadow-sm"><MudText Typo="Typo.subtitle2">AÑO @grupoAnio.Key °</MudText></div>
                            <MudTable Items="@grupoAnio.ToList()" Dense="true" Hover="true" Bordered="true" Elevation="0" Class="mb-4">
                                <HeaderContent>
                                    <MudTh Class="mini-table-header" Style="width: 40%;">Materia</MudTh>
                                    <MudTh Class="mini-table-header" Style="width: 30%;">Comisión</MudTh>
                                    <MudTh Class="mini-table-header" Style="width: 15%; text-align:center;">Cupo</MudTh>
                                    <MudTh Class="mini-table-header" Style="width: 15%; text-align:center;">Acción</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd><b>@context.MateriaNombre</b></MudTd>
                                    <MudTd>
                                        <div class="d-flex flex-column"><span style="font-weight:700;">@context.Codigo</span><span style="font-size:0.75rem;" class="text-muted">@context.SedeNombre - @context.Turno</span></div>
                                    </MudTd>
                                    <MudTd Style="text-align:center;">
                                        <MudChip T="string" Size="Size.Small" Color="@(context.CupoDisponible > 0 ? Color.Success : Color.Error)" Variant="Variant.Text">@context.CupoDisponible / @context.CupoMaximo</MudChip>
                                    </MudTd>
                                    <MudTd Style="text-align:center">
                                        @if (context.YaInscripto)
                                        {
                                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.Check">Inscripto</MudChip>
                                        }
                                        else if (!context.CumpleCorrelativas)
                                        {

                                            <MudTooltip Text="@context.MensajeError"><MudIconButton Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Size="Size.Small" /></MudTooltip>
                                        }
                                        else if (context.CupoDisponible <= 0)
                                        {

                                            <MudTooltip Text="Sin cupo"><MudIconButton Icon="@Icons.Material.Filled.GroupOff" Color="Color.Error" Size="Size.Small" /></MudTooltip>
                                        }
                                        else
                                        {

                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Inscribir(context))">Inscribir</MudButton>
                                        }
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    }
                </MudTabPanel>
            </MudTabs>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public int IdAlumno { get; set; }
    [Parameter] public string AlumnoNombre { get; set; }
    [Parameter] public int IdPeriodo { get; set; }

    private List<InscripcionCursadaListadoDTO> cursadas = new();
    private List<ComisionDTO> oferta = new();
    private string searchOferta = "";
    private bool cargandoCursadas = true;
    private bool cargandoOferta = true;

    private IEnumerable<ComisionDTO> ofertaFiltrada =>
        string.IsNullOrWhiteSpace(searchOferta) ? oferta : oferta.Where(x => x.MateriaNombre.Contains(searchOferta, StringComparison.OrdinalIgnoreCase));

    // Propiedad para agrupar por año (Asegurate de haber aplicado el Paso 1 en Backend)
    private IEnumerable<IGrouping<int, ComisionDTO>> OfertaAgrupadaPorAnio =>
        ofertaFiltrada.GroupBy(c => c.AnioCursada).OrderBy(g => g.Key);

    protected override async Task OnInitializedAsync() { await CargarTodo(); }
    private async Task CargarTodo() { await CargarCursadas(); await CargarOferta(); }

    private async Task CargarCursadas()
    {
        cargandoCursadas = true;
        try { cursadas = await InscripcionService.GetInscripcionesAlumnoAsync(IdAlumno, IdPeriodo); }
        catch { Snackbar.Add("Error al cargar cursadas", Severity.Error); }
        finally { cargandoCursadas = false; }
    }

    private async Task CargarOferta()
    {
        cargandoOferta = true;
        try { oferta = await InscripcionService.GetOfertaInscripcionAsync(IdAlumno, IdPeriodo); }
        catch { Snackbar.Add("Error oferta", Severity.Error); }
        finally { cargandoOferta = false; }
    }

    private async Task Inscribir(ComisionDTO comision)
    {
        var dto = new InscripcionCursadaRequestDTO { IdAlumno = IdAlumno, IdComision = comision.Id };
        var respuesta = await InscripcionService.InscribirAsync(dto);
        if (respuesta.Exito) { Snackbar.Add("Inscripción Exitosa", Severity.Success); await CargarTodo(); }
        else { Snackbar.Add(respuesta.Mensaje, Severity.Error); }
    }

    private async Task DarDeBaja(InscripcionCursadaListadoDTO item)
    {
        var exito = await InscripcionService.CancelarInscripcionAsync(item.Id);
        if (exito) { Snackbar.Add("Baja procesada", Severity.Success); await CargarTodo(); }
        else { Snackbar.Add("Error al dar de baja", Severity.Error); }
    }

    void Cancel() => MudDialog.Cancel();
}