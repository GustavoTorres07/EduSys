@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@inject IInscripcionService InscripcionService
@inject IComisionService ComisionService
@inject ISnackbar Snackbar

<style>
    /* ============================================
                   SISTEMA DE DISEÑO - DIÁLOGO DE INSCRIPCIÓN
                   ============================================ */
    :root {
        --edusys-primary: #1e3a58;
        --edusys-primary-light: #2c5282;
        --edusys-accent: #0288d1;
        --edusys-success: #2e7d32;
        --edusys-warning: #f57c00;
        --edusys-danger: #d32f2f;
        --edusys-surface: #ffffff;
        --edusys-background: #f8fafc;
        --edusys-border: #e2e8f0;
        --edusys-text-primary: #1a202c;
        --edusys-text-secondary: #64748b;
        --edusys-shadow-sm: 0 1px 3px rgba(30, 58, 88, 0.08);
        --edusys-shadow-md: 0 4px 12px rgba(30, 58, 88, 0.12);
    }

    .mud-dialog {
        background: white !important;
    }

    .mud-dialog-content {
        background: white !important;
        padding: 1.5rem !important;
        overflow-y: auto;
        max-height: 70vh;
    }

    .mud-dialog-title {
        padding: 1.5rem !important;
        background: linear-gradient(135deg, var(--edusys-primary) 0%, var(--edusys-primary-light) 100%);
        color: white !important;
    }

    .mud-dialog-actions {
        padding: 1rem 1.5rem !important;
        background: var(--edusys-background);
        border-top: 2px solid var(--edusys-border);
    }

    .dialog-header-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .student-info-card {
        background: linear-gradient(135deg, var(--edusys-background) 0%, white 100%);
        border: 2px solid var(--edusys-border);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: var(--edusys-shadow-sm);
        position: relative;
        overflow: hidden;
    }

        .student-info-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, var(--edusys-accent), var(--edusys-primary));
        }

    .student-avatar {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--edusys-accent) 0%, #4fc3f7 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 800;
        box-shadow: 0 4px 12px rgba(2, 136, 209, 0.3);
        flex-shrink: 0;
    }

    .student-info {
        flex: 1;
        margin-left: 1rem;
    }

    .student-name {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--edusys-text-primary);
        margin-bottom: 0.25rem;
        letter-spacing: -0.3px;
    }

    .student-subtitle {
        font-size: 0.875rem;
        color: var(--edusys-text-secondary);
        line-height: 1.4;
    }

    .section-title {
        font-size: 0.875rem;
        font-weight: 800;
        color: var(--edusys-primary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .section-title-icon {
        width: 24px;
        height: 24px;
        border-radius: 6px;
        background: linear-gradient(135deg, var(--edusys-primary), var(--edusys-primary-light));
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
    }

    .current-inscriptions-panel {
        background: white;
        border: 2px solid var(--edusys-border);
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 1.5rem;
        box-shadow: var(--edusys-shadow-sm);
    }

    .current-item {
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid var(--edusys-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .current-item:last-child {
            border-bottom: none;
        }

    .materia-select-wrapper {
        margin-bottom: 1.5rem;
    }

    /* ESTILOS PARA EL SELECT - Borde, Título (Label) y Texto seleccionado */
    .select-borde-azul .mud-input-outlined-border {
        border-color: var(--edusys-accent) !important;
        border-width: 2px !important;
    }

    .select-borde-azul:hover .mud-input-outlined-border {
        border-color: var(--edusys-primary-light) !important;
    }

    .select-borde-azul .mud-input-label {
        color: var(--edusys-primary) !important;
        font-weight: 800 !important;
    }

    .select-borde-azul .mud-input-slot {
        color: var(--edusys-text-primary) !important;
        font-weight: 600 !important;
    }

    /* ESTILOS PARA EL DROPDOWN (Caja flotante) */
    .popover-materias {
        background-color: #ffffff !important;
        border: 2px solid var(--edusys-border) !important;
    }

        .popover-materias .mud-typography,
        .popover-materias .mud-list-item-text,
        .popover-materias span {
            color: #1a202c !important;
        }

    .exceptions-panel {
        background: white;
        border: 2px solid var(--edusys-border);
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 1.5rem;
        box-shadow: var(--edusys-shadow-sm);
    }

    .exceptions-header {
        background: linear-gradient(135deg, var(--edusys-background) 0%, white 100%);
        padding: 1rem 1.25rem;
        border-bottom: 2px solid var(--edusys-border);
    }

    .exception-item {
        padding: 1.25rem;
        border-bottom: 1px solid var(--edusys-border);
        transition: all 0.3s ease;
        position: relative;
    }

        .exception-item:last-child {
            border-bottom: none;
        }

        .exception-item:hover {
            background-color: var(--edusys-background);
        }

        .exception-item.active {
            background: linear-gradient(90deg, rgba(211, 47, 47, 0.05) 0%, transparent 100%);
        }

        .exception-item.active-warning {
            background: linear-gradient(90deg, rgba(245, 124, 0, 0.05) 0%, transparent 100%);
        }

    .exception-content {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .exception-icon-wrapper {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: all 0.3s ease;
    }

        .exception-icon-wrapper.default {
            background: var(--edusys-background);
            color: var(--edusys-text-secondary);
        }

        .exception-icon-wrapper.active-danger {
            background: linear-gradient(135deg, var(--edusys-danger), #e57373);
            color: white;
            box-shadow: 0 4px 12px rgba(211, 47, 47, 0.3);
        }

        .exception-icon-wrapper.active-warning {
            background: linear-gradient(135deg, var(--edusys-warning), #ffb74d);
            color: white;
            box-shadow: 0 4px 12px rgba(245, 124, 0, 0.3);
        }

    .exception-text {
        flex: 1;
    }

    .exception-title {
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--edusys-text-primary);
        margin-bottom: 0.25rem;
    }

    .exception-description {
        font-size: 0.8rem;
        color: var(--edusys-text-secondary);
        line-height: 1.4;
    }

    .exception-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 0.5rem;
    }

        .exception-badge.danger {
            background: linear-gradient(135deg, #ffebee, #ffcdd2);
            color: var(--edusys-danger);
            border: 1px solid var(--edusys-danger);
        }

        .exception-badge.warning {
            background: linear-gradient(135deg, #fff3e0, #ffe0b2);
            color: var(--edusys-warning);
            border: 1px solid var(--edusys-warning);
        }

    .warning-alert {
        background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
        border: 2px solid var(--edusys-warning);
        border-radius: 12px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        box-shadow: var(--edusys-shadow-sm);
        animation: fadeInSlide 0.3s ease;
    }

    @@keyframes fadeInSlide {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .warning-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--edusys-warning);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1.25rem;
    }

    .warning-content {
        flex: 1;
    }

    .warning-title {
        font-weight: 800;
        font-size: 0.95rem;
        color: #e65100;
        margin-bottom: 0.25rem;
    }

    .warning-text {
        font-size: 0.85rem;
        color: #e65100;
        line-height: 1.4;
    }

    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        border-radius: 12px;
    }
</style>

<MudDialog Options="dialogOptions">
    <TitleContent>
        <div class="dialog-header-title">
            <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Size="Size.Large" Style="color: white;" />
            <div style="color: white;">
                <div style="font-size: 1.25rem; font-weight: 800; margin-bottom: 0.25rem;">
                    Gestión de Inscripción Manual
                </div>
                <div style="font-size: 0.9rem; font-weight: 400; opacity: 0.95;">
                    Forzar inscripción con parámetros de excepción
                </div>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="student-info-card">
            <div style="display: flex; align-items: center;">
                <div class="student-avatar">
                    @NombreAlumno.Substring(0, 1).ToUpper()
                </div>
                <div class="student-info">
                    <div class="student-name">@NombreAlumno</div>
                    <div class="student-subtitle">
                        <MudIcon Icon="@Icons.Material.Filled.LocationCity" Size="Size.Small" Style="font-size: 0.9rem; vertical-align: middle; margin-right: 0.25rem;" />
                        Sede: @(string.IsNullOrEmpty(NombreSede) ? "Principal" : NombreSede)
                    </div>
                </div>
            </div>
        </div>

        <div class="section-title">
            <div class="section-title-icon" style="background: linear-gradient(135deg, var(--edusys-success), #4caf50);">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Style="font-size: 0.9rem;" />
            </div>
            <span>Inscripciones Activas</span>
        </div>

        <div class="current-inscriptions-panel">
            @if (inscripcionesActuales == null || !inscripcionesActuales.Any())
            {
                <div style="padding: 1.5rem; text-align: center; color: var(--edusys-text-secondary);">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Class="mb-2" />
                    <MudText Typo="Typo.body2">El estudiante no registra inscripciones activas.</MudText>
                </div>
            }
            else
            {
                @foreach (var ins in inscripcionesActuales)
                {
                    <div class="current-item">
                        <div>
                            <MudText Typo="Typo.body2" Style="font-weight: 700; color: var(--edusys-text-primary);">@ins.Materia</MudText>
                            <MudText Typo="Typo.caption" Style="color: var(--edusys-text-secondary);">
                                Comisión: <b class="ml-1 mr-2">@ins.ComisionCodigo</b> | Estado: <span class="ml-1">@ins.Estado</span>
                            </MudText>
                        </div>
                        <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="@(() => DarDeBaja(ins.IdInscripcion))">
                            Dar Baja
                        </MudButton>
                    </div>
                }
            }
        </div>

        <MudForm @ref="form">
            <div class="materia-select-wrapper">
                <div class="section-title">
                    <div class="section-title-icon">
                        <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Size="Size.Small" Style="font-size: 0.9rem;" />
                    </div>
                    <span>Nueva Inscripción</span>
                </div>

                <MudSelect T="int?"
                           Label="Seleccione una materia"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter"
                           @bind-Value="idComisionSeleccionada"
                           AdornmentIcon="@Icons.Material.Filled.Class"
                           AdornmentColor="Color.Primary"
                           Margin="Margin.Dense"
                           Clearable="true"
                           Class="select-borde-azul"
                           PopoverClass="popover-materias"
                           Placeholder="Seleccione la comisión...">
                    @if (comisionesDisponibles != null && comisionesDisponibles.Any())
                    {
                        @foreach (var c in comisionesDisponibles)
                        {
                            <MudSelectItem T="int?" Value="@c.Id">
                                <div style="padding: 0.5rem 0;">
                                    <MudText Typo="Typo.body2" Style="font-weight: 700;">
                                        @c.Materia
                                    </MudText>
                                    <MudText Typo="Typo.caption" Style="display: flex; align-items: center; flex-wrap: wrap;">
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Style="font-size: 0.8rem; margin-right: 4px;" />
                                        @c.Horario
                                        <span style="margin: 0 0.4rem;">•</span>
                                        Comisión: <b class="ml-1">@c.Codigo</b>
                                        <span style="margin: 0 0.4rem;">•</span>
                                        Cupo: <span class="ml-1">@c.CupoActual/@c.CupoMaximo</span>
                                    </MudText>
                                </div>
                            </MudSelectItem>
                        }
                    }
                    else
                    {
                        <MudSelectItem T="int?" Value="null" Disabled="true">
                            <MudText Typo="Typo.caption">No hay más materias disponibles</MudText>
                        </MudSelectItem>
                    }
                </MudSelect>
            </div>

            @if (TieneExcepcionesActivas())
            {
                <div class="warning-alert">
                    <div class="warning-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Medium" />
                    </div>
                    <div class="warning-content">
                        <div class="warning-title">
                            ⚠️ Inscripción Forzada Activa
                        </div>
                        <div class="warning-text">
                            Has activado @ContarExcepcionesActivas() excepcion@(ContarExcepcionesActivas() > 1 ? "es" : "").
                            Esta acción omitirá validaciones del sistema y debe realizarse solo en casos excepcionales.
                        </div>
                    </div>
                </div>
            }

            <div class="exceptions-panel">
                <div class="exceptions-header">
                    <div class="section-title" style="margin-bottom: 0;">
                        <div class="section-title-icon" style="background: linear-gradient(135deg, var(--edusys-danger), #e57373);">
                            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" Style="font-size: 0.9rem;" />
                        </div>
                        <span>Parámetros de Excepción</span>
                    </div>
                </div>

                <div class="exception-item @(ignorarCorrelativas ? "active" : "")">
                    <div class="exception-content">
                        <div class="exception-icon-wrapper @(ignorarCorrelativas ? "active-danger" : "default")">
                            <MudIcon Icon="@Icons.Material.Filled.Rule" Size="Size.Medium" />
                        </div>
                        <div class="exception-text">
                            <div class="exception-title">Ignorar Correlativas</div>
                            <div class="exception-description">
                                Permite inscribir al estudiante sin validar los requisitos previos de materias aprobadas.
                            </div>
                            @if (ignorarCorrelativas)
                            {
                                <div class="exception-badge danger">
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Style="font-size: 0.7rem;" />
                                    <span>Activo</span>
                                </div>
                            }
                        </div>
                        <MudSwitch @bind-Value="ignorarCorrelativas" Color="Color.Error" />
                    </div>
                </div>

                <div class="exception-item @(ignorarCupo ? "active" : "")">
                    <div class="exception-content">
                        <div class="exception-icon-wrapper @(ignorarCupo ? "active-danger" : "default")">
                            <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Medium" />
                        </div>
                        <div class="exception-text">
                            <div class="exception-title">Forzar Sobrecupo</div>
                            <div class="exception-description">
                                Inscribe al estudiante aunque la comisión haya alcanzado su capacidad máxima.
                            </div>
                            @if (ignorarCupo)
                            {
                                <div class="exception-badge danger">
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Style="font-size: 0.7rem;" />
                                    <span>Activo</span>
                                </div>
                            }
                        </div>
                        <MudSwitch @bind-Value="ignorarCupo" Color="Color.Error" />
                    </div>
                </div>

                <div class="exception-item @(ignorarVentana ? "active-warning" : "")">
                    <div class="exception-content">
                        <div class="exception-icon-wrapper @(ignorarVentana ? "active-warning" : "default")">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Medium" />
                        </div>
                        <div class="exception-text">
                            <div class="exception-title">Ignorar Ventana de Fechas</div>
                            <div class="exception-description">
                                Permite realizar la inscripción fuera del período habilitado por el calendario académico.
                            </div>
                            @if (ignorarVentana)
                            {
                                <div class="exception-badge warning">
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Style="font-size: 0.7rem;" />
                                    <span>Activo</span>
                                </div>
                            }
                        </div>
                        <MudSwitch @bind-Value="ignorarVentana" Color="Color.Warning" />
                    </div>
                </div>
            </div>
        </MudForm>

        @if (procesando)
        {
            <div class="loading-overlay">
                <div style="text-align: center;">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.body2" Class="mt-3" Style="color: var(--edusys-text-secondary); font-weight: 600;">
                        Procesando petición...
                    </MudText>
                </div>
            </div>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Variant="Variant.Outlined"
                   Color="Color.Default"
                   Disabled="@procesando"
                   Style="font-weight: 600;">
            Cancelar
        </MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Confirmar"
                   Disabled="@(idComisionSeleccionada == null || procesando)"
                   StartIcon="@Icons.Material.Filled.CheckCircle"
                   Style="font-weight: 700;">
            @(procesando ? "Procesando..." : "Confirmar Inscripción")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public int IdAlumno { get; set; }
    [Parameter] public string NombreAlumno { get; set; }
    [Parameter] public int IdSede { get; set; }
    [Parameter] public string NombreSede { get; set; }

    private MudForm form;
    private int? idComisionSeleccionada;
    private List<ComisionDTO> comisionesDisponibles = new();
    private List<InscripcionCursadaListadoDTO> inscripcionesActuales = new();
    private bool procesando = false;

    // Flags de Override
    private bool ignorarCorrelativas = false;
    private bool ignorarCupo = false;
    private bool ignorarVentana = true; // Por defecto true para Admin

    private DialogOptions dialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseButton = true,
        BackdropClick = false,
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            procesando = true;

            // 1. Cargamos inscripciones actuales del alumno
            inscripcionesActuales = await InscripcionService.GetInscripcionesByAlumnoAsync(IdAlumno);

            // 2. Cargamos oferta completa
            var todas = await ComisionService.GetComisionesPorSedeAsync(IdSede);

            // 3. Filtramos para no mostrar las materias que ya está cursando
            var nombresYaInscriptos = inscripcionesActuales.Select(x => x.Materia).ToList();
            comisionesDisponibles = todas
                .Where(c => c.Estado == "Abierta" && !nombresYaInscriptos.Contains(c.Materia))
                .ToList();
        }
        catch (Exception)
        {
            Snackbar.Add("Error al sincronizar datos. Verifique conexión.", Severity.Error);
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task DarDeBaja(int idInscripcion)
    {
        procesando = true;
        var exito = await InscripcionService.CancelarInscripcionAsync(idInscripcion);

        if (exito)
        {
            Snackbar.Add("✓ Inscripción anulada correctamente.", Severity.Success);
            await CargarDatos(); // Refrescamos las listas
        }
        else
        {
            Snackbar.Add("✗ Error al anular la inscripción.", Severity.Error);
        }
        procesando = false;
    }

    private async Task Confirmar()
    {
        if (idComisionSeleccionada == null) return;

        procesando = true;
        StateHasChanged();

        var dto = new InscripcionManualDTO
        {
            IdAlumno = IdAlumno,
            IdComision = idComisionSeleccionada.Value, // Como es int? usamos .Value
            IgnorarCorrelativas = ignorarCorrelativas,
            IgnorarCupo = ignorarCupo,
            IgnorarVentana = ignorarVentana
        };

        try
        {
            var resultado = await InscripcionService.InscribirAdminAsync(dto);

            if (resultado.Exito)
            {
                Snackbar.Add("✓ Inscripción forzada exitosamente", Severity.Success);
                idComisionSeleccionada = null; // Limpiar combobox
                await CargarDatos(); // Recargar listas
            }
            else
            {
                Snackbar.Add($"✗ Error: {resultado.Mensaje}", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("✗ Ocurrió un error inesperado al enviar los datos.", Severity.Error);
        }
        finally
        {
            procesando = false;
            StateHasChanged();
        }
    }

    void Cancel() => MudDialog.Cancel();

    private bool TieneExcepcionesActivas() => ignorarCorrelativas || ignorarCupo || ignorarVentana;

    private int ContarExcepcionesActivas()
    {
        int count = 0;
        if (ignorarCorrelativas) count++;
        if (ignorarCupo) count++;
        if (ignorarVentana) count++;
        return count;
    }
}