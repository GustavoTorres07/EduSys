@page "/admin/actas"

@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject IActasService  ActasService
@inject IAlumnoService AlumnoService
@inject IJSRuntime     JS
@inject ISnackbar      Snackbar
@inject HttpClient     Http 

@attribute [Authorize(Roles = "ACTA_VER, Administrador")]

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@400;600;700&family=Inter:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap');

    /* ── TOKENS ────────────────────────────────────── */
    :root {
        --blue:       #456990;
        --blue-dark:  #344f6e;
        --blue-pale:  #edf2f7;
        --teal:       #49BEAA;
        --mint:       #49DCB1;
        --amber:      #EEB868;
        --coral:      #EF767A;
        --bg:         #f7f9fc;
        --surface:    #ffffff;
        --border:     #dde3ea;
        --text:       #1a2733;
        --text-mid:   #4a5568;
        --text-soft:  #8a9ab0;
        --font-serif: 'Source Serif 4', Georgia, serif;
        --font-ui:    'Inter', system-ui, sans-serif;
        --font-mono:  'DM Mono', monospace;
        --radius:     6px;
        --shadow:     0 1px 4px rgba(69,105,144,0.10);
        --shadow-md:  0 4px 16px rgba(69,105,144,0.13);
    }

    *, *::before, *::after { box-sizing: border-box; }

    .ac {
        font-family: var(--font-ui);
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
    }

    /* ── TOPBAR ────────────────────────────────────── */
    .ac-topbar { background: var(--blue); height: 3px; }

    /* ── BREADCRUMB ────────────────────────────────── */
    .ac-breadcrumb {
        padding: 10px 0 0;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 4px;
    }

    .ac-bc {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--text-soft);
        cursor: pointer;
        transition: color 0.15s;
    }

    .ac-bc:hover { color: var(--blue); }
    .ac-bc.cur   { color: var(--text-mid); cursor: default; font-weight: 600; }
    .ac-bc-div   { color: var(--border); font-size: 0.65rem; }

    /* ── SECTION HEAD ──────────────────────────────── */
    .ac-section-head {
        padding: 16px 0 20px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 22px;
    }

    .ac-section-label {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--blue);
        margin-bottom: 5px;
    }

    .ac-section-title {
        font-family: var(--font-serif);
        font-size: 1.55rem;
        font-weight: 600;
        color: var(--text);
        letter-spacing: -0.3px;
        line-height: 1.2;
        margin: 0;
    }

    .ac-section-sub {
        font-size: 0.83rem;
        color: var(--text-soft);
        margin-top: 4px;
        line-height: 1.5;
    }

    /* ── TABS ──────────────────────────────────────── */
    .ac-tabs {
        display: flex;
        gap: 0;
        border-bottom: 2px solid var(--border);
        margin-bottom: 22px;
    }

    .ac-tab {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 18px;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-soft);
        cursor: pointer;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        transition: color 0.15s, border-color 0.15s;
        user-select: none;
        white-space: nowrap;
        background: transparent;
        border-top: none;
        border-left: none;
        border-right: none;
        font-family: var(--font-ui);
    }

    .ac-tab:hover { color: var(--blue); }

    .ac-tab.on {
        color: var(--blue);
        border-bottom-color: var(--blue);
    }

    /* ── PANEL DE BÚSQUEDA ─────────────────────────── */
    .ac-search-panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px 22px;
        margin-bottom: 20px;
        box-shadow: var(--shadow);
    }

    .ac-search-panel-inner {
        display: flex;
        align-items: flex-end;
        gap: 14px;
        flex-wrap: wrap;
    }

    .ac-fg {
        flex: 1;
        min-width: 260px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .ac-fg-header {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .ac-fg-label {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--text-soft);
    }

    .ac-fg-hint {
        font-size: 0.68rem;
        color: var(--text-soft);
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .ac-search-box {
        position: relative;
        background: var(--bg);
        border: 1.5px solid var(--border);
        border-radius: 8px;
        display: flex;
        align-items: center;
        height: 46px;
        transition: border-color 0.18s, box-shadow 0.18s;
        overflow: visible;
    }

    .ac-search-box:focus-within {
        border-color: var(--blue);
        box-shadow: 0 0 0 3px rgba(69,105,144,0.10);
        background: var(--surface);
    }

    .ac-search-ico {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-soft);
        display: flex;
        align-items: center;
        pointer-events: none;
        z-index: 1;
        transition: color 0.15s;
    }

    .ac-search-box:focus-within .ac-search-ico {
        color: var(--blue);
    }

    .ac-search-box .ac-autocomplete-wrap {
        flex: 1;
        padding-left: 42px;
        padding-right: 8px;
    }

    .ac-autocomplete-wrap .mud-input-control {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
        height: 44px;
    }

    .ac-autocomplete-wrap .mud-input-underline::before,
    .ac-autocomplete-wrap .mud-input-underline::after { display: none !important; }

    .ac-autocomplete-wrap .mud-input {
        height: 100%;
        display: flex;
        align-items: center;
    }

    .ac-autocomplete-wrap .mud-input input {
        font-family: var(--font-ui) !important;
        font-size: 0.9rem !important;
        font-weight: 500 !important;
        color: var(--text) !important;
        background: transparent !important;
        padding: 0 !important;
        height: 100% !important;
        border: none !important;
        outline: none !important;
    }

    .ac-autocomplete-wrap .mud-input input::placeholder {
        color: var(--text-soft) !important;
        font-weight: 400 !important;
    }

    .ac-autocomplete-wrap .mud-input-label { display: none !important; }
    .ac-autocomplete-wrap .mud-input-adornment-start { display: none !important; }
    .ac-autocomplete-wrap .mud-input-adornment-end {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
    }

    .mud-popover.mud-popover-open {
        z-index: 9999 !important;
        background-color: var(--surface) !important;
        box-shadow: 0 8px 24px rgba(69,105,144,0.14), 0 0 0 1px var(--border) !important;
        border-radius: 8px !important;
        border: none !important;
        overflow: hidden !important;
    }

    .mud-list-item {
        font-family: var(--font-ui) !important;
        font-size: 0.82rem !important;
        font-weight: 500 !important;
        color: var(--text-mid) !important;
        background-color: var(--surface) !important;
        padding: 9px 16px !important;
        border-bottom: 1px solid #f4f6f9 !important;
        transition: background 0.1s !important;
    }

    .mud-list-item:last-child { border-bottom: none !important; }

    .mud-list-item:hover,
    .mud-list-item.mud-selected-item {
        background-color: var(--blue-pale) !important;
        color: var(--blue) !important;
    }

    .mud-list-item .mud-list-item-text span {
        font-variant-numeric: tabular-nums;
    }

    /* ── PROGRESS BAR ──────────────────────────────── */
    .ac-progress-wrap {
        height: 3px;
        background: var(--border);
        border-radius: 3px;
        overflow: hidden;
        margin-bottom: 18px;
    }

    .ac-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--blue), var(--teal));
        border-radius: 3px;
        animation: ac-progress 1.4s ease-in-out infinite;
    }

    @@keyframes ac-progress {
        0%   { width: 0%; margin-left: 0%; }
        50%  { width: 60%; margin-left: 20%; }
        100% { width: 0%; margin-left: 100%; }
    }

    /* ── TABLA ─────────────────────────────────────── */
    .ac-table-wrap {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: var(--shadow-md);
    }

    .ac-table-caption {
        background: var(--blue);
        padding: 10px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .ac-table-caption-title {
        font-family: var(--font-serif);
        font-size: 0.88rem;
        font-weight: 600;
        color: #fff;
    }

    .ac-table-caption-meta {
        font-size: 0.7rem;
        color: rgba(255,255,255,0.55);
        letter-spacing: 0.4px;
    }

    .ac-table-scroll { overflow-x: auto; }
    .ac-table-scroll::-webkit-scrollbar { height: 4px; }
    .ac-table-scroll::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

    .ac-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.8rem;
        font-family: var(--font-ui);
        min-width: 800px;
    }

    .ac-table thead tr { background: #1a2d45; }

    .ac-table thead th {
        padding: 10px 14px;
        font-size: 0.62rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: rgba(255,255,255,0.6);
        border-right: 1px solid rgba(255,255,255,0.07);
        white-space: nowrap;
        text-align: left;
    }

    .ac-table thead th.center { text-align: center; }

    .ac-table tbody tr {
        border-bottom: 1px solid #f0f3f8;
        transition: background 0.1s;
    }

    .ac-table tbody tr:last-child { border-bottom: none; }
    .ac-table tbody tr:hover      { background: #f6f9fd; }

    .ac-table tbody td {
        padding: 10px 14px;
        vertical-align: middle;
        color: var(--text-mid);
    }

    .ac-table tbody td.center { text-align: center; }

    /* Tipo acta */
    .ac-tipo {
        display: inline-block;
        padding: 2px 9px;
        border-radius: 20px;
        font-size: 0.6rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        white-space: nowrap;
    }

    .ac-tipo-final   { background: #feeef0; color: #8a2020; border: 1px solid #f0b8b8; }
    .ac-tipo-cursada { background: #eaf0fa; color: #2a4e80; border: 1px solid #b8d0ec; }

    /* Materia */
    .ac-materia      { font-weight: 600; color: var(--text); font-size: 0.82rem; }
    .ac-detalle      { font-size: 0.72rem; color: var(--text-soft); margin-top: 1px; }
    
    /* Docente */
    .ac-docente      { font-size: 0.75rem; color: var(--blue); font-weight: 500; }

    /* Libro / Folio (AHORA NUMERO ACTA) */
    .ac-libro-folio {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
    }

    .ac-lf-chip {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 500;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 2px 7px;
        color: var(--text-mid);
        white-space: nowrap;
    }

    /* Nota */
    .ac-nota {
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 0.85rem;
        color: var(--text);
    }

    .ac-nota-nd { color: var(--text-soft); font-size: 0.75rem; }

    /* Estado alumno */
    .ac-badge {
        display: inline-block;
        padding: 2px 9px;
        border-radius: 20px;
        font-size: 0.6rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        white-space: nowrap;
    }

    .ac-badge-ok      { background: #e6f7f0; color: #1e6a46; border: 1px solid #b8e8d0; }
    .ac-badge-regular { background: #eaf0fa; color: #2a4e80; border: 1px solid #b8d0ec; }
    .ac-badge-mal     { background: #feeef0; color: #8a2020; border: 1px solid #f0b8b8; }
    .ac-badge-nd      { background: #f4f5f7; color: #7a8a9a; border: 1px solid #dde3ea; }

    /* Botón PDF en la tabla */
    .ac-pdf-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px; height: 30px;
        border-radius: var(--radius);
        background: transparent;
        border: 1px solid #f0b0b0;
        color: #a83030;
        cursor: pointer;
        transition: background 0.13s, color 0.13s;
    }

    .ac-pdf-btn:hover { background: #fff0f0; border-color: #d08080; }

    /* ── EMPTY / WAITING ───────────────────────────── */
    .ac-waiting {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 56px 24px;
        text-align: center;
        box-shadow: var(--shadow);
    }

    .ac-waiting-ico { color: var(--border); margin-bottom: 12px; }

    .ac-waiting-title {
        font-family: var(--font-serif);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-mid);
        margin-bottom: 6px;
    }

    .ac-waiting-body {
        font-size: 0.82rem;
        color: var(--text-soft);
        line-height: 1.6;
        max-width: 360px;
        margin: 0 auto;
    }

    /* ── PRÓXIMAMENTE ──────────────────────────────── */
    .ac-coming-soon {
        background: var(--surface);
        border: 1px dashed var(--border);
        border-radius: var(--radius);
        padding: 48px 24px;
        text-align: center;
    }

    .ac-coming-title {
        font-family: var(--font-serif);
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-mid);
        margin-bottom: 5px;
    }

    .ac-coming-sub {
        font-size: 0.8rem;
        color: var(--text-soft);
    }

    /* ── SKELETON ──────────────────────────────────── */
    @@keyframes sk { 0% { background-position: -600px 0; } 100% { background-position: 600px 0; } }

    .sk {
        background: linear-gradient(90deg, #eaedf1 25%, #f4f6f9 50%, #eaedf1 75%);
        background-size: 1200px 100%;
        animation: sk 1.4s infinite linear;
        border-radius: var(--radius);
        display: block;
    }
</style>

<div class="ac">
    <div class="ac-topbar"></div>

    @* ── BREADCRUMB ──────────────────────────────────── *@
    <div class="ac-breadcrumb">
        <span class="ac-bc">Inicio</span>
        <span class="ac-bc-div">›</span>
        <span class="ac-bc">Sistema</span>
        <span class="ac-bc-div">›</span>
        <span class="ac-bc cur">Libros de Actas</span>
    </div>

    @* ── SECTION HEAD ────────────────────────────────── *@
    <div class="ac-section-head">
        <div class="ac-section-label">Evaluaciones y Actas</div>
        <h1 class="ac-section-title">Registro de Actas Individuales</h1>
        <p class="ac-section-sub">Consulta y descarga de actas oficiales generadas por el sistema.</p>
    </div>

    @* ── TABS ────────────────────────────────────────── *@
    <div class="ac-tabs">
        <button class="ac-tab @(tabActivo == 0 ? "on" : "")"
                @onclick="@(() => tabActivo = 0)">
            <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Style="font-size:15px;" />
            Búsqueda por Alumno
        </button>
        <button class="ac-tab @(tabActivo == 1 ? "on" : "")"
                @onclick="@(() => tabActivo = 1)">
            <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Style="font-size:15px;" />
            Por Período / Materia
        </button>
    </div>

    @* ══════════════ TAB 0 — BÚSQUEDA POR ALUMNO ══════════════ *@
    @if (tabActivo == 0)
    {
        @* Buscador *@
        <div class="ac-search-panel">
            <div class="ac-search-panel-inner">
                <div class="ac-fg">
                    <div class="ac-fg-header">
                        <MudIcon Icon="@Icons.Material.Filled.ManageSearch"
                                 Style="font-size:13px; color:var(--blue);" />
                        <span class="ac-fg-label">Alumno</span>
                    </div>

                    <div class="ac-search-box">
                        <span class="ac-search-ico">
                            <MudIcon Icon="@Icons.Material.Filled.Search" Style="font-size:18px;" />
                        </span>
                        <div class="ac-autocomplete-wrap">
                            <MudAutocomplete T="AlumnoListadoDTO"
                                             SearchFunc="@BuscarAlumnoRemoto"
                                             ToStringFunc="@(a => a == null ? null : $"{a.Legajo} — {a.NombreCompleto}")"
                                             ValueChanged="OnAlumnoSeleccionado"
                                             ResetValueOnEmptyText="true"
                                             Variant="Variant.Text"
                                             Underline="false"
                                             Margin="Margin.None"
                                             Clearable="true"
                                             Placeholder="Apellido, DNI o legajo…"
                                             MaxItems="10"
                                             Dense="true"
                                             CoerceText="false" />
                        </div>
                    </div>

                    <div class="ac-fg-hint">
                        <MudIcon Icon="@Icons.Material.Outlined.Info"
                                 Style="font-size:11px; color:var(--text-soft);" />
                        Mínimo 2 caracteres para iniciar la búsqueda
                    </div>
                </div>
            </div>
        </div>

        @* Loading *@
        @if (isLoading)
        {
            <div class="ac-progress-wrap">
                <div class="ac-progress-fill"></div>
            </div>

            <div style="display:flex;flex-direction:column;gap:1px;border-radius:6px;overflow:hidden;">
                <span class="sk" style="height:44px;border-radius:0;"></span>
                @for (int i = 0; i < 5; i++)
                {
                    <span class="sk" style="height:52px;border-radius:0;"></span>
                }
            </div>
        }

        @* Resultados *@
        else if (actasDelAlumno != null)
        {
            @if (actasDelAlumno.Any())
            {
                <div class="ac-table-wrap">
                    <div class="ac-table-caption">
                        <span class="ac-table-caption-title">Historial de Actas</span>
                        <span class="ac-table-caption-meta">
                            @alumnoNombre · @actasDelAlumno.Count registro@(actasDelAlumno.Count == 1 ? "" : "s")
                        </span>
                    </div>

                    <div class="ac-table-scroll">
                        <table class="ac-table">
                            <thead>
                                <tr>
                                    <th>Tipo</th>
                                    <th>Materia / Detalle</th>
                                    <th>Docente a Cargo</th>
                                    <th>Nº de Acta</th>
                                    <th class="center">Nota</th>
                                    <th class="center">Estado</th>
                                    <th class="center">PDF</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var acta in actasDelAlumno)
                                {
                                    <tr>
                                        <td>
                                            <span class="ac-tipo @(acta.TipoActa.Contains("FINAL") ? "ac-tipo-final" : "ac-tipo-cursada")">
                                                @acta.TipoActa
                                            </span>
                                        </td>
                                        <td>
                                            <div class="ac-materia">@acta.Materia</div>
                                            @if (!string.IsNullOrWhiteSpace(acta.Detalle))
                                            {
                                                <div class="ac-detalle">@acta.Detalle</div>
                                            }
                                        </td>
                                        <td>
                                            @* 🚀 NUEVA CELDA: DOCENTE *@
                                            <div class="ac-docente">
                                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Style="font-size: 12px; margin-right: 4px;" />
                                                @acta.DocenteTitular
                                            </div>
                                        </td>
                                        <td>
                                            <div class="ac-libro-folio">
                                                <span class="ac-lf-chip">@acta.Libro</span>
                                            </div>
                                        </td>
                                        <td class="center">
                                            @if (acta.NotaAlumno.HasValue)
                                            {
                                                <span class="ac-nota">@acta.NotaAlumno.Value.ToString("0.##")</span>
                                            }
                                            else
                                            {
                                                <span class="ac-nota-nd">—</span>
                                            }
                                        </td>
                                        <td class="center">
                                            @{
                                                var (cls, lbl) = acta.EstadoAlumno switch
                                                {
                                                    "Aprobado" or "Promocionado" or "Aprobada" => ("ac-badge-ok",      acta.EstadoAlumno),
                                                    "Regular"                                  => ("ac-badge-regular", "Regular"),
                                                    "Desaprobado" or "Libre"                   => ("ac-badge-mal",     acta.EstadoAlumno),
                                                    _                                          => ("ac-badge-nd",      acta.EstadoAlumno)
                                                };
                                            }
                                            <span class="ac-badge @cls">@lbl</span>
                                        </td>
                                        <td class="center">
                                            <button class="ac-pdf-btn"
                                                    @onclick="() => ExportarPDF(acta)"
                                                    title="Descargar Acta Oficial">
                                                <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf"
                                                         Style="font-size:15px;" />
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="ac-waiting">
                    <div class="ac-waiting-ico">
                        <MudIcon Icon="@Icons.Material.Outlined.FindInPage" Style="font-size:2.5rem;" />
                    </div>
                    <div class="ac-waiting-title">Sin actas registradas</div>
                    <p class="ac-waiting-body">
                        No se encontraron actas formales para este alumno en el sistema.
                    </p>
                </div>
            }
        }

        @* Estado inicial *@
        else
        {
            <div class="ac-waiting">
                <div class="ac-waiting-ico">
                    <MudIcon Icon="@Icons.Material.Outlined.ManageSearch" Style="font-size:2.5rem;" />
                </div>
                <div class="ac-waiting-title">Buscá un alumno para ver sus actas</div>
                <p class="ac-waiting-body">
                    Escribí el apellido, DNI o legajo en el campo de búsqueda de arriba.
                    Las actas aparecerán automáticamente al seleccionar el alumno.
                </p>
            </div>
        }
    }

    @* ══════════════ TAB 1 — POR PERÍODO / MATERIA ════════════ *@
    @if (tabActivo == 1)
    {
        <div class="ac-coming-soon">
            <div class="ac-waiting-ico">
                <MudIcon Icon="@Icons.Material.Outlined.Pending" Style="font-size:2.2rem;" />
            </div>
            <div class="ac-coming-title">Próximamente disponible</div>
            <p class="ac-coming-sub">
                La generación de actas está diseñada para un enfoque individual.
                La búsqueda por lote está en desarrollo.
            </p>
        </div>
    }

</div>

@code {
    private int    tabActivo      = 0;
    private bool   isLoading      = false;
    private string alumnoNombre   = "";

    private List<ActaResumenDTO>?   actasDelAlumno      = null;
    private List<AlumnoListadoDTO>  listaGlobalAlumnos  = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            listaGlobalAlumnos = await AlumnoService.GetAllAsync() ?? new();
        }
        catch
        {
            Snackbar.Add("No se pudo cargar el listado de alumnos.", Severity.Warning);
        }
    }

    /* ── AUTOCOMPLETE ───────────────────────────────── */
    private Task<IEnumerable<AlumnoListadoDTO>> BuscarAlumnoRemoto(
        string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 2)
            return Task.FromResult<IEnumerable<AlumnoListadoDTO>>(new List<AlumnoListadoDTO>());

        return Task.FromResult(
            listaGlobalAlumnos.Where(a =>
                (a.Dni?.Contains(value, StringComparison.OrdinalIgnoreCase)          ?? false) ||
                (a.Legajo?.Contains(value, StringComparison.OrdinalIgnoreCase)       ?? false) ||
                (a.NombreCompleto?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false)
            ).Take(10)
        );
    }

    private async Task OnAlumnoSeleccionado(AlumnoListadoDTO alumno)
    {
        if (alumno == null)
        {
            actasDelAlumno = null;
            alumnoNombre   = "";
            return;
        }

        alumnoNombre   = alumno.NombreCompleto ?? "";
        isLoading      = true;
        actasDelAlumno = null;

        try
        {
            actasDelAlumno = await ActasService.GetActasPorAlumnoAsync(alumno.IdAlumno);
        }
        catch
        {
            actasDelAlumno = new();
            Snackbar.Add("Error al cargar las actas del alumno.", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    /* ── PDF ────────────────────────────────────────── */
    private async Task ExportarPDF(ActaResumenDTO acta)
    {
        try
        {
            Snackbar.Add("Generando el documento PDF...", Severity.Info);

            // Fetch via HttpClient to pass JWT automatically
            var response = await Http.GetAsync($"api/Reportes/acta-individual/{acta.IdReferencia}");

            if (response.IsSuccessStatusCode)
            {
                var fileBytes = await response.Content.ReadAsByteArrayAsync();
                
                string fileName = $"Acta_{acta.Libro}_{alumnoNombre.Replace(" ", "_")}.pdf";

                // 🚀 TRUCO: Ejecutar la descarga inyectando el script directamente en tiempo de ejecución.
                // Así no dependes de modificar el index.html
                await JS.InvokeVoidAsync("eval", $@"
                    var link = document.createElement('a');
                    link.download = '{fileName}';
                    link.href = 'data:application/pdf;base64,{Convert.ToBase64String(fileBytes)}';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                ");
                
                Snackbar.Add("PDF descargado correctamente.", Severity.Success);
            }
            else
            {
                Snackbar.Add("No se pudo generar el acta. Verifique los permisos.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Ocurrió un error al intentar descargar el archivo.", Severity.Error);
        }
    }
}