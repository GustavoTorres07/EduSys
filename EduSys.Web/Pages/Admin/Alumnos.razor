@page "/alumnos"
@using EduSys.Shared.DTOs
@using EduSys.Web.Pages.Admin.Components
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject IAlumnoService AlumnoService
@inject ICarreraService CarreraService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Administrador, Secretaria Academica")]

<style>
    /* Estilos de Tabla y Filtros */
    .table-header-custom .mud-table-head .mud-table-cell {
        color: #456990 !important;
        font-weight: 800 !important;
        background-color: #f8fafc !important;
        text-transform: uppercase;
        font-size: 0.75rem;
    }

    .row-hover-effect:hover {
        background-color: #f1f5f9 !important;
        cursor: pointer;
    }

    /* Inputs de Filtro (Bordes Azules y Texto Negro) */
    .custom-filter-input .mud-input-outlined-border {
        border-color: #456990 !important;
    }

    .custom-filter-input .mud-input-label {
        color: #456990 !important;
        background-color: white !important;
        padding: 0 5px;
    }

    .custom-filter-input input, .custom-filter-input .mud-select-input {
        color: #1F2937 !important;
        font-weight: 500;
    }

    .custom-filter-input.mud-input-control.mud-input-focused .mud-input-outlined-border {
        border-width: 2px !important;
    }

    .btn-filter-height {
        height: 40px;
        border-width: 1px;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
    <div class="d-flex align-center justify-space-between mb-6">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; color: #456990;">Padrón de Alumnos</MudText>
            <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Gestión de datos personales y académicos.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" OnClick="AbrirCrear">
            Nuevo Alumno
        </MudButton>
    </div>

    <MudTable T="AlumnoListadoDTO" Items="@listaAlumnos" Dense="true" Hover="true" Bordered="false" Striped="false"
              Filter="new Func<AlumnoListadoDTO, bool>(Filtrar)" Elevation="3" Class="rounded-lg table-header-custom"
              Loading="@cargando" RowClass="row-hover-effect">

        <ToolBarContent>
            <MudGrid Class="pt-2 pb-2 align-center" Spacing="2">
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="filtroCarrera" Label="Seleccionar Carrera" Variant="Variant.Outlined" Margin="Margin.Dense" AdornmentIcon="@Icons.Material.Filled.School" AdornmentColor="Color.Primary" Class="custom-filter-input" FullWidth="true">
                        <MudSelectItem Value="@("Todas")">Todas las Carreras</MudSelectItem>
                        @foreach (var carrera in listaCarreras)
                        {
                            <MudSelectItem Value="@carrera.Nombre">@carrera.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudSelect T="string" @bind-Value="filtroEstado" Label="Estado" Variant="Variant.Outlined" Margin="Margin.Dense" Class="custom-filter-input" FullWidth="true">
                        <MudSelectItem Value="@("Todos")">Todos</MudSelectItem>
                        <MudSelectItem Value="@("Activo")">Activos</MudSelectItem>
                        <MudSelectItem Value="@("Inactivo")">Inactivos (Baja)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="searchString" Label="Buscar" Placeholder="DNI, Apellido..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary" Class="custom-filter-input" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudButton Variant="Variant.Outlined" OnClick="LimpiarFiltros" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterAltOff" FullWidth="true" Class="btn-filter-height">Limpiar</MudButton>
                </MudItem>
            </MudGrid>
        </ToolBarContent>

        <HeaderContent>
            <MudTh>Legajo</MudTh> <MudTh>Apellido y Nombre</MudTh> <MudTh>DNI</MudTh> <MudTh>Carrera / Plan</MudTh> <MudTh Style="text-align:center;">Estado</MudTh> <MudTh Style="text-align:center;">Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Legajo"><MudText Typo="Typo.body2" Style="font-weight: 700; color: #456990;">@context.Legajo</MudText></MudTd>
            <MudTd DataLabel="Nombre">@context.NombreCompleto</MudTd>
            <MudTd DataLabel="DNI">@context.Dni</MudTd>
            <MudTd DataLabel="Carrera">
                <MudText Typo="Typo.caption" Style="font-weight:600;">@context.NombreCarrera</MudText>
                <MudText Typo="Typo.caption" Class="d-block text-secondary">@context.NombrePlan</MudText>
            </MudTd>
            <MudTd Style="text-align:center;">
                @if (context.Activo)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">ACTIVO</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Text">INACTIVO</MudChip>
                }
            </MudTd>
            <MudTd Style="text-align:center;">
                <MudTooltip Text="Editar Datos"><MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => AbrirEditar(context))" /></MudTooltip>
                <MudTooltip Text="Ver Legajo Digital"><MudIconButton Icon="@Icons.Material.Filled.FolderShared" Color="Color.Secondary" Size="Size.Small" OnClick="@(() => VerLegajoDigital(context))" /></MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            @if (string.IsNullOrEmpty(filtroCarrera))
            {
                <MudAlert Severity="Severity.Info" Class="ma-4">Seleccione una carrera para visualizar los alumnos.</MudAlert>
            }
            else
            {
                <MudText Class="pa-4">No se encontraron alumnos con los filtros seleccionados.</MudText>
            }
        </NoRecordsContent>
        <PagerContent><MudTablePager RowsPerPageString="Filas:" /></PagerContent>
    </MudTable>
</MudContainer>

@code {
    private List<AlumnoListadoDTO> listaAlumnos = new();
    private List<CarreraDTO> listaCarreras = new();
    private string searchString = "";
    private string filtroCarrera = "";
    private string filtroEstado = "Todos";
    private bool cargando = true;

    protected override async Task OnInitializedAsync() => await CargarDatosIniciales();

    private async Task CargarDatosIniciales()
    {
        cargando = true;
        try
        {
            var t1 = CarreraService.GetAllAsync();
            var t2 = AlumnoService.GetAlumnosAsync();
            await Task.WhenAll(t1, t2);

            listaCarreras = await t1;
            listaAlumnos = await t2;
        }
        catch (Exception ex) { Snackbar.Add("Error: " + ex.Message, Severity.Error); }
        finally { cargando = false; }
    }

    private bool Filtrar(AlumnoListadoDTO element)
    {
        if (string.IsNullOrEmpty(filtroCarrera)) return false;
        if (filtroCarrera != "Todas" && element.NombreCarrera != filtroCarrera) return false;
        if (filtroEstado != "Todos" && ((filtroEstado == "Activo" && !element.Activo) || (filtroEstado == "Inactivo" && element.Activo))) return false;
        if (!string.IsNullOrWhiteSpace(searchString))
        {
            if (!element.NombreCompleto.Contains(searchString, StringComparison.OrdinalIgnoreCase) &&
                !element.Dni.Contains(searchString, StringComparison.OrdinalIgnoreCase) &&
                !element.Legajo.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return false;
        }
        return true;
    }

    private void LimpiarFiltros() { searchString = ""; filtroEstado = "Todos"; filtroCarrera = ""; }

    private async Task AbrirCrear()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true, CloseButton = false, BackdropClick = false };
        var dialog = DialogService.Show<CrearEditarAlumnoDialog>("", options); // Título vacío
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var nuevoAlumno = (AlumnoRequestDTO)result.Data;
            var exito = await AlumnoService.CrearAsync(nuevoAlumno);
            if (exito) { Snackbar.Add("Alumno creado", Severity.Success); await CargarDatosIniciales(); }
            else { Snackbar.Add("Error al crear", Severity.Error); }
        }
    }

    private async Task AbrirEditar(AlumnoListadoDTO item)
    {
        var alumnoCompleto = await AlumnoService.GetAlumnoByIdAsync(item.IdAlumno);
        var parameters = new DialogParameters();
        parameters.Add("Alumno", alumnoCompleto);

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true, CloseButton = false, BackdropClick = false };
        var dialog = DialogService.Show<CrearEditarAlumnoDialog>("", parameters, options); // Título vacío
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var alumnoEditado = (AlumnoRequestDTO)result.Data;
            var exito = await AlumnoService.EditarAsync(alumnoEditado);
            if (exito) { Snackbar.Add("Actualizado", Severity.Success); await CargarDatosIniciales(); }
            else { Snackbar.Add("Error al actualizar", Severity.Error); }
        }
    }

    private void VerLegajoDigital(AlumnoListadoDTO item)
    {
        var parameters = new DialogParameters();
        parameters.Add("IdAlumno", item.IdAlumno);
        parameters.Add("AlumnoNombre", item.NombreCompleto);
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true, CloseButton = false, BackdropClick = false };
        DialogService.Show<LegajoDigitalDialog>("", parameters, options);
    }
}