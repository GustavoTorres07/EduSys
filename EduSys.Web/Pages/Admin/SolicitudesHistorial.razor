@page "/admin/solicitudes-historial"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject ISolicitudService InscripcionService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Administrador, Secretaria Academica")]

<style>
    /* ESTILOS DE LA CABECERA DE TABLA */
    .table-header-custom .mud-table-head .mud-table-cell {
        color: #456990 !important;
        font-weight: 800 !important;
        background-color: #f8fafc !important;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
    }

    /* EFECTO HOVER EN FILAS */
    .row-hover-effect:hover {
        background-color: #f1f5f9 !important;
        cursor: pointer;
    }

    /* --- ESTILO PARA INPUTS DEL BUSCADOR Y FILTRO (BORDE AZUL) --- */
    .custom-filter-input .mud-input-outlined-border {
        border-color: #cbd5e1 !important;
        transition: border-color 0.2s;
    }

    .custom-filter-input:hover .mud-input-outlined-border {
        border-color: #456990 !important;
    }

    .custom-filter-input .mud-input-label {
        color: #456990 !important;
        background-color: white !important;
        padding: 0 5px;
        font-weight: 600;
    }

    .custom-filter-input input,
    .custom-filter-input .mud-input-slot {
        color: #1e293b !important;
        font-weight: 500;
    }

    /* Grosor del borde al hacer foco */
    .custom-filter-input.mud-input-control.mud-input-focused .mud-input-outlined-border {
        border-width: 2px !important;
        border-color: #456990 !important;
    }
</style>

@* OVERLAY PARA TRANSICIÓN DE NAVEGACIÓN *@
<MudOverlay Visible="_navegando" DarkBackground="true" Absolute="false" ZIndex="9999">
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
</MudOverlay>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-10">

    @* --- HEADER --- *@
    <div class="d-flex align-center justify-space-between mb-6 flex-wrap gap-4">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 800; color: #456990; letter-spacing: -0.5px;">Historial de Admisiones</MudText>
            <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Registro histórico de solicitudes procesadas.</MudText>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.ClearAll"
                       Color="Color.Default"
                       OnClick="LimpiarFiltros"
                       Style="border-radius: 8px;">
                Limpiar Filtros
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Color="Color.Primary"
                       OnClick="CargarDatos"
                       Disabled="@cargando"
                       Style="font-weight: 700; border-radius: 8px;">
                Actualizar
            </MudButton>
        </div>
    </div>

    @* --- TABLA DE DATOS --- *@
    <MudTable T="SolicitudIngresoDTO"
              Items="@listaSolicitudes"
              Dense="true"
              Hover="true"
              Bordered="false"
              Striped="false"
              Filter="new Func<SolicitudIngresoDTO, bool>(FiltrarSolicitudes)"
              Elevation="2"
              Class="rounded-lg table-header-custom overflow-hidden"
              Loading="@cargando"
              LoadingProgressColor="Color.Primary"
              RowClass="row-hover-effect"
              OnRowClick="@((TableRowClickEventArgs<SolicitudIngresoDTO> args) => RowClickEvent(args))">

        <ToolBarContent>
            @* --- BARRA DE FILTROS --- *@
            <MudGrid Class="pt-2 pb-2 align-center" Spacing="2">

                @* BUSCADOR OPTIMIZADO *@
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="searchString"
                                  Label="Buscar Aspirante"
                                  Placeholder="DNI, Apellido o Nombre..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  AdornmentColor="Color.Primary"
                                  Class="custom-filter-input mt-0"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  FullWidth="true"
                                  Immediate="true"
                                  DebounceInterval="300"
                                  Clearable="true" />
                </MudItem>

                @* FILTRO ESTADO *@
                <MudItem xs="6" md="2">
                    <MudSelect T="string" @bind-Value="filtroEstado"
                               Label="Estado"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               AdornmentColor="Color.Primary"
                               Class="custom-filter-input"
                               FullWidth="true">
                        <MudSelectItem Value="@("Todos")">Todos</MudSelectItem>
                        <MudSelectItem Value="@("Aprobada")">Aprobadas</MudSelectItem>
                        <MudSelectItem Value="@("Rechazada")">Rechazadas</MudSelectItem>
                    </MudSelect>
                </MudItem>

                @* --- FILTRO FECHAS --- *@
                <MudItem xs="6" md="3">
                    <MudDatePicker @bind-Date="fechaDesde"
                                   Label="Procesado Desde"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="custom-filter-input"
                                   AdornmentIcon="@Icons.Material.Filled.Event"
                                   AdornmentColor="Color.Primary"
                                   MaxDate="@DateTime.Now"
                                   Clearable="true" />
                </MudItem>

                <MudItem xs="6" md="3">
                    <MudDatePicker @bind-Date="fechaHasta"
                                   Label="Procesado Hasta"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="custom-filter-input"
                                   AdornmentIcon="@Icons.Material.Filled.Event"
                                   AdornmentColor="Color.Primary"
                                   MaxDate="@DateTime.Now"
                                   Clearable="true" />
                </MudItem>

            </MudGrid>
        </ToolBarContent>

        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<SolicitudIngresoDTO, object>(x => x.FechaProcesado)">Fecha Proceso</MudTableSortLabel></MudTh>
            <MudTh>DNI</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<SolicitudIngresoDTO, object>(x => x.Apellido)">Aspirante</MudTableSortLabel></MudTh>
            <MudTh>Carrera Solicitada</MudTh>
            <MudTh Style="text-align:center;">Estado</MudTh>
            <MudTh>Observación</MudTh>
            <MudTh Style="text-align:center;">Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Fecha Proceso">
                <MudText Typo="Typo.body2" Style="font-weight: 600; color: #1e293b;">@context.FechaProcesado?.ToString("dd/MM/yyyy")</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.FechaProcesado?.ToString("HH:mm") hs</MudText>
            </MudTd>
            
            <MudTd DataLabel="DNI">
                <MudText Typo="Typo.body2" Style="color: #475569;">@context.Dni</MudText>
            </MudTd>
            
            <MudTd DataLabel="Aspirante">
                <MudText Typo="Typo.body2" Style="font-weight: 600; color: #1e293b;">@context.Apellido, @context.Nombre</MudText>
            </MudTd>
            
            <MudTd DataLabel="Carrera Solicitada">
                <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight:700;">@context.NombreCarrera</MudText>
            </MudTd>
            
            <MudTd DataLabel="Estado" Style="text-align:center;">
                @if (context.Estado == "Aprobada")
                {
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle" Style="font-weight: 600;">APROBADA</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Cancel" Style="font-weight: 600;">RECHAZADA</MudChip>
                }
            </MudTd>
            
            <MudTd DataLabel="Observación">
                @if (!string.IsNullOrEmpty(context.ObservacionAdmin))
                {
                    <MudTooltip Text="@context.ObservacionAdmin" Arrow="true" Placement="Placement.Left">
                        <div class="d-flex align-center cursor-pointer" style="opacity: 0.8;">
                            <MudIcon Icon="@Icons.Material.Filled.Comment" Size="Size.Small" Class="mr-1" Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Style="text-decoration: underline; color: #456990;">Ver nota</MudText>
                        </div>
                    </MudTooltip>
                }
                else
                {
                    <span style="color: #cbd5e1;">-</span>
                }
            </MudTd>
            
            <MudTd Style="text-align:center;" DataLabel="Acciones">
                <MudTooltip Text="Ver Documentación">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Size="Size.Small" OnClick="@(() => VerDetalle(context.Id))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>

        <LoadingContent>
            <MudText Typo="Typo.body1" Class="pa-4 text-center" Style="color: #64748b;">
                Descargando historial de solicitudes...
            </MudText>
        </LoadingContent>

        <NoRecordsContent>
            <div class="d-flex flex-column align-center justify-center pa-8">
                <MudIcon Icon="@Icons.Material.Filled.HistoryToggleOff" Style="font-size: 4rem; color: #cbd5e1;" Class="mb-3" />
                <MudText Typo="Typo.h6" Style="font-weight: 700; color: #475569;">No hay registros</MudText>
                <MudText Typo="Typo.body2" Style="color: #94a3b8;">No se encontraron solicitudes que coincidan con los filtros aplicados.</MudText>
            </div>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página" InfoFormat="{first_item}-{last_item} de {all_items}" />
        </PagerContent>

    </MudTable>

</MudContainer>

@code {
    private List<SolicitudIngresoDTO> listaSolicitudes = new();

    // Variables de Filtro
    private string searchString = "";
    private string filtroEstado = "Todos";
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;

    private bool cargando = true;
    private bool _navegando = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            // ✅ CORRECCIÓN: Se le agregó el sufijo "Async" según lo que actualizamos en ISolicitudService
            listaSolicitudes = await InscripcionService.GetHistorialSolicitudesAsync();
        }
        catch (ApplicationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception)
        {
            Snackbar.Add("Ocurrió un error al cargar el historial de admisiones.", Severity.Error);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void LimpiarFiltros()
    {
        searchString = "";
        filtroEstado = "Todos";
        fechaDesde = null;
        fechaHasta = null;
    }

    // --- FILTRADO AVANZADO SEGURO ---
    private bool FiltrarSolicitudes(SolicitudIngresoDTO element)
    {
        // 1. Filtro por Estado
        if (filtroEstado != "Todos" && element.Estado != filtroEstado)
            return false;

        // 2. Filtro por Fechas (Comparar solo fecha, ignorando hora)
        if (fechaDesde.HasValue)
        {
            if (!element.FechaProcesado.HasValue || element.FechaProcesado.Value.Date < fechaDesde.Value.Date)
                return false;
        }

        if (fechaHasta.HasValue)
        {
            if (!element.FechaProcesado.HasValue || element.FechaProcesado.Value.Date > fechaHasta.Value.Date)
                return false;
        }

        // 3. Filtro por Buscador (Texto) con protección de nulos
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        var term = searchString.Trim().ToLower();

        return (element.Dni?.Contains(term) ?? false) ||
               (element.Nombre?.ToLower().Contains(term) ?? false) ||
               (element.Apellido?.ToLower().Contains(term) ?? false) ||
               (element.NombreCarrera?.ToLower().Contains(term) ?? false);
    }

    private void RowClickEvent(TableRowClickEventArgs<SolicitudIngresoDTO> args)
    {
        VerDetalle(args.Item.Id);
    }

    private void VerDetalle(int id)
    {
        _navegando = true; // Activa el overlay
        StateHasChanged();
        
        Navigation.NavigateTo($"/admin/solicitudes/{id}");
    }
}