@page "/admin/inscripciones"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using EduSys.Web.Pages.Admin.Components
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Administrador, Secretaria Academica")]

@inject IAlumnoService AlumnoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h5" GutterBottom="true" Color="Color.Primary">
        <MudIcon Icon="@Icons.Material.Filled.AppRegistration" Class="mr-2" /> Gestión de Inscripciones Administrativas
    </MudText>
    <MudText Typo="Typo.body2" Class="mb-4">
        Busque un alumno para realizar inscripciones manuales (Forzar cupo, ignorar correlativas, fuera de término).
    </MudText>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else
    {
        <MudTable Items="@alumnos" Dense="true" Hover="true" Bordered="true" Striped="true" Filter="new Func<AlumnoListadoDTO,bool>(FilterFunc)">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Listado de Alumnos Activos</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="searchString" Placeholder="Buscar por Nombre, DNI o Legajo..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Legajo</MudTh>
                <MudTh>DNI</MudTh>
                <MudTh>Alumno</MudTh>
                <MudTh>Carrera / Plan</MudTh>
                <MudTh>Sede</MudTh>
                <MudTh Style="text-align:center">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Legajo">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">@context.Legajo</MudChip>
                </MudTd>
                <MudTd DataLabel="DNI">@context.Dni</MudTd>
                <MudTd DataLabel="Alumno">
                    <div class="d-flex align-center">
                        <MudAvatar Size="Size.Small" Class="mr-2">@(context.NombreCompleto.Substring(0, 1))</MudAvatar>
                        @context.NombreCompleto
                    </div>
                </MudTd>
                <MudTd DataLabel="Carrera">
                    <MudText Typo="Typo.caption">@context.NombreCarrera</MudText><br />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.NombrePlan</MudText>
                </MudTd>
                <MudTd DataLabel="Sede">@context.NombreSede</MudTd>
                <MudTd DataLabel="Acciones" Style="text-align:center">
                    <MudTooltip Text="Gestionar Inscripciones / Forzar Alta">
                        <MudIconButton Icon="@Icons.Material.Filled.PostAdd" 
                                       Color="Color.Success" 
                                       Variant="Variant.Filled" 
                                       Size="Size.Small"
                                       OnClick="@(() => AbrirInscripcionManual(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="Filas por pág." />
            </PagerContent>
        </MudTable>
    }
</MudContainer>

@code {
    private List<AlumnoListadoDTO> alumnos = new();
    private bool loading = true;
    private string searchString = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarAlumnos();
    }

    private async Task CargarAlumnos()
    {
        try
        {
            loading = true;
            // Usamos el método GetAllAsync que corregimos en el AlumnoRepository
            alumnos = await AlumnoService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar alumnos: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    // Lógica de filtrado para la tabla
    private bool FilterFunc(AlumnoListadoDTO element)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        
        if (element.NombreCompleto.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Dni.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Legajo.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
            
        return false;
    }

    // Abre el diálogo que creamos anteriormente
    private async Task AbrirInscripcionManual(AlumnoListadoDTO alumno)
    {
        var parameters = new DialogParameters
        {
            { "IdAlumno", alumno.IdAlumno },
            { "NombreAlumno", alumno.NombreCompleto },
            { "IdSede", alumno.IdSede },
            { "NombreSede", alumno.NombreSede ?? "Sede Central" } // <-- CLAVE: Evita enviar un NULL
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<GestionInscripcionesDialog>("", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            // Opcional: Si necesitas recargar algo tras la inscripción
            // En este caso, como es una acción directa, no hace falta recargar la lista de alumnos
        }
    }
}