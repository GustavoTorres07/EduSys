@page "/tramites"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.IO

@attribute [Authorize(Roles = "Alumno")]

@inject IPeriodoService PeriodoService
@inject IAlumnoService AlumnoService
@inject IReportesService ReportesService 
@inject IInscripcionFinalService InscripcionFinalService 
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<style>
    .tramites-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
    }

    .doc-card {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        transition: all 0.3s ease;
        background: white;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .doc-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            border-color: #456990;
        }

    .doc-icon-box {
        height: 60px;
        width: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }
</style>

<div class="tramites-container">
    <MudText Typo="Typo.h4" Class="mb-2" Style="font-weight: 700; color: #456990;">Trámites y Certificados</MudText>
    <MudText Typo="Typo.body1" Class="mb-8 text-muted">Descarga tus documentos académicos firmados digitalmente.</MudText>

    @if (loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudGrid>
            @* 1. CONSTANCIA DE INSCRIPCIÓN A CURSADA *@
            <MudItem xs="12" sm="6" md="4">
                <div class="doc-card pa-6">
                    <div class="doc-icon-box" style="background-color: #e0f2fe;">
                        <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Size="Size.Large" Style="color: #0284c7;" />
                    </div>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Constancia de Cursada</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2 mb-4" Style="color: #64748b;">
                        Documento que acredita las materias que estás cursando actualmente en el ciclo <strong>@periodoActual?.Nombre</strong>.
                    </MudText>
                    <div class="mt-auto">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="DescargarConstanciaInscripcion"
                                   Disabled="@(periodoActual == null || procesando)">
                            Descargar PDF
                        </MudButton>
                    </div>
                </div>
            </MudItem>

            @* 2. CERTIFICADO ALUMNO REGULAR *@
            <MudItem xs="12" sm="6" md="4">
                <div class="doc-card pa-6">
                    <div class="doc-icon-box" style="background-color: #f0fdf4;">
                        <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Large" Style="color: #16a34a;" />
                    </div>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Certificado Alumno Regular</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2 mb-4" Style="color: #64748b;">
                        Acredita tu condición de regularidad ante obras sociales y organismos.
                    </MudText>
                    <div class="mt-auto">
                        <MudButton Variant="Variant.Outlined" Color="Color.Success" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.RequestQuote"
                                   OnClick="DescargarCertificadoRegular"
                                   Disabled="@(periodoActual == null || procesando)">
                            Solicitar
                        </MudButton>
                    </div>
                </div>
            </MudItem>

            @* 3. CONSTANCIA DE EXAMEN FINAL (¡NUEVO!) *@
            <MudItem xs="12" sm="6" md="4">
                <div class="doc-card pa-6">
                    <div class="doc-icon-box" style="background-color: #f3e8ff;">
                        <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Large" Style="color: #9333ea;" />
                    </div>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Constancia Examen Final</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2 mb-2" Style="color: #64748b;">
                        Comprobante oficial de tu turno para rendir.
                    </MudText>
                    @if (misInscripcionesAFinales != null && misInscripcionesAFinales.Any())
                    {
                        <div class="mb-4">
                            <MudSelect T="int" @bind-Value="idFinalSeleccionado"
                                       Label="Seleccione un Final"
                                       Variant="Variant.Outlined"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Margin="Margin.Dense"
                                       Style="background-color: white; border-color: #456990;"
                                       Class="rounded-lg">
                                <MudSelectItem Value="0">
                                    <span style="color: #94a3b8; font-style: italic;">-- Elija un Final --</span>
                                </MudSelectItem>
                                @foreach (var final in misInscripcionesAFinales)
                                {
                                    <MudSelectItem Value="@final.IdInscripcionFinal!.Value">
                                        <span style="font-weight: 600; color: #1e293b;">@final.MateriaNombre</span>
                                        <span style="font-size: 0.8rem; color: #64748b;">(@final.FechaHora.ToString("dd/MM/yyyy"))</span>
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Normal" Class="mb-4 py-2" Style="font-size:0.8rem; background-color: #f8fafc; border: 1px dashed #cbd5e1;">
                            No tienes finales inscriptos vigentes.
                        </MudAlert>
                    }

                    <div class="mt-auto">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                   OnClick="DescargarConstanciaExamenFinal"
                                   Disabled="@(idFinalSeleccionado == 0 || procesando)">
                            Generar PDF
                        </MudButton>
                    </div>
                </div>
            </MudItem>

            @* 4. HISTORIA ACADÉMICA (Placeholder) *@
            <MudItem xs="12" sm="6" md="4">
                <div class="doc-card pa-6">
                    <div class="doc-icon-box" style="background-color: #fff7ed;">
                        <MudIcon Icon="@Icons.Material.Filled.HistoryEdu" Size="Size.Large" Style="color: #ea580c;" />
                    </div>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Analítico Provisorio</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2 mb-4" Style="color: #64748b;">
                        Listado de materias aprobadas con nota final y promedio general.
                    </MudText>
                    <div class="mt-auto">
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="DescargarAnalitico"
                                   Disabled="procesando">
                            Generar Analítico
                        </MudButton>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    }
</div>

@code {
    private bool loading = true;
    private bool procesando = false;
    private AlumnoDTO? alumnoActual;
    private PeriodoAcademicoDTO? periodoActual;

    // Variables para la Constancia de Finales
    private List<MesaFinalOfertaDTO> misInscripcionesAFinales = new();
    private int idFinalSeleccionado = 0;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var idUsuarioStr = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (int.TryParse(idUsuarioStr, out int idUsuario))
            {
                alumnoActual = await AlumnoService.GetByUsuarioIdAsync(idUsuario);

                var periodos = await PeriodoService.GetAllAsync();
                periodoActual = periodos.FirstOrDefault(p => p.Activo && p.Estado == "Abierto"
                                                        && p.FechaInicio <= DateTime.Now && p.FechaFin >= DateTime.Now);

                // Si hay periodo, buscamos sus inscripciones a finales
                if (alumnoActual != null && periodoActual != null)
                {
                    // Llamamos al servicio que devuelve la oferta y filtramos los que ya está inscripto
                    var oferta = await InscripcionFinalService.GetOfertaAsync(alumnoActual.Id, periodoActual.Id);
                    misInscripcionesAFinales = oferta.Where(o => o.YaInscripto).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar datos.", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    // ✅ DESCARGA CONSTANCIA DE EXAMEN FINAL
    private async Task DescargarConstanciaExamenFinal()
    {
        if (idFinalSeleccionado == 0) return;

        procesando = true;
        try
        {
            Snackbar.Add("Generando comprobante de mesa...", Severity.Info);

            var pdfBytes = await ReportesService.DescargarConstanciaFinalAsync(idFinalSeleccionado);
            var nombreMateria = misInscripcionesAFinales.First(m => m.IdInscripcionFinal == idFinalSeleccionado).MateriaNombre;
            var fileName = $"Constancia_Examen_{nombreMateria.Replace(" ", "_")}.pdf";

            using var stream = new MemoryStream(pdfBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

            Snackbar.Add("Descarga finalizada.", Severity.Success);
            idFinalSeleccionado = 0; // Reiniciamos el combo
        }
        catch (Exception)
        {
            Snackbar.Add("Error al generar la constancia de examen.", Severity.Error);
        }
        finally
        {
            procesando = false;
        }
    }

    // ✅ DESCARGA CONSTANCIA DE INSCRIPCIÓN (CURSADA)
    private async Task DescargarConstanciaInscripcion()
    {
        if (!ValidarRequisitos()) return;

        procesando = true;
        try
        {
            Snackbar.Add("Generando constancia...", Severity.Info);
            var pdfBytes = await ReportesService.DescargarConstanciaInscripcionPdfAsync(alumnoActual!.Id, periodoActual!.Id);
            var fileName = $"Constancia_Inscripcion_{DateTime.Now:yyyy}.pdf";

            using var stream = new MemoryStream(pdfBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

            Snackbar.Add("Descarga finalizada.", Severity.Success);
        }
        catch (Exception ex)
        {
            // Ahora mostrará el mensaje real: "No tienes materias inscriptas..."
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            procesando = false;
        }
    }

    // ✅ DESCARGA ANALÍTICO PROVISORIO
    private async Task DescargarAnalitico()
    {
        procesando = true;
        try
        {
            Snackbar.Add("Compilando historia académica...", Severity.Info);
            var pdfBytes = await ReportesService.DescargarAnaliticoProvisorioAsync();
            var fileName = $"Analitico_Provisorio_{DateTime.Now:yyyyMMdd}.pdf";

            using var stream = new MemoryStream(pdfBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

            Snackbar.Add("Analítico generado exitosamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            procesando = false;
        }
    }

    // ✅ DESCARGA CERTIFICADO ALUMNO REGULAR
    private async Task DescargarCertificadoRegular()
    {
        if (!ValidarRequisitos()) return;

        procesando = true;
        try
        {
            Snackbar.Add("Generando certificado...", Severity.Info);
            var pdfBytes = await ReportesService.DescargarCertificadoRegularPdfAsync(alumnoActual!.Id, periodoActual!.Id);
            var fileName = $"Certificado_Regular_{DateTime.Now:yyyy}.pdf";

            using var stream = new MemoryStream(pdfBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

            Snackbar.Add("Descarga finalizada.", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo generar el certificado. Verifica que tengas inscripciones activas.", Severity.Warning);
        }
        finally
        {
            procesando = false;
        }
    }

    private bool ValidarRequisitos()
    {
        if (periodoActual == null || alumnoActual == null)
        {
            Snackbar.Add("No hay un periodo activo o no se encontraron datos del alumno.", Severity.Warning);
            return false;
        }
        return true;
    }
}