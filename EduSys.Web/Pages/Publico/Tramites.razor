@page "/tramites"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.IO

@* 🔒 Esta vista es exclusiva para el perfil Alumno *@
@attribute [Authorize(Roles = "Alumno")]

@inject IPeriodoService PeriodoService
@inject IAlumnoService AlumnoService
@inject IReportesService ReportesService
@inject IInscripcionFinalService InscripcionFinalService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<style>
    :root {
        --edusys-primary: #1e3a58;
        --edusys-primary-light: #456990;
        --edusys-bg: #f8fafc;
        --edusys-border: #cbd5e1;
        --edusys-text-main: #1e293b;
        --edusys-text-muted: #64748b;
    }

    .tramites-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem;
    }

    .doc-card {
        border: 1px solid var(--edusys-border);
        border-radius: 16px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background: white;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .doc-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 25px -5px rgba(30, 58, 88, 0.1);
        border-color: var(--edusys-primary-light);
    }

    .doc-header { padding: 1.5rem 1.5rem 0 1.5rem; }

    .doc-icon-box {
        height: 64px;
        width: 64px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.25rem;
    }

    .doc-body {
        padding: 0 1.5rem 1.5rem 1.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .doc-footer {
        padding: 1.25rem 1.5rem;
        background-color: var(--edusys-bg);
        border-top: 1px dashed var(--edusys-border);
        margin-top: auto;
    }

    .custom-select-doc .mud-input-outlined-border { border-color: var(--edusys-border) !important; background-color: white; }
    .custom-select-doc.mud-input-control.mud-input-focused .mud-input-outlined-border { border-color: #9333ea !important; border-width: 2px !important; }
</style>

@* OVERLAY GLOBAL PARA GENERACIÓN DE PDF *@
<MudOverlay Visible="procesando" DarkBackground="true" Absolute="false" ZIndex="9999">
    <MudStack AlignItems="AlignItems.Center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.h6" Style="color: white; font-weight: 600;">Generando documento PDF...</MudText>
        <MudText Typo="Typo.body2" Style="color: #cbd5e1;">Esto puede demorar unos segundos.</MudText>
    </MudStack>
</MudOverlay>

<div class="tramites-container animate__animated animate__fadeIn">
    
    <div class="mb-10">
        <MudText Typo="Typo.h4" Style="font-weight: 800; color: var(--edusys-primary); letter-spacing: -0.5px;">Trámites y Certificados</MudText>
        <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Gestión y descarga de documentación académica oficial de autogestión.</MudText>
    </div>

    @if (loading)
    {
        <MudGrid Spacing="4">
            @for (int i = 0; i < 3; i++)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="0" Class="rounded-lg pa-4" Style="border: 1px solid #e2e8f0;">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="64px" Height="64px" Class="rounded-lg mb-4" />
                        <MudSkeleton Width="80%" Height="24px" Class="mb-2" />
                        <MudSkeleton Width="100%" Height="60px" Class="mb-6" />
                        <MudSkeleton Width="100%" Height="40px" Class="rounded-lg" />
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <MudGrid Spacing="4">
            
            @* 1. CONSTANCIA DE INSCRIPCIÓN A CURSADA *@
            <MudItem xs="12" sm="6" lg="4">
                <div class="doc-card">
                    <div class="doc-header">
                        <div class="doc-icon-box" style="background: #e0f2fe; border: 1px solid #7dd3fc;">
                            <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Size="Size.Large" Style="color: #0284c7;" />
                        </div>
                        <MudText Typo="Typo.h6" Style="font-weight: 800; color: var(--edusys-text-main);">Constancia de Cursada</MudText>
                    </div>
                    <div class="doc-body">
                        <MudText Typo="Typo.body2" Class="mt-2" Style="color: var(--edusys-text-muted);">
                            Acredita las asignaturas en las que te encuentras inscripto en el ciclo actual.
                        </MudText>
                        <div class="mt-4 pa-3 rounded-lg" style="background-color: #f8fafc; border: 1px dashed #cbd5e1;">
                            <MudText Typo="Typo.caption" Style="font-weight: 700;">CICLO LECTIVO ACTUAL</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 800;">@(periodoActual?.Nombre ?? "Sin ciclo activo")</MudText>
                        </div>
                    </div>
                    <div class="doc-footer">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="DescargarConstanciaInscripcion"
                                   Disabled="@(periodoActual == null || procesando)" StartIcon="@Icons.Material.Filled.Download">
                            GENERAR PDF
                        </MudButton>
                    </div>
                </div>
            </MudItem>

            @* 2. CERTIFICADO ALUMNO REGULAR *@
            <MudItem xs="12" sm="6" lg="4">
                <div class="doc-card">
                    <div class="doc-header">
                        <div class="doc-icon-box" style="background: #f0fdf4; border: 1px solid #86efac;">
                            <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Large" Style="color: #16a34a;" />
                        </div>
                        <MudText Typo="Typo.h6" Style="font-weight: 800; color: var(--edusys-text-main);">Certificado Alumno Regular</MudText>
                    </div>
                    <div class="doc-body">
                        <MudText Typo="Typo.body2" Class="mt-2" Style="color: var(--edusys-text-muted);">
                            Documento oficial para presentar ante obras sociales, empleadores o trámites externos.
                        </MudText>
                    </div>
                    <div class="doc-footer">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" OnClick="DescargarCertificadoRegular"
                                   Disabled="@(periodoActual == null || procesando)" StartIcon="@Icons.Material.Filled.Verified">
                            SOLICITAR CERTIFICADO
                        </MudButton>
                    </div>
                </div>
            </MudItem>

            @* 3. HISTORIA ACADÉMICA / ANALÍTICO *@
            <MudItem xs="12" sm="6" lg="4">
                <div class="doc-card">
                    <div class="doc-header">
                        <div class="doc-icon-box" style="background: #fff7ed; border: 1px solid #fdba74;">
                            <MudIcon Icon="@Icons.Material.Filled.HistoryEdu" Size="Size.Large" Style="color: #ea580c;" />
                        </div>
                        <MudText Typo="Typo.h6" Style="font-weight: 800; color: var(--edusys-text-main);">Analítico Provisorio</MudText>
                    </div>
                    <div class="doc-body">
                        <MudText Typo="Typo.body2" Class="mt-2" Style="color: var(--edusys-text-muted);">
                            Listado completo de materias aprobadas, calificaciones finales y promedio histórico.
                        </MudText>
                    </div>
                    <div class="doc-footer">
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true" OnClick="DescargarAnalitico"
                                   Disabled="procesando" StartIcon="@Icons.Material.Filled.MenuBook">
                            DESCARGAR HISTORIAL
                        </MudButton>
                    </div>
                </div>
            </MudItem>

            @* 4. CONSTANCIA DE EXAMEN FINAL *@
            <MudItem xs="12" sm="6" lg="4">
                <div class="doc-card">
                    <div class="doc-header">
                        <div class="doc-icon-box" style="background: #f3e8ff; border: 1px solid #d8b4fe;">
                            <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Large" Style="color: #9333ea;" />
                        </div>
                        <MudText Typo="Typo.h6" Style="font-weight: 800; color: var(--edusys-text-main);">Turno de Examen Final</MudText>
                    </div>
                    <div class="doc-body">
                        <MudText Typo="Typo.body2" Class="mt-2 mb-3" Style="color: var(--edusys-text-muted);">
                            Justificativo de examen para presentar en el trabajo.
                        </MudText>
                        @if (misInscripcionesAFinales.Any())
                        {
                            <MudSelect T="int" @bind-Value="idFinalSeleccionado" Label="Seleccionar Mesa" Variant="Variant.Outlined" Margin="Margin.Dense" Class="custom-select-doc">
                                <MudSelectItem Value="0" Disabled="true">Seleccione el turno...</MudSelectItem>
                                @foreach (var final in misInscripcionesAFinales)
                                {
                                    <MudSelectItem Value="@final.IdInscripcionFinal!.Value">
                                        @final.MateriaNombre (@final.FechaHora.ToString("dd/MM HH:mm") hs)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Style="color: #94a3b8; font-style: italic;">No tienes inscripciones a finales registradas.</MudText>
                        }
                    </div>
                    <div class="doc-footer">
                        <MudButton Variant="Variant.Filled" Style="background-color: #9333ea; color: white;" FullWidth="true" OnClick="DescargarConstanciaExamenFinal"
                                   Disabled="@(idFinalSeleccionado == 0 || procesando)" StartIcon="@Icons.Material.Filled.PictureAsPdf">
                            GENERAR CONSTANCIA
                        </MudButton>
                    </div>
                </div>
            </MudItem>

        </MudGrid>
    }
</div>

@code {
    private bool loading = true;
    private bool procesando = false;
    private AlumnoDTO? alumnoActual;
    private PeriodoAcademicoDTO? periodoActual;
    private List<MesaFinalOfertaDTO> misInscripcionesAFinales = new();
    private int idFinalSeleccionado = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        loading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var idUsuarioStr = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (int.TryParse(idUsuarioStr, out int idUsuario))
            {
                alumnoActual = await AlumnoService.GetByUsuarioIdAsync(idUsuario);
                var periodos = await PeriodoService.GetAllAsync();
                periodoActual = periodos.FirstOrDefault(p => p.Activo);

                if (alumnoActual != null && periodoActual != null)
                {
                    var oferta = await InscripcionFinalService.GetOfertaAsync(alumnoActual.Id, periodoActual.Id);
                    misInscripcionesAFinales = oferta.Where(o => o.YaInscripto).ToList();
                }
            }
        }
        catch { Snackbar.Add("Error de conexión al cargar tus datos.", Severity.Error); }
        finally { loading = false; }
    }

    private async Task DescargarAnalitico()
    {
        procesando = true;
        try
        {
            // El backend identifica al alumno por el Token JWT
            var pdfBytes = await ReportesService.DescargarAnaliticoProvisorioAsync();
            
            var fileName = $"Analitico_{DateTime.Now:yyyyMMdd}.pdf";
            await DescargarFile(fileName, pdfBytes);
            
            Snackbar.Add("Analítico generado correctamente.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning); 
        }
        finally { procesando = false; }
    }

    private async Task DescargarConstanciaInscripcion()
    {
        if (alumnoActual == null || periodoActual == null) return;
        procesando = true;
        try
        {
            var pdfBytes = await ReportesService.DescargarConstanciaInscripcionPdfAsync(alumnoActual.Id, periodoActual.Id);
            await DescargarFile($"Inscripcion_{periodoActual.Nombre}.pdf", pdfBytes);
            Snackbar.Add("Constancia descargada con éxito.", Severity.Success);
        }
        catch { Snackbar.Add("Error al generar la constancia.", Severity.Error); }
        finally { procesando = false; }
    }

    private async Task DescargarCertificadoRegular()
    {
        if (alumnoActual == null || periodoActual == null) return;
        procesando = true;
        try
        {
            var pdfBytes = await ReportesService.DescargarCertificadoRegularPdfAsync(alumnoActual.Id, periodoActual.Id);
            await DescargarFile("Certificado_Regular.pdf", pdfBytes);
            Snackbar.Add("Certificado generado con éxito.", Severity.Success);
        }
        catch { Snackbar.Add("No se registran inscripciones activas para este ciclo.", Severity.Warning); }
        finally { procesando = false; }
    }

    private async Task DescargarConstanciaExamenFinal()
    {
        if (idFinalSeleccionado == 0) return;
        procesando = true;
        try
        {
            var pdfBytes = await ReportesService.DescargarConstanciaFinalAsync(idFinalSeleccionado);
            await DescargarFile("Constancia_Examen.pdf", pdfBytes);
            idFinalSeleccionado = 0;
            Snackbar.Add("Constancia de examen generada.", Severity.Success);
        }
        catch { Snackbar.Add("Error al generar la constancia de examen.", Severity.Error); }
        finally { procesando = false; }
    }

    private async Task DescargarFile(string fileName, byte[] content)
    {
        using var stream = new MemoryStream(content);
        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }
}