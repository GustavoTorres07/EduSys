@page "/inscripcion"
@layout Layout.EmptyLayout

@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Components.Forms
@inject ICarreraService CarreraService
@inject ISedeService SedeService
@inject ISolicitudService InscripcionService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<style>
    /* --- SISTEMA DE DISEÑO EDUSYS --- */
    :root {
        --edusys-primary: #1e3a58;
        --edusys-primary-light: #456990;
        --edusys-accent: #0284c7;
        --edusys-success: #10b981;
        --edusys-warning: #f59e0b;
        --edusys-bg: #f8fafc;
        --edusys-border: #cbd5e1;
        --edusys-text-main: #1e293b;
        --edusys-text-muted: #64748b;
    }

    body, html {
        height: 100%;
        overflow: hidden;
        margin: 0;
        background-color: white;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .split-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        display: flex;
        background-color: white;
    }

    /* --- COLUMNA IZQUIERDA (BRANDING) --- */
    .brand-section {
        flex: 0.8;
        background: linear-gradient(135deg, var(--edusys-primary) 0%, var(--edusys-primary-light) 100%);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        padding: 3rem;
        position: relative;
        box-shadow: 4px 0 20px rgba(0,0,0,0.1);
        z-index: 10;
    }

    .brand-section::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background-image: radial-gradient(circle at 20% 80%, rgba(255,255,255,0.1) 0%, transparent 50%);
        pointer-events: none;
    }

    /* --- COLUMNA DERECHA (FORMULARIO) --- */
    .form-section {
        flex: 1.2;
        padding: 3rem;
        background-color: white;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .form-container {
        width: 100%;
        max-width: 800px;
        padding-bottom: 4rem;
    }

    /* --- INPUTS UNIFICADOS --- */
    .custom-input {
        margin-bottom: 0.5rem;
    }

    .custom-input .mud-input-slot,
    .custom-input .mud-input-outlined,
    .custom-input .mud-input-control {
        background-color: var(--edusys-bg) !important;
        border-radius: 8px !important;
    }

    .custom-input .mud-input-outlined-border {
        border-color: var(--edusys-border) !important;
        transition: border-color 0.2s;
    }

    .custom-input:hover .mud-input-outlined-border {
        border-color: var(--edusys-primary-light) !important;
    }

    .custom-input .mud-input-control.mud-input-focused .mud-input-outlined-border {
        border-color: var(--edusys-primary) !important;
        border-width: 2px !important;
    }

    .custom-input input,
    .custom-input .mud-select-input {
        color: var(--edusys-text-main) !important;
        font-weight: 600;
        -webkit-text-fill-color: var(--edusys-text-main) !important;
    }

    .custom-input .mud-input-label {
        color: var(--edusys-text-muted) !important;
        font-weight: 600;
        background-color: var(--edusys-bg) !important;
        padding: 0 4px;
    }

    .custom-input .mud-input-control.mud-input-focused .mud-input-label {
        color: var(--edusys-primary) !important;
    }

    /* --- UPLOAD DE ARCHIVOS --- */
    .file-btn-wrapper {
        border: 2px dashed var(--edusys-border);
        border-radius: 12px;
        padding: 12px 8px;
        text-align: center;
        transition: all 0.2s ease-in-out;
        background-color: var(--edusys-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
    }

    .file-btn-wrapper:hover {
        border-color: var(--edusys-primary-light);
        background-color: #f0f9ff;
    }

    .file-uploaded {
        border-color: var(--edusys-success);
        background-color: #f0fdf4;
        border-style: solid;
    }

    .btn-primary-custom {
        background-color: var(--edusys-primary) !important;
        color: white !important;
        font-weight: 800;
        letter-spacing: 1px;
        box-shadow: 0 4px 10px rgba(30, 58, 88, 0.2);
    }

    .section-title {
        color: var(--edusys-primary);
        font-weight: 800;
        font-size: 1rem;
        border-bottom: 2px solid var(--edusys-border);
        padding-bottom: 6px;
        margin-top: 1rem;
        margin-bottom: 1rem;
    }

    @@media (max-width: 960px) {
        .brand-section { display: none; }
        .form-section { padding: 1.5rem; flex: 1; }
    }
</style>

@* OVERLAY DE PROCESAMIENTO *@
<MudOverlay Visible="procesando" DarkBackground="true" Absolute="false" ZIndex="9999">
    <MudStack AlignItems="AlignItems.Center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.h5" Style="color: white; font-weight: 700;">Procesando inscripción...</MudText>
        <MudText Typo="Typo.body2" Style="color: #cbd5e1;">Aguarde mientras subimos los documentos.</MudText>
    </MudStack>
</MudOverlay>

<div class="split-wrapper">
    <div class="brand-section">
        <MudIcon Icon="@Icons.Material.Filled.School" Style="font-size: 5rem; color: white; margin-bottom: 1.5rem;" />
        <MudText Typo="Typo.h3" Style="font-weight: 800; letter-spacing: -1px; text-align: center;">EduSys Portal</MudText>
        <MudText Typo="Typo.h6" Style="font-weight: 400; opacity: 0.9; text-align: center; margin-top: 12px; max-width: 80%;">
            Inicia tu futuro profesional completando tu inscripción digital.
        </MudText>
        <div style="margin-top: 4rem;">
            <MudButton Variant="Variant.Outlined"
                       Style="color: white; border-color: rgba(255,255,255,0.5); font-weight: 600; border-radius: 8px;"
                       OnClick='() => Navigation.NavigateTo("/")'
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Disabled="procesando">
                Volver al Inicio
            </MudButton>
        </div>
    </div>

    <div class="form-section">
        <div class="form-container">
            @if (enviadoExitosamente)
            {
                <div class="animate__animated animate__fadeIn" style="text-align: center; padding: 40px; margin-top: 10vh;">
                    <div style="background-color: #f0fdf4; display: inline-block; padding: 2rem; border-radius: 50%; margin-bottom: 2rem;">
                        <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Style="font-size: 6rem; color: var(--edusys-success);" />
                    </div>
                    <MudText Typo="Typo.h3" Style="font-weight: 800; color: var(--edusys-primary); letter-spacing: -1px;">¡Solicitud Recibida!</MudText>
                    <MudText Typo="Typo.h6" Class="mt-4" Style="color: var(--edusys-text-muted);">Tus datos han sido registrados exitosamente.</MudText>
                    <MudText Typo="Typo.body1" Class="mt-2">Revisa tu correo <b>@solicitud.Email</b> para los siguientes pasos.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-10 btn-primary-custom py-3 px-8 rounded-lg" OnClick='() => Navigation.NavigateTo("/")'>
                        Ir al Inicio
                    </MudButton>
                </div>
            }
            else
            {
                <div class="mb-6 animate__animated animate__fadeInDown">
                    <MudText Typo="Typo.h4" Style="font-weight: 800; color: var(--edusys-primary); letter-spacing: -1px;">Inscripción a Carrera</MudText>
                    <MudText Typo="Typo.body1" Style="color: var(--edusys-text-muted);">Completa tus datos y adjunta tu documentación digital.</MudText>
                </div>

                <EditForm Model="@solicitud" OnValidSubmit="EnviarFormulario" class="animate__animated animate__fadeIn">
                    <DataAnnotationsValidator />
                    <MudGrid Spacing="3">
                        <MudItem xs="12"><div class="section-title">1. Datos Personales</div></MudItem>
                        
                        <MudItem xs="12" sm="6">
                            <div class="custom-input">
                                <MudTextField @bind-Value="solicitud.Nombre" Label="Nombres" Variant="Variant.Outlined" For="@(() => solicitud.Nombre)" Disabled="procesando" />
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="custom-input">
                                <MudTextField @bind-Value="solicitud.Apellido" Label="Apellidos" Variant="Variant.Outlined" For="@(() => solicitud.Apellido)" Disabled="procesando" />
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="custom-input">
                                <MudTextField @bind-Value="solicitud.Dni" Label="DNI" Variant="Variant.Outlined" For="@(() => solicitud.Dni)" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Badge" Disabled="procesando" />
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="custom-input">
                                <MudDatePicker Label="Fecha de Nacimiento" @bind-Date="solicitud.FechaNacimiento" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" For="@(() => solicitud.FechaNacimiento)" Disabled="procesando" />
                            </div>
                        </MudItem>
                        <MudItem xs="12">
                            <div class="custom-input">
                                <MudTextField @bind-Value="solicitud.Email" Label="Email" Variant="Variant.Outlined" HelperText="Te contactaremos aquí" For="@(() => solicitud.Email)" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" Disabled="procesando" />
                            </div>
                        </MudItem>

                        <MudItem xs="12" Class="mt-4"><div class="section-title">2. Oferta Académica</div></MudItem>
                        
                        <MudItem xs="12" sm="6">
                            <div class="custom-input">
                                <MudSelect T="int" Label="Sede" Variant="Variant.Outlined" Value="idSedeSeleccionada" ValueChanged="CargarCarrerasPorSede" Disabled="procesando">
                                    <MudSelectItem Value="0" Disabled="true">Seleccione Sede</MudSelectItem>
                                    @foreach (var s in listaSedes) { <MudSelectItem Value="@s.Id">@s.Nombre</MudSelectItem> }
                                </MudSelect>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="custom-input">
                                <MudSelect T="int" Label="Carrera" Variant="Variant.Outlined" @bind-Value="solicitud.IdCarreraInteres" For="@(() => solicitud.IdCarreraInteres)" Disabled="@(idSedeSeleccionada == 0 || procesando)">
                                    <MudSelectItem Value="0" Disabled="true">Seleccione Carrera</MudSelectItem>
                                    @foreach (var c in listaCarreras) { <MudSelectItem Value="@c.Id">@c.Nombre</MudSelectItem> }
                                </MudSelect>
                            </div>
                        </MudItem>

                        <MudItem xs="12" Class="mt-4"><div class="section-title">3. Documentación</div></MudItem>
                        
                        @foreach (var doc in new[] { ("perfil", "Foto Perfil", Icons.Material.Filled.AccountCircle), ("selfie_dni", "Selfie con DNI", Icons.Material.Filled.CameraAlt), ("titulo", "Título Sec.", Icons.Material.Filled.School), ("dnifrente", "DNI Frente", Icons.Material.Filled.Badge), ("dnidorso", "DNI Dorso", Icons.Material.Filled.CreditCard), ("penales", "Ant. Penales", Icons.Material.Filled.Security) })
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <div class="@ObtenerClaseArchivo(doc.Item1)">
                                    <MudFileUpload T="IBrowserFile" FilesChanged="@(async (f) => await CargarArchivo(f, doc.Item1))" Accept=".jpg,.jpeg,.png,.pdf" Disabled="procesando">
                                        <ActivatorContent>
                                            <MudButton Variant="Variant.Text" FullWidth="true" StartIcon="@ObtenerIcono(doc.Item1, doc.Item3)" Color="@ObtenerColor(doc.Item1)">
                                                @ObtenerTexto(doc.Item1, doc.Item2)
                                            </MudButton>
                                        </ActivatorContent>
                                    </MudFileUpload>
                                </div>
                            </MudItem>
                        }

                        <MudItem xs="12" Class="mt-8">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" FullWidth="true" Size="Size.Large" Class="btn-primary-custom py-4 rounded-lg" Disabled="@procesando">
                                ENVIAR SOLICITUD
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    private SolicitudIngresoRequestDTO solicitud = new();
    private List<SedeDTO> listaSedes = new();
    private List<CarreraDTO> listaCarreras = new();
    private int idSedeSeleccionada = 0;
    private bool procesando = false;
    private bool enviadoExitosamente = false;

    private Dictionary<string, bool> estadoArchivos = new()
    {
        { "perfil", false }, { "selfie_dni", false }, { "titulo", false }, 
        { "dnifrente", false }, { "dnidorso", false }, { "penales", false }
    };

    protected override async Task OnInitializedAsync()
    {
        try {
            var sedes = await SedeService.GetAllAsync();
            listaSedes = sedes.Where(s => s.Activo).ToList();
        } catch { Snackbar.Add("Error al cargar sedes.", Severity.Error); }
    }

    private async Task CargarCarrerasPorSede(int idSede)
    {
        idSedeSeleccionada = idSede;
        solicitud.IdSede = idSede;
        solicitud.IdCarreraInteres = 0;
        if (idSede > 0) listaCarreras = await CarreraService.GetCarrerasPorSedeAsync(idSede);
    }

    private string ObtenerClaseArchivo(string key) => estadoArchivos[key] ? "file-btn-wrapper file-uploaded" : "file-btn-wrapper";
    private Color ObtenerColor(string key) => estadoArchivos[key] ? Color.Success : Color.Primary;
    private string ObtenerIcono(string key, string def) => estadoArchivos[key] ? Icons.Material.Filled.CheckCircle : def;
    private string ObtenerTexto(string key, string def) => estadoArchivos[key] ? "Cargado" : def;

    private async Task CargarArchivo(IBrowserFile archivo, string tipo)
    {
        if (archivo == null) return;
        if (archivo.Size > 5120000) { Snackbar.Add("Máximo 5MB por archivo.", Severity.Warning); return; }

        try {
            var buffer = new byte[archivo.Size];
            using var stream = archivo.OpenReadStream(5120000);
            await stream.ReadAsync(buffer);
            var dataUrl = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(buffer)}";

            switch (tipo) {
                case "perfil": solicitud.FotoPerfilBase64 = dataUrl; break;
                case "selfie_dni": solicitud.FotoSosteniendoDniBase64 = dataUrl; break;
                case "titulo": solicitud.TituloSecundarioBase64 = dataUrl; break;
                case "dnifrente": solicitud.FotoDniFrenteBase64 = dataUrl; break;
                case "dnidorso": solicitud.FotoDniDorsoBase64 = dataUrl; break;
                case "penales": solicitud.AntecedentesPenalesBase64 = dataUrl; break;
            }
            estadoArchivos[tipo] = true;
        } catch { Snackbar.Add("Error al leer el archivo.", Severity.Error); }
    }

    private async Task EnviarFormulario()
    {
        if (!estadoArchivos.Values.All(v => v)) { Snackbar.Add("Debe cargar los 6 documentos.", Severity.Warning); return; }
        if (solicitud.IdSede == 0 || solicitud.IdCarreraInteres == 0) { Snackbar.Add("Sede y Carrera son obligatorias.", Severity.Warning); return; }

        procesando = true;
        try {
            await InscripcionService.EnviarSolicitudAsync(solicitud);
            enviadoExitosamente = true;
        } catch { Snackbar.Add("Error al enviar la solicitud.", Severity.Error); }
        finally { procesando = false; }
    }
}