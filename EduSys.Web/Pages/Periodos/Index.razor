@page "/periodos"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@inject IPeriodoService PeriodoService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<style>
    /* --- CORRECCIÓN DE VISIBILIDAD DE ETIQUETAS --- */
    /* Forzamos que el label sea del azul corporativo y tenga fondo blanco para no mezclarse con el borde */
    .force-black-text .mud-input-label {
        color: #456990 !important;
        background-color: white !important;
        padding: 0 5px !important;
        z-index: 5 !important; /* Asegura que quede por encima del borde */
        font-weight: 700 !important;
        opacity: 1 !important; /* Evita transparencias */
    }

    /* Texto del input en negro fuerte */
    .force-black-text input,
    .force-black-text .mud-input-slot,
    .force-black-text .mud-select-input {
        color: #1F2937 !important;
        font-weight: 600 !important;
    }

    /* Borde del input */
    .custom-input-borde .mud-input-outlined-border {
        border-color: #456990 !important;
    }

    /* --- ESTILOS DE BADGES Y MODALES (Igual que antes) --- */
    .active-badge {
        background-color: #49BEAA;
        color: white;
        font-weight: bold;
        padding: 4px 8px;
        border-radius: 4px;
        text-transform: uppercase;
        font-size: 0.75rem;
    }

    .inactive-badge {
        background-color: #94a3b8;
        color: white;
        font-weight: bold;
        padding: 4px 8px;
        border-radius: 4px;
        text-transform: uppercase;
        font-size: 0.75rem;
    }

    .unified-dialog-card {
        background-color: white !important;
        border-radius: 12px !important;
    }

    .modal-header {
        background: #456990;
        color: white;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .modal-header-warning {
        background: #F59E0B;
        color: white;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
    }

    .modal-body {
        padding: 24px;
    }

    .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .section-title {
        color: #456990;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 4px;
        margin-bottom: 12px;
    }
</style>

<MudText Typo="Typo.h5" Color="Color.Primary" Align="Align.Center" Class="mb-6"><b>Gestión de Ciclos Lectivos</b></MudText>

<MudContainer MaxWidth="MaxWidth.Large">

    <div class="d-flex justify-end mb-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => AbrirModal())" Class="rounded-lg px-4">
            Nuevo Ciclo Lectivo
        </MudButton>
    </div>

    <MudTable Items="@periodos" Hover="true" Loading="@loading" Elevation="3" Class="rounded-xl">
        <HeaderContent>
            <MudTh>Nombre del Ciclo</MudTh>
            <MudTh>Duración</MudTh>
            <MudTh Style="text-align:center">Estado</MudTh>
            <MudTh Style="text-align:center">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><MudText Typo="Typo.body1" Style="font-weight: 600;">@context.Nombre</MudText></MudTd>
            <MudTd>
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.caption"><b>Inicio:</b> @($"{context.FechaInicio:dd/MM/yyyy}")</MudText>
                    <MudText Typo="Typo.caption"><b>Fin:</b> @($"{context.FechaFin:dd/MM/yyyy}")</MudText>
                </div>
            </MudTd>
            <MudTd Style="text-align:center">
                @if (context.Activo)
                {
                    <span class="active-badge">Vigente (Actual)</span>
                }
                else
                {

                    <span class="inactive-badge">Histórico</span>
                }
            </MudTd>
            <MudTd Style="text-align:center">
                <div class="d-flex justify-center gap-2">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => AbrirModal(context))" />
                    @if (!context.Activo)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => AbrirModalBaja(context))" />
                    }
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Align="Align.Center" Class="pa-4">No hay ciclos registrados.</MudText></NoRecordsContent>
    </MudTable>
</MudContainer>

@* --- MODAL CREAR / EDITAR --- *@
<MudDialog @bind-Visible="mostrarDialogo" Options="dialogOptions" Class="unified-dialog-card">
    <TitleContent></TitleContent>
    <DialogContent>
        <div style="display: flex; flex-direction: column; height: 100%;">
            <div class="modal-header">
                <div class="d-flex align-center">
                    <MudIcon Icon="@(modelo.Id == 0 ? Icons.Material.Filled.DateRange : Icons.Material.Filled.Edit)" Class="mr-3" />
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">@(modelo.Id == 0 ? "Nuevo Ciclo Lectivo" : "Editar Ciclo")</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="CerrarModal" Size="Size.Small" />
            </div>
            <div class="modal-body">
                <EditForm Model="@modelo" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <MudGrid>
                        <MudItem xs="12"><div class="section-title">Datos del Ciclo</div></MudItem>

                        @* APLICAMOS LAS CLASES CORREGIDAS AQUÍ *@
                        <MudItem xs="12">
                            <MudTextField Label="Nombre del Ciclo" @bind-Value="modelo.Nombre"
                                          Placeholder="Ej: Ciclo Lectivo 2026"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Class="force-black-text custom-input-borde" Required="true" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudDatePicker Label="Fecha Inicio" @bind-Date="fechaInicioTemp"
                                           Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Class="force-black-text custom-input-borde" Required="true" DateFormat="dd/MM/yyyy" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudDatePicker Label="Fecha Fin" @bind-Date="fechaFinTemp"
                                           Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Class="force-black-text custom-input-borde" Required="true" DateFormat="dd/MM/yyyy" />
                        </MudItem>

                        <MudItem xs="12"><div class="section-title mt-3">Estado del Sistema</div></MudItem>
                        <MudItem xs="12">
                            <MudPaper Elevation="0" Class="pa-4" Style="background-color: #F8FAFC; border: 1px solid #E2E8F0;">
                                <div class="d-flex align-center justify-space-between">
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>¿Es el Ciclo Lectivo Vigente?</b></MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Default">Al activarlo, este será el periodo predeterminado.</MudText>
                                    </div>
                                    <MudSwitch @bind-Value="modelo.Activo" Color="Color.Success" />
                                </div>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                    <button type="submit" id="submitBtn" style="display:none;"></button>
                </EditForm>
            </div>
            <div class="modal-footer">
                <MudButton OnClick="CerrarModal" Variant="Variant.Outlined" Color="Color.Default">Cancelar</MudButton>
                <MudButton OnClick="@(() => TriggerSubmit())" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save">Guardar</MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@* --- MODAL ELIMINAR (Con estilo) --- *@
<MudDialog @bind-Visible="mostrarDialogoBaja" Options="optionsBaja" Class="unified-dialog-card">
    <DialogContent>
        <div class="pa-4 d-flex flex-column align-center text-center">
            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Style="font-size: 4rem;" Class="mb-4" />
            <MudText Typo="Typo.h5" Style="color: #d97706; font-weight: 800;" Class="mb-2">Eliminar Periodo</MudText>
            <MudText Typo="Typo.body1" Class="mb-4">¿Estás seguro de eliminar <b>@modeloParaBaja?.Nombre</b>?</MudText>
            <MudText Typo="Typo.caption" Color="Color.Default">Esta acción no se puede deshacer si ya tiene datos vinculados.</MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="px-6 pb-6 d-flex justify-center gap-4" style="width: 100%;">
            <MudButton OnClick="CerrarModales" Variant="Variant.Outlined" Color="Color.Default" Class="rounded-lg">Cancelar</MudButton>
            <MudButton OnClick="ConfirmarBaja" Variant="Variant.Filled" Color="Color.Error" Class="rounded-lg px-6">Eliminar</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    // ... (El código C# es el mismo que tenías, solo cambiamos el diseño arriba) ...
    private bool loading = true;
    private List<PeriodoAcademicoDTO> periodos = new();
    private bool mostrarDialogo = false;
    private bool mostrarDialogoBaja = false;
    private PeriodoAcademicoDTO modelo = new();
    private PeriodoAcademicoDTO? modeloParaBaja;
    private DateTime? fechaInicioTemp;
    private DateTime? fechaFinTemp;

    private DialogOptions dialogOptions = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseButton = false, NoHeader = true };
    private DialogOptions optionsBaja = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, BackdropClick = false, CloseButton = false };

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarDatos()
    {
        loading = true;
        try
        {
            periodos = await PeriodoService.GetAllAsync();
            periodos = periodos.OrderByDescending(p => p.Activo).ThenByDescending(p => p.FechaInicio).ToList();
        }
        finally { loading = false; }
    }

    private void AbrirModal(PeriodoAcademicoDTO? p = null)
    {
        if (p != null) { modelo = new PeriodoAcademicoDTO { Id = p.Id, Nombre = p.Nombre, Activo = p.Activo, Estado = p.Estado }; fechaInicioTemp = p.FechaInicio; fechaFinTemp = p.FechaFin; }
        else { modelo = new PeriodoAcademicoDTO { Activo = false, Estado = "Abierto" }; fechaInicioTemp = DateTime.Today; fechaFinTemp = DateTime.Today.AddMonths(4); }
        mostrarDialogo = true;
    }

    private void AbrirModalBaja(PeriodoAcademicoDTO p) { modeloParaBaja = p; mostrarDialogoBaja = true; }

    private async Task TriggerSubmit()
    {
        if (fechaInicioTemp == null || fechaFinTemp == null) { Snackbar.Add("Fechas requeridas", Severity.Warning); return; }
        modelo.FechaInicio = fechaInicioTemp.Value; modelo.FechaFin = fechaFinTemp.Value;
        await Guardar();
    }

    private async Task Guardar()
    {
        bool exito = modelo.Id == 0 ? await PeriodoService.CreateAsync(modelo) : await PeriodoService.UpdateAsync(modelo);
        if (exito) { Snackbar.Add("Guardado correctamente", Severity.Success); mostrarDialogo = false; await CargarDatos(); }
        else Snackbar.Add("Error al guardar", Severity.Error);
    }

    private async Task ConfirmarBaja()
    {
        if (modeloParaBaja != null && await PeriodoService.DeleteAsync(modeloParaBaja.Id)) { Snackbar.Add("Eliminado", Severity.Success); await CargarDatos(); }
        else Snackbar.Add("Error al eliminar", Severity.Error);
        mostrarDialogoBaja = false;
    }

    private void CerrarModal() => mostrarDialogo = false;
    private void CerrarModales() => mostrarDialogoBaja = false;
}