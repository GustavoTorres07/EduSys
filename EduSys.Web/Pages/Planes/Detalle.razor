@code {
    [Parameter] public int PlanId { get; set; }

    private MudForm _formMateria = null!;
    private bool loading = true;
    private bool _procesando = false;

    private int indiceGlobalMaterias = 1;

    private PlanEstudioDTO plan = new PlanEstudioDTO { Nombre = "Cargando...", NombreCarrera = "" };
    private List<PlanMateriaDTO> materiasDelPlan = new();
    private List<MateriaDTO> catalogoMaterias = new();
    private List<RegimenDTO> listaRegimenes = new();
    private List<EstadoMateriaDTO> listaEstados = new();

    private PlanMateriaDTO materiaModel = new();
    private PlanMateriaDTO? materiaParaEliminar;
    private PlanMateriaDTO? materiaEnEdicion;

    private Dictionary<string, string> correlativasDict = new();
    private List<PlanMateriaDTO> materiasCandidatas = new();

    private bool mostrarModal = false;
    private bool mostrarModalCorrelativas = false;
    private bool mostrarDialogoEliminar = false;
    private bool esEdicion = false;

    private DialogOptions dialogOptions = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false, CloseButton = false, NoHeader = true };
    private DialogOptions dialogOptionsEliminar = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, BackdropClick = false, CloseButton = false };

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        loading = true;
        StateHasChanged();

        try
        {
            var t1 = PlanService.GetByIdAsync(PlanId);
            var t2 = PlanService.GetMateriasByPlanAsync(PlanId);
            var t3 = MateriaService.GetAllAsync();
            var t4 = RegimenService.GetAllAsync();
            var t5 = EstadoMateriaService.GetEstadosAsync();

            await Task.WhenAll(t1, t2, t3, t4, t5);

            var p = await t1;
            if (p != null) plan = p;

            materiasDelPlan = await t2 ?? new();
            catalogoMaterias = await t3 ?? new();
            listaRegimenes = await t4 ?? new();
            listaEstados = await t5 ?? new();
        }
        catch (Exception)
        {
            Snackbar.Add("Error al cargar los datos de la malla curricular.", Severity.Error);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private void AbrirModalCorrelativas(PlanMateriaDTO item)
    {
        materiaEnEdicion = item;
        materiasCandidatas = materiasDelPlan.Where(m => m.Id != item.Id && m.AnioCursada < item.AnioCursada).ToList();

        correlativasDict.Clear();

        if (item.CorrelativasDetalle != null)
        {
            foreach (var c in item.CorrelativasDetalle)
            {
                var partes = c.TipoRequisito.Split('-');
                if (partes.Length == 2)
                {
                    string momento = partes[0];
                    string condicion = partes[1];
                    correlativasDict[$"{c.IdPlanMateriaRequisito}_{momento}"] = condicion;
                }
            }
        }

        mostrarModalCorrelativas = true;
    }

    private bool TieneRequisito(int idMateria, string momento) => correlativasDict.ContainsKey($"{idMateria}_{momento}");

    private void ToggleRequisito(int idMateria, string momento, bool check)
    {
        var key = $"{idMateria}_{momento}";
        if (check)
            correlativasDict[key] = momento == "Cursar" ? "Regular" : "Aprobada";
        else
            correlativasDict.Remove(key);
    }

    private async Task GuardarCorrelativas()
    {
        if (materiaEnEdicion == null) return;

        _procesando = true;
        StateHasChanged();

        try
        {
            var listaCorrelativas = new List<CorrelativaItemDTO>();
            foreach (var kv in correlativasDict)
            {
                var partesKey = kv.Key.Split('_');
                int idRequisito = int.Parse(partesKey[0]);
                string momento = partesKey[1];
                string condicion = kv.Value;
                listaCorrelativas.Add(new CorrelativaItemDTO { IdPlanMateriaRequisito = idRequisito, TipoRequisito = $"{momento}-{condicion}" });
            }

            var exito = await PlanService.ActualizarCorrelativasAsync(materiaEnEdicion.Id, listaCorrelativas);

            if (exito)
            {
                Snackbar.Add("Reglas de correlatividad guardadas correctamente.", Severity.Success);
                mostrarModalCorrelativas = false;
                await CargarDatos();
            }
            else
            {
                Snackbar.Add("Error del servidor al intentar guardar las reglas.", Severity.Error);
            }
        }
        finally
        {
            _procesando = false;
            StateHasChanged();
        }
    }

    private void AbrirModalAgregar()
    {
        materiaModel = new PlanMateriaDTO
        {
            IdPlan = PlanId, AnioCursada = 1, Cuatrimestre = 0, NotaMinimaAprobacion = 6, CargaHorariaTotal = 64,
            EsPromocionable = true, PromedioMinimoAprobacion = 4, CantidadParciales = 2, CantidadAplazosParaLibre = 1,
            PorcentajeAsistenciaRegularizar = 60, EsLibre = false, TieneFinalObligatorio = false,
            ModoAprobacionCursada = 0, ModoNotaRecuperatorio = 0, TieneIntegrador = false
        };
        esEdicion = false;
        mostrarModal = true;
    }

    private void AbrirModalAgregarRapido(int anio) { AbrirModalAgregar(); materiaModel.AnioCursada = anio; }

    private void AbrirModalDetalle(PlanMateriaDTO item)
    {
        materiaModel = new PlanMateriaDTO
        {
            Id = item.Id, IdPlan = item.IdPlan, IdMateria = item.IdMateria, AnioCursada = item.AnioCursada,
            IdRegimen = item.IdRegimen, Cuatrimestre = item.Cuatrimestre, CargaHorariaTotal = item.CargaHorariaTotal,
            NotaMinimaAprobacion = item.NotaMinimaAprobacion, EsPromocionable = item.EsPromocionable,
            Objetivos = item.Objetivos, ContenidosMinimos = item.ContenidosMinimos, TieneProyecto = item.TieneProyecto,
            DescripcionProyecto = item.DescripcionProyecto, CondicionesCursada = item.CondicionesCursada,
            CondicionesAprobacion = item.CondicionesAprobacion, TipoCalificacion = item.TipoCalificacion,
            ModoAprobacionCursada = item.ModoAprobacionCursada, NotaEliminatoria = item.NotaEliminatoria,
            PromedioMinimoAprobacion = item.PromedioMinimoAprobacion ?? item.NotaMinimaRegularizar,
            CantidadAplazosParaLibre = item.CantidadAplazosParaLibre, NotaMinimaRegularizar = item.NotaMinimaRegularizar,
            NotaMinimaPromocion = item.NotaMinimaPromocion, PorcentajeAsistenciaRegularizar = item.PorcentajeAsistenciaRegularizar,
            PorcentajeAsistenciaPromocion = item.PorcentajeAsistenciaPromocion, VigenciaCursadaAnios = item.VigenciaCursadaAnios,
            CantidadParciales = item.CantidadParciales, EsLibre = item.EsLibre, TieneFinalObligatorio = item.TieneFinalObligatorio,
            ModoNotaRecuperatorio = item.ModoNotaRecuperatorio, TieneIntegrador = item.TieneIntegrador,
            CondicionIntegradorParciales = item.CondicionIntegradorParciales, NotaAprobacionIntegrador = item.NotaAprobacionIntegrador,
            IntegradorPermitePromocion = item.IntegradorPermitePromocion, NotaPromocionIntegrador = item.NotaPromocionIntegrador,
            IdEstadoPromocion = item.IdEstadoPromocion, IdEstadoRegular = item.IdEstadoRegular,
            IdEstadoSiDesaprueba = item.IdEstadoSiDesaprueba, IdEstadoSiFaltaAsistencia = item.IdEstadoSiFaltaAsistencia
        };
        esEdicion = true;
        mostrarModal = true;
    }

    private async Task GuardarMateria()
    {
        await _formMateria.Validate();
        if (!_formMateria.IsValid) return;

        if (materiaModel.IdMateria == 0) { Snackbar.Add("Debe seleccionar una asignatura del catálogo central.", Severity.Warning); return; }
        if (materiaModel.IdRegimen == null) { Snackbar.Add("Debe definir el Régimen de cursada.", Severity.Warning); return; }

        _procesando = true;
        StateHasChanged();

        try
        {
            bool exito = esEdicion
                ? await PlanService.EditarMateriaAsync(materiaModel)
                : await PlanService.AgregarMateriaAsync(materiaModel);

            if (exito) { Snackbar.Add("Configuración de asignatura guardada exitosamente.", Severity.Success); mostrarModal = false; await CargarDatos(); }
            else { Snackbar.Add("Ocurrió un error al intentar guardar. Verifique los datos.", Severity.Error); }
        }
        catch (Exception) { Snackbar.Add("Error crítico de comunicación con el servidor.", Severity.Error); }
        finally { _procesando = false; StateHasChanged(); }
    }

    private void AbrirModalEliminar(PlanMateriaDTO item) { materiaParaEliminar = item; mostrarDialogoEliminar = true; }

    private async Task ConfirmarEliminar()
    {
        if (materiaParaEliminar == null) return;
        _procesando = true;
        StateHasChanged();

        try
        {
            if (await PlanService.QuitarMateriaAsync(materiaParaEliminar.Id))
            { Snackbar.Add("Asignatura desvinculada del plan.", Severity.Success); await CargarDatos(); }
            else
            { Snackbar.Add("No se pudo eliminar. Compruebe que no esté atada a comisiones activas.", Severity.Error); }
        }
        catch (Exception) { Snackbar.Add("Ocurrió un error al intentar eliminar.", Severity.Error); }
        finally { _procesando = false; mostrarDialogoEliminar = false; StateHasChanged(); }
    }

    private void CerrarModales()
    {
        if (!_procesando) { mostrarModal = false; mostrarDialogoEliminar = false; mostrarModalCorrelativas = false; }
    }

    private int ObtenerNumeroCodigo(string? codigo)
    {
        if (string.IsNullOrEmpty(codigo)) return 999;
        if (codigo.Contains("-") && codigo.Split('-').Length > 1 && int.TryParse(codigo.Split('-')[1], out int num)) return num;
        if (int.TryParse(codigo, out int n)) return n;
        return 999;
    }

    private int ObtenerMaximoAnio() => materiasDelPlan.Any() ? materiasDelPlan.Max(m => m.AnioCursada) : 0;

    private string ObtenerNombreAnio(int anio, bool corto = false) => anio switch
    {
        1 => corto ? "1º Año" : "PRIMER AÑO",
        2 => corto ? "2º Año" : "SEGUNDO AÑO",
        3 => corto ? "3º Año" : "TERCER AÑO",
        4 => corto ? "4º Año" : "CUARTO AÑO",
        5 => corto ? "5º Año" : "QUINTO AÑO",
        6 => corto ? "6º Año" : "SEXTO AÑO",
        _ => $"{anio}º AÑO"
    };
}
