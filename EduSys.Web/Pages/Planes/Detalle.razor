@* --- MODAL 2: CORRELATIVAS --- *@
<MudDialog @bind-Visible="mostrarModalCorrelativas" Options="dialogOptions" Class="unified-dialog-card pa-0">
    <DialogContent>
        <div class="dialog-header-integrated">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.Link" Class="mr-3" />
                <div>
                    <MudText Typo="Typo.h6" Style="font-weight: 700; letter-spacing: -0.5px;">Reglas de Correlatividad</MudText>
                    <MudText Typo="Typo.caption" Style="opacity: 0.9;">Requisitos para cursar y rendir <b>@materiaEnEdicion?.NombreMateria</b></MudText>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="CerrarModales" Size="Size.Small" Disabled="_procesando" />
        </div>

        <div class="dialog-body" style="background-color: #f8fafc;">
            @if (materiasCandidatas != null && materiasCandidatas.Any())
            {
                <div class="pa-4 mb-4 rounded-lg" style="background-color: #f0f9ff; border-left: 4px solid #0284c7;">
                    <MudText Typo="Typo.body2" Style="color: #0369a1; font-weight: 600; line-height: 1.5;">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                        Selecciona qué nivel de aprobación se exige de las materias previas:<br />
                        • <span style="font-weight: 800;">[Aprobar Cursada]:</span> Requiere tener la cursada previa regularizada o aprobada.<br />
                        • <span style="font-weight: 800;">[Aprobar Materia]:</span> Requiere tener el examen final de la previa aprobado o promocionado.
                    </MudText>
                </div>

                @foreach (var grupo in materiasCandidatas.GroupBy(m => m.AnioCursada).OrderBy(g => g.Key))
                {
                    <div class="correlativas-list-year">Asignaturas de @ObtenerNombreAnio(grupo.Key, true)</div>
                    <MudGrid Spacing="2">
                        @foreach (var mat in grupo.OrderBy(m => m.CodigoMateria))
                        {
                            bool reqCursar = TieneRequisito(mat.Id, "Cursar");
                            bool reqRendir = TieneRequisito(mat.Id, "Rendir");
                            bool isSelected = reqCursar || reqRendir;

                            <MudItem xs="12">
                                <div class="pa-3 transition-all"
                                     style="@(isSelected ? "background-color: #f0fdf4; border: 1px solid #bbf7d0; border-left: 4px solid #16a34a; border-radius: 8px;" : "background-color: white; border: 1px solid #cbd5e1; border-left: 4px solid transparent; border-radius: 8px;")">

                                    <MudText Typo="Typo.body1" Style="@(isSelected ? "font-weight: 800; color: #166534; margin-bottom: 4px;" : "font-weight: 700; color: #334155; margin-bottom: 4px;")">
                                        @mat.CodigoMateria - @mat.NombreMateria
                                    </MudText>

                                    <div class="d-flex gap-4 ml-2 flex-wrap">
                                        <MudCheckBox T="bool" Value="@reqCursar" ValueChanged="@((bool v) => ToggleRequisito(mat.Id, "Cursar", v))"
                                                     Label="Exigir Aprobar Cursada" Color="Color.Info" Dense="true" Size="Size.Small" Disabled="_procesando" />
                                        <MudCheckBox T="bool" Value="@reqRendir" ValueChanged="@((bool v) => ToggleRequisito(mat.Id, "Rendir", v))"
                                                     Label="Exigir Aprobar Materia" Color="Color.Warning" Dense="true" Size="Size.Small" Disabled="_procesando" />
                                    </div>
                                </div>
                            </MudItem>
                        }
                    </MudGrid>
                }
            }
            else
            {
                <div class="d-flex justify-center pa-8" style="color:#94A3B8;">No existen asignaturas de años anteriores para enlazar.</div>
            }
        </div>

        <div class="actions-footer">
            <MudButton OnClick="CerrarModales" Variant="Variant.Outlined" Color="Color.Default" Class="rounded-lg font-weight-bold" Disabled="_procesando">Cancelar</MudButton>
            <MudButton OnClick="GuardarCorrelativas" Variant="Variant.Filled" Color="Color.Primary" Class="rounded-lg font-weight-bold px-6" Disabled="_procesando">
                @(_procesando ? "Guardando..." : "Guardar Reglas")
            </MudButton>
        </div>
    </DialogContent>
</MudDialog>

@* --- MODAL 3: ELIMINAR --- *@
<MudDialog @bind-Visible="mostrarDialogoEliminar" Options="dialogOptionsEliminar" Class="unified-dialog-card pb-2">
    <DialogContent>
        <div class="pa-4 d-flex flex-column align-center text-center">
            <div style="background-color: #fffbeb; padding: 16px; border-radius: 50%; margin-bottom: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Style="font-size: 3rem;" />
            </div>
            <MudText Typo="Typo.h5" Style="font-weight: 800; color: #d97706; letter-spacing: -0.5px;" Class="mb-2">Quitar Asignatura</MudText>
            <MudText Typo="Typo.body1" Style="color: #334155; font-weight: 600;" Class="mb-2">
                Se desvinculará <b>@materiaParaEliminar?.NombreMateria</b> del diseño curricular actual.
            </MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="px-4 pb-4 d-flex justify-center gap-3 w-100">
