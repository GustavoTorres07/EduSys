@page "/cambiar-clave"
@layout Layout.EmptyLayout

@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization

@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<style>
    body, html {
        margin: 0;
        padding: 0;
        height: 100%;
        background-color: #f8fafc !important;
    }

    :root {
        --color-steel-blue: #456990;
        --color-mustard: #EEB868;
        --color-text-dark: #1e293b;
        --color-text-muted: #64748b;
    }

    .change-pass-wrapper {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
    }

    .card-container {
        width: 100%;
        max-width: 450px;
        background: white;
        padding: 3rem 2.5rem;
        border-radius: 24px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* --- INPUTS CORPORATIVOS --- */
    .custom-input {
        margin-bottom: 1.25rem;
    }

    /* 🚀 FIX: Forzar que el texto escrito dentro del input sea oscuro SIEMPRE */
    .custom-input .mud-input-slot {
        color: var(--color-text-dark) !important;
        font-weight: 600 !important;
        -webkit-text-fill-color: var(--color-text-dark) !important;
    }

    .custom-input .mud-input-label {
        color: var(--color-text-muted) !important;
        font-weight: 600;
    }

    .custom-input .mud-input-outlined-border {
        border-color: #e2e8f0 !important;
        transition: border-color 0.2s;
    }

    .custom-input:hover .mud-input-outlined-border {
        border-color: var(--color-steel-blue) !important;
    }

    /* Evitar que el autofill del navegador cambie el color del texto a blanco */
    .custom-input input:-webkit-autofill,
    .custom-input input:-webkit-autofill:hover, 
    .custom-input input:-webkit-autofill:focus, 
    .custom-input input:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 30px white inset !important;
        -webkit-text-fill-color: var(--color-text-dark) !important;
    }

    /* --- BOTÓN PREMIUM --- */
    .btn-submit {
        height: 52px;
        background-color: var(--color-steel-blue) !important;
        color: white !important;
        font-weight: 800;
        letter-spacing: 0.5px;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(69, 105, 144, 0.2);
        transition: all 0.2s;
    }

    .btn-submit:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(69, 105, 144, 0.3);
        background-color: #355270 !important;
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="change-pass-wrapper pa-4">
    <div class="card-container">

        @* --- HEADER --- *@
        <div class="d-flex flex-column align-center mb-8">
            <div style="background-color: #fff7ed; padding: 1.25rem; border-radius: 20px; margin-bottom: 1.5rem;">
                <MudIcon Icon="@Icons.Material.Filled.LockReset" Style="color: var(--color-mustard); font-size: 3.5rem;" />
            </div>
            <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: 900; color: #1e3a58;">Seguridad Obligatoria</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Style="color: #64748b; line-height: 1.6;" Class="mt-2">
                Detectamos que estás usando una clave temporal. <br /><b>Crea una nueva contraseña</b> para proteger tu cuenta.
            </MudText>
        </div>

        @* --- FORMULARIO --- *@
        <EditForm Model="@modelo" OnValidSubmit="ActualizarClave">
            <DataAnnotationsValidator />

            @* NUEVA CLAVE *@
            <div class="custom-input">
                <MudTextField @bind-Value="modelo.NuevaClave"
                              Label="Nueva Contraseña"
                              Variant="Variant.Outlined"
                              InputType="@PasswordInput1"
                              Adornment="Adornment.End"
                              AdornmentIcon="@PasswordInputIcon1"
                              OnAdornmentClick="TogglePasswordVisibility1"
                              Disabled="procesando"
                              Placeholder="Mínimo 6 caracteres"
                              Required="true" />
            </div>

            @* CONFIRMACIÓN *@
            <div class="custom-input">
                <MudTextField @bind-Value="confirmacion"
                              Label="Repetir Contraseña"
                              Variant="Variant.Outlined"
                              InputType="@PasswordInput2"
                              Adornment="Adornment.End"
                              AdornmentIcon="@PasswordInputIcon2"
                              OnAdornmentClick="TogglePasswordVisibility2"
                              Disabled="procesando"
                              Required="true" />
            </div>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Class="btn-submit mt-4"
                       Disabled="procesando">
                @if (procesando)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Surface" />
                    <span class="ml-2">GUARDANDO...</span>
                }
                else
                {
                    <span>ESTABLECER NUEVA CLAVE</span>
                }
            </MudButton>
        </EditForm>

        <div class="mt-8 d-flex justify-center align-center gap-2" style="opacity: 0.6;">
            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" />
            <MudText Typo="Typo.caption" Style="font-weight: 700;">EduSys Secure Portal</MudText>
        </div>

    </div>
</div>

@code {
    private CambioClaveDTO modelo = new();
    private string confirmacion = "";
    private bool procesando = false;

    // Control visibilidad clave 1
    bool isShow1;
    InputType PasswordInput1 = InputType.Password;
    string PasswordInputIcon1 = Icons.Material.Filled.VisibilityOff;

    void TogglePasswordVisibility1()
    {
        isShow1 = !isShow1;
        PasswordInput1 = isShow1 ? InputType.Text : InputType.Password;
        PasswordInputIcon1 = isShow1 ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    // Control visibilidad clave 2
    bool isShow2;
    InputType PasswordInput2 = InputType.Password;
    string PasswordInputIcon2 = Icons.Material.Filled.VisibilityOff;

    void TogglePasswordVisibility2()
    {
        isShow2 = !isShow2;
        PasswordInput2 = isShow2 ? InputType.Text : InputType.Password;
        PasswordInputIcon2 = isShow2 ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private async Task ActualizarClave()
    {
        // Validaciones preventivas
        if (string.IsNullOrWhiteSpace(modelo.NuevaClave)) return;

        if (modelo.NuevaClave.Length < 6)
        {
            Snackbar.Add("La contraseña es muy corta. Usa al menos 6 caracteres.", Severity.Warning);
            return;
        }

        if (modelo.NuevaClave != confirmacion)
        {
            Snackbar.Add("Las contraseñas ingresadas no coinciden.", Severity.Error);
            return;
        }

        procesando = true;

        try
        {
            // Enviamos al servidor
            var exito = await AuthService.CambiarClaveAsync(modelo.NuevaClave);

            if (exito)
            {
                Snackbar.Add("¡Excelente! Tu contraseña ha sido actualizada.", Severity.Success);
                
                // Pequeña pausa para que el usuario lea el mensaje de éxito
                await Task.Delay(1200);
                
                // Navegamos al Dashboard y forzamos refresco para limpiar estados de 'debeCambiarClave'
                Navigation.NavigateTo("/dashboard-alumno", true);
            }
            else
            {
                Snackbar.Add("El servidor no pudo procesar el cambio. Intenta más tarde.", Severity.Error);
                procesando = false;
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Error de comunicación. Revisa tu conexión a internet.", Severity.Error);
            procesando = false;
        }
    }
}