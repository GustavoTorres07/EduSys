@page "/alumno/mis-cursadas"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Alumno")]

@inject IAlumnoPortalService AlumnoPortalService

<style>
    /* ============================================
           SISTEMA DE DISEÑO EDUSYS - PALETA INSTITUCIONAL
           ============================================ */
    :root {
        --edusys-primary: #1e3a58;
        --edusys-primary-light: #2c5282;
        --edusys-primary-dark: #152a40;
        --edusys-accent: #0288d1;
        --edusys-success: #2e7d32;
        --edusys-warning: #f57c00;
        --edusys-neutral: #546e7a;
        --edusys-surface: #ffffff;
        --edusys-background: #f8fafc;
        --edusys-border: #e2e8f0;
        --edusys-text-primary: #1a202c;
        --edusys-text-secondary: #64748b;
        --edusys-shadow-sm: 0 1px 3px rgba(30, 58, 88, 0.08);
        --edusys-shadow-md: 0 4px 12px rgba(30, 58, 88, 0.12);
        --edusys-shadow-lg: 0 8px 24px rgba(30, 58, 88, 0.16);
    }

    /* ============================================
           COMPONENTES PRINCIPALES
           ============================================ */

    /* Header Section */
    .page-header {
        background: linear-gradient(135deg, var(--edusys-primary) 0%, var(--edusys-primary-light) 100%);
        padding: 2.5rem 1.5rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: var(--edusys-shadow-md);
        position: relative;
        overflow: hidden;
    }

        .page-header::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            border-radius: 50%;
            transform: translate(30%, -30%);
        }

    .page-header-content {
        position: relative;
        z-index: 1;
    }

    .page-title {
        color: white;
        font-weight: 800;
        font-size: 2rem;
        letter-spacing: -0.5px;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: rgba(255, 255, 255, 0.9);
        font-size: 1rem;
        font-weight: 400;
    }

    /* Filtro de Ciclo Lectivo */
    .filter-section {
        background: white;
        padding: 1.5rem;
        border-radius: 10px;
        box-shadow: var(--edusys-shadow-sm);
        margin-bottom: 2rem;
        border: 1px solid var(--edusys-border);
    }

    .institutional-select {
        min-width: 280px;
    }

        .institutional-select .mud-input-outlined-border {
            border-color: var(--edusys-primary) !important;
            border-width: 2px !important;
            transition: all 0.3s ease;
        }

        .institutional-select:hover .mud-input-outlined-border {
            border-color: var(--edusys-primary-light) !important;
            box-shadow: 0 0 0 3px rgba(30, 58, 88, 0.1);
        }

        .institutional-select .mud-input-label {
            color: var(--edusys-primary) !important;
            font-weight: 600;
        }

        .institutional-select .mud-select-input {
            color: var(--edusys-text-primary) !important;
            font-weight: 600;
        }

        .institutional-select .mud-icon-root {
            color: var(--edusys-primary) !important;
        }

    /* ============================================
           TARJETAS DE CURSADA
           ============================================ */
    .cursada-card {
        background: white;
        border-radius: 12px;
        border: 1px solid var(--edusys-border);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: var(--edusys-shadow-sm);
    }

        .cursada-card:hover {
            border-color: var(--edusys-primary);
            box-shadow: var(--edusys-shadow-lg);
            transform: translateY(-4px);
        }

    /* Header de Tarjeta */
    .card-header-modern {
        background: linear-gradient(135deg, var(--edusys-background) 0%, white 100%);
        padding: 1.5rem;
        border-bottom: 2px solid var(--edusys-border);
        position: relative;
    }

    .materia-nombre {
        color: var(--edusys-primary);
        font-weight: 800;
        font-size: 1.1rem;
        line-height: 1.3;
        margin-bottom: 0.75rem;
        letter-spacing: -0.3px;
    }

    .comision-info {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: white;
        padding: 0.4rem 0.75rem;
        border-radius: 6px;
        border: 1px solid var(--edusys-border);
    }

    .comision-text {
        color: var(--edusys-neutral);
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.3px;
    }

    /* Badge de Estado */
    .estado-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        box-shadow: var(--edusys-shadow-sm);
        transition: all 0.2s ease;
    }

        .estado-badge:hover {
            transform: scale(1.05);
        }

    .badge-regular {
        background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
        color: var(--edusys-success);
        border: 1px solid var(--edusys-success);
    }

    .badge-promocionado {
        background: linear-gradient(135deg, #e0f2f1 0%, #b2dfdb 100%);
        color: #00897b;
        border: 1px solid #00897b;
    }

    .badge-libre {
        background: linear-gradient(135deg, #eceff1 0%, #cfd8dc 100%);
        color: #546e7a;
        border: 1px solid #546e7a;
    }

    .badge-cursando {
        background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
        color: var(--edusys-accent);
        border: 1px solid var(--edusys-accent);
    }

    .status-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .indicator-success {
        background: var(--edusys-success);
    }

    .indicator-info {
        background: var(--edusys-accent);
    }

    .indicator-neutral {
        background: var(--edusys-neutral);
    }

    /* ============================================
           SECCIÓN DE EXÁMENES
           ============================================ */
    .examenes-container {
        flex: 1;
        padding: 0;
        background: white;
    }

    .examen-item {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--edusys-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        transition: background-color 0.2s ease;
    }

        .examen-item:hover {
            background-color: var(--edusys-background);
        }

        .examen-item:last-child {
            border-bottom: none;
        }

    .examen-info {
        flex: 1;
        min-width: 0;
    }

    .examen-nombre {
        color: var(--edusys-text-primary);
        font-weight: 700;
        font-size: 0.95rem;
        margin-bottom: 0.25rem;
        line-height: 1.4;
    }

    .examen-fecha {
        color: var(--edusys-text-secondary);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .examen-nota-container {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    /* Nota Numérica */
    .nota-valor {
        font-family: 'Segoe UI', 'Inter', sans-serif;
        font-weight: 900;
        font-size: 1.5rem;
        color: var(--edusys-text-primary);
        min-width: 60px;
        text-align: right;
        letter-spacing: -0.5px;
    }

    .nota-pendiente {
        color: var(--edusys-text-secondary);
        font-weight: 500;
        font-size: 1.2rem;
    }

    /* Icono de Estado de Nota */
    .nota-status-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .icon-oficial {
        background: linear-gradient(135deg, var(--edusys-primary) 0%, var(--edusys-primary-light) 100%);
        color: white;
        box-shadow: var(--edusys-shadow-sm);
    }

    .icon-provisoria {
        background: var(--edusys-background);
        color: var(--edusys-neutral);
        border: 2px solid var(--edusys-border);
    }

    .nota-status-icon:hover {
        transform: scale(1.1);
    }

    /* Estado Vacío */
    .examenes-empty {
        padding: 3rem 1.5rem;
        text-align: center;
        color: var(--edusys-text-secondary);
    }

    .empty-icon {
        font-size: 3rem !important;
        color: var(--edusys-border);
        margin-bottom: 1rem;
        opacity: 0.6;
    }

    /* ============================================
           FOOTER DE PROMEDIO
           ============================================ */
    .card-footer-promedio {
        background: linear-gradient(to right, var(--edusys-background), white);
        border-top: 2px solid var(--edusys-border);
        padding: 1.25rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .promedio-label {
        color: var(--edusys-neutral);
        font-weight: 800;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .promedio-valor {
        font-family: 'Segoe UI', 'Inter', sans-serif;
        font-weight: 900;
        font-size: 1.8rem;
        color: var(--edusys-primary);
        letter-spacing: -1px;
    }

    .promedio-pendiente {
        color: var(--edusys-text-secondary);
        font-weight: 500;
        font-size: 1.4rem;
    }

    /* ============================================
           ESTADOS ESPECIALES
           ============================================ */

    /* Loading */
    .loading-container {
        min-height: 400px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
    }

    .loading-text {
        color: var(--edusys-text-secondary);
        font-weight: 600;
    }

    /* Empty State */
    .empty-state {
        background: white;
        border: 2px dashed var(--edusys-border);
        border-radius: 12px;
        padding: 4rem 2rem;
        text-align: center;
    }

    .empty-state-icon {
        font-size: 5rem !important;
        color: var(--edusys-border);
        margin-bottom: 1.5rem;
        opacity: 0.5;
    }

    .empty-state-title {
        color: var(--edusys-text-primary);
        font-weight: 700;
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
    }

    .empty-state-subtitle {
        color: var(--edusys-text-secondary);
        font-size: 1rem;
    }

    /* ============================================
           RESPONSIVE
           ============================================ */
    @@media (max-width: 960px) {
        .page-header {
            padding: 2rem 1.25rem;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .institutional-select {
            min-width: 100%;
        }

        .filter-section {
            padding: 1rem;
        }

        .examen-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.75rem;
        }

        .examen-nota-container {
            width: 100%;
            justify-content: space-between;
        }

        .nota-valor {
            font-size: 1.3rem;
        }
    }

    @@media (max-width: 600px) {
        .page-header {
            padding: 1.5rem 1rem;
        }

        .card-header-modern {
            padding: 1rem;
        }

        .examen-item {
            padding: 1rem;
        }

        .card-footer-promedio {
            padding: 1rem;
        }
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-12">

    <!-- HEADER -->
    <div class="page-header">
        <div class="page-header-content">
            <div class="d-flex align-center gap-3 mb-2">
                <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Large" Style="color: white; font-size: 2.5rem;" />
                <div>
                    <MudText Class="page-title">
                        Situación Académica
                    </MudText>
                    <MudText Class="page-subtitle">
                        Seguimiento detallado de tu rendimiento y calificaciones
                    </MudText>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTRO DE CICLO LECTIVO -->
    <div class="filter-section">
        <div class="d-flex flex-wrap align-center justify-space-between gap-4">
            <div>
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: var(--edusys-text-primary); margin-bottom: 0.25rem;">
                    Filtrar por Período
                </MudText>
                <MudText Typo="Typo.body2" Style="color: var(--edusys-text-secondary);">
                    Selecciona el ciclo lectivo para visualizar
                </MudText>
            </div>

            <MudSelect T="int"
                       Label="Ciclo Lectivo"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       AnchorOrigin="Origin.BottomCenter"
                       TransformOrigin="Origin.TopCenter"
                       @bind-Value="cicloSeleccionado"
                       SelectedValuesChanged="FiltrarCursadas"
                       Class="institutional-select"
                       AdornmentIcon="@Icons.Material.Filled.CalendarMonth">
                @foreach (var anio in ciclosDisponibles)
                {
                    <MudSelectItem Value="@anio">Ciclo Lectivo @anio</MudSelectItem>
                }
            </MudSelect>
        </div>
    </div>

    <!-- CONTENIDO -->
    @if (cargando)
    {
        <div class="loading-container">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" Style="width: 80px; height: 80px;" />
            <MudText Class="loading-text">Cargando información académica...</MudText>
        </div>
    }
    else if (!cursadasFiltradas.Any())
    {
        <div class="empty-state">
            <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Class="empty-state-icon" />
            <MudText Class="empty-state-title">No hay cursadas registradas</MudText>
            <MudText Class="empty-state-subtitle">
                No se encontraron cursadas activas para el ciclo lectivo @cicloSeleccionado
            </MudText>
        </div>
    }
    else
    {
        <MudGrid Spacing="4">
            @foreach (var cursada in cursadasFiltradas)
            {
                <MudItem xs="12" md="6" lg="4">
                    <MudCard Elevation="0" Class="cursada-card">

                        <!-- HEADER -->
                        <div class="card-header-modern">
                            <div class="d-flex justify-space-between align-start mb-3">
                                <div style="flex: 1; padding-right: 1rem;">
                                    <MudText Class="materia-nombre">
                                        @cursada.Materia.ToUpper()
                                    </MudText>
                                </div>

                                <div class="@ObtenerClaseBadge(cursada.EstadoCursada)">
                                    <span class="status-indicator @ObtenerClaseIndicador(cursada.EstadoCursada)"></span>
                                    <span>@cursada.EstadoCursada</span>
                                </div>
                            </div>

                            <div class="comision-info">
                                <MudIcon Icon="@Icons.Material.Filled.Class" Size="Size.Small" Style="font-size: 1rem; color: var(--edusys-neutral);" />
                                <span class="comision-text">COMISIÓN @cursada.Comision</span>
                            </div>
                        </div>

                        <!-- EXÁMENES -->
                        <MudCardContent Class="pa-0 examenes-container">
                            @if (cursada.Examenes.Any())
                            {
                                @foreach (var examen in cursada.Examenes)
                                {
                                    <div class="examen-item">
                                        <div class="examen-info">
                                            <div class="examen-nombre">
                                                @examen.Nombre
                                            </div>
                                            <div class="examen-fecha">
                                                <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Style="font-size: 0.9rem;" />
                                                <span>@examen.Fecha.ToString("dd/MM/yyyy")</span>
                                            </div>
                                        </div>

                                        <div class="examen-nota-container">
                                            @if (examen.Nota.HasValue)
                                            {
                                                <span class="nota-valor">
                                                    @examen.Nota.Value.ToString("0.00")
                                                </span>

                                                @if (examen.EsOficial)
                                                {
                                                    <MudTooltip Text="Calificación Oficial - Acta Cerrada" Placement="Placement.Top">
                                                        <div class="nota-status-icon icon-oficial">
                                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="font-size: 1rem;" />
                                                        </div>
                                                    </MudTooltip>
                                                }
                                                else
                                                {
                                                    <MudTooltip Text="Calificación Provisoria" Placement="Placement.Top">
                                                        <div class="nota-status-icon icon-provisoria">
                                                            <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Style="font-size: 1rem;" />
                                                        </div>
                                                    </MudTooltip>
                                                }
                                            }
                                            else
                                            {
                                                <span class="nota-valor nota-pendiente">--</span>
                                                <div class="nota-status-icon icon-provisoria">
                                                    <MudIcon Icon="@Icons.Material.Outlined.HourglassEmpty" Size="Size.Small" Style="font-size: 1rem;" />
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="examenes-empty">
                                    <MudIcon Icon="@Icons.Material.Outlined.Assignment" Class="empty-icon" />
                                    <MudText Typo="Typo.body2" Style="color: var(--edusys-text-secondary);">
                                        Sin evaluaciones registradas
                                    </MudText>
                                </div>
                            }
                        </MudCardContent>

                        <!-- FOOTER PROMEDIO -->
                        <div class="card-footer-promedio">
                            <span class="promedio-label">Promedio</span>

                            @if (cursada.Promedio.HasValue)
                            {
                                <span class="promedio-valor">
                                    @cursada.Promedio.Value.ToString("0.00")
                                </span>
                            }
                            else
                            {
                                <span class="promedio-valor promedio-pendiente">-</span>
                            }
                        </div>

                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<CursadaAlumnoDTO> todasLasCursadas = new();
    private List<CursadaAlumnoDTO> cursadasFiltradas = new();
    private List<int> ciclosDisponibles = new();
    private int cicloSeleccionado;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            todasLasCursadas = await AlumnoPortalService.GetMisCursadasAsync() ?? new List<CursadaAlumnoDTO>();

            if (todasLasCursadas.Any())
            {
                ciclosDisponibles = todasLasCursadas
                    .SelectMany(c => c.Examenes)
                    .Select(e => e.Fecha.Year)
                    .DefaultIfEmpty(DateTime.Now.Year)
                    .Distinct()
                    .OrderByDescending(x => x)
                    .ToList();

                if (!ciclosDisponibles.Contains(DateTime.Now.Year))
                {
                    ciclosDisponibles.Insert(0, DateTime.Now.Year);
                }

                cicloSeleccionado = ciclosDisponibles.First();
                FiltrarCursadas();
            }
            else
            {
                ciclosDisponibles.Add(DateTime.Now.Year);
                cicloSeleccionado = DateTime.Now.Year;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private void FiltrarCursadas()
    {
        if (!todasLasCursadas.Any()) return;

        cursadasFiltradas = todasLasCursadas
            .Where(c => c.Examenes.Any(e => e.Fecha.Year == cicloSeleccionado) || !c.Examenes.Any())
            .ToList();
    }

    private string ObtenerClaseBadge(string estado) => estado switch
    {
        "Regular" => "estado-badge badge-regular",
        "Promocionado" => "estado-badge badge-promocionado",
        "Libre" => "estado-badge badge-libre",
        _ => "estado-badge badge-cursando"
    };

    private string ObtenerClaseIndicador(string estado) => estado switch
    {
        "Regular" => "indicator-success",
        "Promocionado" => "indicator-success",
        "Libre" => "indicator-neutral",
        _ => "indicator-info"
    };
}
