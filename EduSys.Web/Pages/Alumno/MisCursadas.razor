@page "/alumno/mis-cursadas"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Alumno")]

@inject IAlumnoPortalService AlumnoPortalService
@inject ISnackbar Snackbar

<style>
    :root {
        --edusys-primary: #1e3a58;
        --edusys-primary-light: #2c5282;
        --edusys-accent: #0288d1;
        --edusys-success: #2e7d32;
        --edusys-warning: #f57c00;
        --edusys-danger: #d32f2f;
        --edusys-background: #f8fafc;
        --edusys-border: #e2e8f0;
        --edusys-shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
        --edusys-shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    /* ✅ SELECT: texto visible */
    .custom-select-fix .mud-select-input,
    .custom-select-fix input {
        color: #1e293b !important;
        font-weight: 700 !important;
        -webkit-text-fill-color: #1e293b !important;
    }

    .custom-select-fix .mud-input-adornment .mud-icon-root,
    .custom-select-fix .mud-select-icon {
        color: var(--edusys-primary) !important;
        opacity: 1 !important;
    }

    /* ✅ SELECT: borde azul permanente */
    .custom-select-fix .mud-input-outlined-border {
        border-color: var(--edusys-primary) !important;
        border-width: 2px !important;
        border-radius: 10px !important;
    }

    /* ✅ SELECT: hover con glow suave */
    .custom-select-fix:hover .mud-input-outlined-border {
        border-color: var(--edusys-accent) !important;
        box-shadow: 0 0 0 3px rgba(2, 136, 209, 0.12) !important;
    }

    /* ✅ SELECT: foco con halo */
    .custom-select-fix.mud-input-focused .mud-input-outlined-border,
    .custom-select-fix .mud-focused .mud-input-outlined-border {
        border-color: var(--edusys-accent) !important;
        box-shadow: 0 0 0 4px rgba(2, 136, 209, 0.2) !important;
    }

    /* ✅ SELECT: label azul siempre */
    .custom-select-fix .mud-input-label,
    .custom-select-fix .mud-input-label-inputcontrol {
        color: var(--edusys-primary) !important;
        font-weight: 700 !important;
    }

    /* Animación de entrada para las tarjetas */
    .animate-card {
        animation: slideUp 0.4s ease-out forwards;
        opacity: 0;
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* Colores dinámicos para notas */
    .nota-aprobada   { color: var(--edusys-success) !important; font-weight: 800; }
    .nota-desaprobada{ color: var(--edusys-danger)  !important; font-weight: 800; }
    .nota-promocion  { color: #00897b               !important; font-weight: 800; }

    /* Tarjetas */
    .cursada-card {
        background: white;
        border-radius: 12px;
        border: 1px solid var(--edusys-border);
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: var(--edusys-shadow-sm);
    }
    .cursada-card:hover {
        transform: translateY(-5px);
        border-color: var(--edusys-primary);
        box-shadow: var(--edusys-shadow-lg);
    }

    .card-header-modern {
        background: linear-gradient(135deg, #f8fafc 0%, white 100%);
        padding: 1.5rem;
        border-bottom: 2px solid #f1f5f9;
    }
    .materia-nombre {
        color: var(--edusys-primary);
        font-weight: 800;
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
    }

    /* Badges de estado */
    .estado-badge    { padding: 4px 12px; border-radius: 20px; font-weight: 700; font-size: 0.7rem; text-transform: uppercase; }
    .badge-regular   { background: #e8f5e9; color: #2e7d32; }
    .badge-promocion { background: #e0f2f1; color: #00695c; }
    .badge-libre     { background: #ffebee; color: #c62828; }
    .badge-cursando  { background: #e3f2fd; color: #1565c0; }

    /* Nota */
    .nota-valor {
        font-size: 1.25rem;
        font-weight: 900;
        background: #f1f5f9;
        padding: 2px 10px;
        border-radius: 8px;
        min-width: 45px;
        text-align: center;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-12">

    @* --- HEADER --- *@
    <div style="background: linear-gradient(135deg, var(--edusys-primary) 0%, var(--edusys-primary-light) 100%);
                padding: 2.5rem; border-radius: 16px; color: white;
                margin-bottom: 2rem; box-shadow: 0 10px 25px rgba(30,58,88,0.15);">
        <div class="d-flex align-center gap-4">
            <MudIcon Icon="@Icons.Material.Filled.AutoStories" Style="font-size: 3rem;" />
            <div>
                <MudText Typo="Typo.h3" Style="font-weight: 800; letter-spacing: -1px;">Mis Cursadas</MudText>
                <MudText Style="opacity: 0.8; font-size: 1.1rem;">Seguimiento en tiempo real de tus notas y regularidad.</MudText>
            </div>
        </div>
    </div>

    @* --- FILTROS --- *@
    <MudPaper Elevation="0" Class="pa-4 mb-6 rounded-xl"
              Style="border: 2px solid var(--edusys-border); background: white;">
        <div class="d-flex flex-wrap align-center justify-space-between gap-4">

            <div class="d-flex align-center gap-3">
                <div style="background: #e0f2fe; padding: 10px; border-radius: 12px;">
                    <MudIcon Icon="@Icons.Material.Filled.FilterList" Color="Color.Primary" />
                </div>
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #1e3a58;">Período Académico</MudText>
                    <MudText Typo="Typo.caption"   Style="color: #64748b;">Mostrando resultados del ciclo seleccionado</MudText>
                </div>
            </div>

            <MudSelect T="int"
                       @bind-Value="cicloSeleccionado"
                       Label="Ciclo Lectivo"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="custom-select-fix"
                       Style="min-width: 220px;"
                       SelectedValuesChanged="FiltrarCursadas"
                       AdornmentIcon="@Icons.Material.Filled.CalendarToday">
                @foreach (var anio in ciclosDisponibles)
                {
                    <MudSelectItem Value="@anio">Año Lectivo @anio</MudSelectItem>
                }
            </MudSelect>

        </div>
    </MudPaper>

    @* --- CONTENIDO --- *@
    @if (cargando)
    {
        <MudGrid>
            @for (int i = 0; i < 3; i++)
            {
                <MudItem xs="12" md="4">
                    <MudCard Elevation="0" Style="border: 1px solid #eee; border-radius: 12px;">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudSkeleton Width="80%" Height="30px" />
                                <MudSkeleton Width="40%" Height="20px" />
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudSkeleton Width="100%" Height="100px" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    else if (!cursadasFiltradas.Any())
    {
        <div class="d-flex flex-column align-center justify-center pa-12 rounded-xl"
             style="border: 2px dashed #cbd5e1; background: #f8fafc;">
            <MudIcon Icon="@Icons.Material.Filled.FolderOff" Style="font-size: 5rem; color: #cbd5e1;" Class="mb-4" />
            <MudText Typo="Typo.h5" Style="font-weight: 700; color: #475569;">No hay actividad este año</MudText>
            <MudText Style="color: #94a3b8;">No se encontraron cursadas para el ciclo @cicloSeleccionado.</MudText>
        </div>
    }
    else
    {
        <MudGrid Spacing="4">
            @foreach (var cursada in cursadasFiltradas)
            {
                <MudItem xs="12" md="6" lg="4">
                    <div class="cursada-card animate-card">

                        @* CARD HEADER *@
                        <div class="card-header-modern">
                            <div class="d-flex justify-space-between align-start">
                                <MudText Class="materia-nombre">@cursada.Materia.ToUpper()</MudText>
                                <div class="@ObtenerClaseBadge(cursada.EstadoCursada)">
                                    @cursada.EstadoCursada
                                </div>
                            </div>
                            <div class="d-flex align-center gap-2 mt-2">
                                <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Color="Color.Default" />
                                <MudText Typo="Typo.caption" Style="font-weight: 700; color: #64748b;">
                                    COMISIÓN @cursada.Comision
                                </MudText>
                            </div>
                        </div>

                        @* EXÁMENES *@
                        <div class="pa-0 flex-grow-1" style="background: white;">
                            @if (cursada.Examenes != null && cursada.Examenes.Any())
                            {
                                @foreach (var examen in cursada.Examenes)
                                {
                                    <div style="border-bottom: 1px solid #f1f5f9; padding: 1rem 1.5rem;
                                                display: flex; justify-content: space-between; align-items: center;">
                                        <div>
                                            <MudText Typo="Typo.body2" Style="font-weight: 700; color: #334155;">
                                                @examen.Nombre
                                            </MudText>
                                            <MudText Typo="Typo.caption" Style="color: #94a3b8;">
                                                @examen.Fecha.ToString("dd MMM, yyyy")
                                            </MudText>
                                        </div>
                                        <div class="d-flex align-center gap-3">
                                            <span class="nota-valor @ObtenerColorNota(examen.Nota)">
                                                @(examen.Nota.HasValue ? examen.Nota.Value.ToString("0.#") : "--")
                                            </span>
                                            <MudTooltip Text="@(examen.EsOficial ? "Nota en Acta" : "Nota Provisoria")">
                                                <MudIcon Icon="@(examen.EsOficial ? Icons.Material.Filled.Verified : Icons.Material.Outlined.HistoryEdu)"
                                                         Color="@(examen.EsOficial ? Color.Primary : Color.Default)"
                                                         Size="Size.Small" />
                                            </MudTooltip>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="pa-8 text-center" style="opacity: 0.5;">
                                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Class="mb-2" />
                                    <MudText Typo="Typo.caption" Class="d-block">Sin calificaciones parciales</MudText>
                                </div>
                            }
                        </div>

                        @* FOOTER PROMEDIO *@
                        <div class="pa-4 d-flex justify-space-between align-center"
                             style="background: #f8fafc; border-top: 2px solid #f1f5f9;">
                            <MudText Typo="Typo.button" Style="font-weight: 800; color: #64748b; letter-spacing: 1px;">
                                PROMEDIO
                            </MudText>
                            <MudText Typo="Typo.h5" Style="font-weight: 900; color: #1e3a58;">
                                @(cursada.Promedio.HasValue ? cursada.Promedio.Value.ToString("0.00") : "-")
                            </MudText>
                        </div>

                    </div>
                </MudItem>
            }
        </MudGrid>
    }

</MudContainer>

@code {
    private List<CursadaAlumnoDTO> todasLasCursadas  = new();
    private List<CursadaAlumnoDTO> cursadasFiltradas = new();
    private List<int> ciclosDisponibles = new();
    private int  cicloSeleccionado;
    private bool cargando = true;

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarDatos()
    {
        cargando = true;
        try
        {
            todasLasCursadas = await AlumnoPortalService.GetMisCursadasAsync() ?? new();

            if (todasLasCursadas.Any())
            {
                ciclosDisponibles = todasLasCursadas
                    .SelectMany(c => c.Examenes)
                    .Select(e => e.Fecha.Year)
                    .Concat(new[] { DateTime.Now.Year })
                    .Distinct()
                    .OrderByDescending(x => x)
                    .ToList();

                cicloSeleccionado = ciclosDisponibles.First();
                FiltrarCursadas();
            }
            else
            {
                cicloSeleccionado = DateTime.Now.Year;
                if (!ciclosDisponibles.Contains(cicloSeleccionado))
                    ciclosDisponibles.Add(cicloSeleccionado);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Error al sincronizar con el servidor académico.", Severity.Error);
        }
        finally
        {
            cargando = false;
        }
    }

    private void FiltrarCursadas()
    {
        cursadasFiltradas = todasLasCursadas
            .Where(c => c.Examenes.Any(e => e.Fecha.Year == cicloSeleccionado) ||
                       (cicloSeleccionado == DateTime.Now.Year && !c.Examenes.Any()))
            .ToList();
    }

    private string ObtenerColorNota(decimal? nota)
    {
        if (!nota.HasValue)      return "";
        if (nota.Value >= 7)     return "nota-promocion";
        if (nota.Value >= 4)     return "nota-aprobada";
        return "nota-desaprobada";
    }

    private string ObtenerClaseBadge(string estado) => estado switch
    {
        "Regular"       => "estado-badge badge-regular",
        "Promocionado"  => "estado-badge badge-promocion",
        "Libre"         => "estado-badge badge-libre",
        _               => "estado-badge badge-cursando"
    };
}