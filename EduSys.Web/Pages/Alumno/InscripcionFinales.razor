@page "/alumno/inscripcion-finales"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize(Roles = "Alumno")]

@inject IReportesService ReportesService
@inject IJSRuntime JS
@inject IAlumnoService AlumnoService
@inject AuthenticationStateProvider AuthStateProvider
@inject IInscripcionFinalService InscripcionFinalService
@inject IPeriodoService PeriodoService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<style>
    /* --- HEADER INSTITUCIONAL --- */
    .doc-header {
        background: linear-gradient(135deg, #1e3a58 0%, #2c5282 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        margin-bottom: 1rem;
    }

    .doc-subheader {
        background-color: white;
        border: 1px solid #e2e8f0;
        padding: 1rem;
        text-align: center;
        font-weight: 800;
        color: #456990;
        border-radius: 8px;
        margin-bottom: 2rem;
        letter-spacing: 1px;
    }

    /* --- SEPARADORES --- */
    .year-separator {
        margin: 2rem 0 1rem 0;
        font-weight: 800;
        color: #1e3a58;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .year-separator::after { content: ""; flex: 1; height: 2px; background: #e2e8f0; }

    /* --- TARJETAS --- */
    .mesa-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        background: white;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    .mesa-card:hover { transform: translateY(-4px); box-shadow: 0 12px 20px rgba(0,0,0,0.08) !important; border-color: #456990; }
    .mesa-card.inscripto { border: 2px solid #10b981; background-color: #f0fdf4; }

    /* --- BADGES --- */
    .status-badge { padding: 4px 12px; border-radius: 20px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; }
    .status-inscripto { background-color: #10b981; color: white; }
    .status-disponible { background-color: #e0f2fe; color: #0369a1; }
    .status-bloqueado { background-color: #f1f5f9; color: #64748b; }

    .info-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; color: #475569; font-size: 0.9rem; }
    .bloqueo-box { background-color: #fef2f2; border-left: 4px solid #ef4444; padding: 12px; border-radius: 4px; margin-top: 1rem; }
</style>

@* --- OVERLAY DE PROCESAMIENTO --- *@
<MudOverlay Visible="procesando" DarkBackground="true" Absolute="false" ZIndex="9999">
    <MudStack AlignItems="AlignItems.Center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.h6" Style="color: white; font-weight: 600;">Procesando solicitud...</MudText>
    </MudStack>
</MudOverlay>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 pb-10">

    <div class="doc-header animate__animated animate__fadeInDown">
        <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Style="font-size: 3rem;" />
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 800; letter-spacing: -1px;">Mesas de Examen Final</MudText>
            <MudText Style="opacity: 0.8;">Inscríbete a los exámenes finales de las asignaturas regularizadas.</MudText>
        </div>
    </div>

    @if (loading)
    {
        <MudGrid Class="mt-4">
            @for (int i = 0; i < 3; i++)
            {
                <MudItem xs="12" md="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Class="rounded-lg" />
                </MudItem>
            }
        </MudGrid>
    }
    else if (periodoActual == null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-4 rounded-lg">
            No hay un período académico activo configurado en el sistema.
        </MudAlert>
    }
    else
    {
        <div class="doc-subheader animate__animated animate__fadeIn">
            TURNO ACTUAL: <span style="color: #1e3a58;">@periodoActual.Nombre.ToUpper()</span>
        </div>

        @if (!ofertaMesas.Any())
        {
            <div class="d-flex flex-column align-center justify-center pa-12 mt-4" style="background: white; border: 2px dashed #cbd5e1; border-radius: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="font-size: 5rem; color: #cbd5e1;" Class="mb-4" />
                <MudText Typo="Typo.h5" Style="font-weight: 700; color: #475569;">No hay mesas disponibles</MudText>
                <MudText Style="color: #94a3b8;">No se encontraron mesas programadas para tus asignaturas vigentes.</MudText>
            </div>
        }
        else
        {
            <MudGrid Spacing="4">
                @foreach (var grupoAnio in ofertaMesas.GroupBy(m => m.AnioCursada).OrderBy(g => g.Key))
                {
                    <MudItem xs="12">
                        <div class="year-separator">Asignaturas de @(grupoAnio.Key)° Año</div>
                    </MudItem>

                    @foreach (var mesa in grupoAnio)
                    {
                        string cardClass = "mesa-card";
                        if (mesa.YaInscripto) cardClass += " inscripto";

                        <MudItem xs="12" md="6" lg="4">
                            <div class="@cardClass animate__animated animate__fadeInUp">
                                <div class="pa-5 flex-grow-1">
                                    <div class="d-flex justify-space-between align-start mb-4">
                                        <MudText Typo="Typo.h6" Style="font-weight: 800; color: #1e293b; line-height: 1.2; flex: 1;">
                                            @mesa.MateriaNombre
                                        </MudText>
                                        <div class="status-badge @(mesa.YaInscripto ? "status-inscripto" : (mesa.PuedeInscribirse ? "status-disponible" : "status-bloqueado"))">
                                            @(mesa.YaInscripto ? "Inscripto" : (mesa.PuedeInscribirse ? "Disponible" : "Bloqueado"))
                                        </div>
                                    </div>

                                    <div class="info-row">
                                        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Color="Color.Primary" />
                                        <MudText Typo="Typo.body2"><b>Fecha:</b> @mesa.FechaHora.ToString("dd/MM/yyyy HH:mm") hs.</MudText>
                                    </div>
                                    <div class="info-row">
                                        <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Small" Color="Color.Primary" />
                                        <MudText Typo="Typo.body2" Class="text-truncate"><b>Tribunal:</b> @mesa.Tribunal</MudText>
                                    </div>

                                    @if (mesa.PuedeInscribirse || mesa.YaInscripto)
                                    {
                                        <div class="info-row" style="background: #e0f2fe; padding: 8px; border-radius: 6px; margin-top: 10px;">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="color: #0369a1;" />
                                            <MudText Typo="Typo.body2" Style="color: #0369a1;"><b>Tu Condición:</b> @mesa.Condicion</MudText>
                                        </div>
                                    }

                                    @if (!mesa.YaInscripto && !mesa.PuedeInscribirse)
                                    {
                                        <div class="bloqueo-box">
                                            <div class="d-flex align-center gap-2 mb-1">
                                                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" Color="Color.Error" />
                                                <MudText Typo="Typo.caption" Style="font-weight: 800;">REQUISITO NO CUMPLIDO</MudText>
                                            </div>
                                            <MudText Typo="Typo.caption" Style="line-height: 1.2;">@mesa.MotivoBloqueo</MudText>
                                        </div>
                                    }
                                </div>

                                <div class="pa-4 d-flex gap-2" style="background: #f8fafc; border-top: 1px solid #e2e8f0; border-radius: 0 0 12px 12px;">
                                    @if (mesa.YaInscripto)
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" 
                                                   OnClick="@(() => CancelarInscripcion(mesa.IdInscripcionFinal!.Value))" Disabled="procesando" Class="font-weight-bold">
                                            Darse de Baja
                                        </MudButton>
                                        <MudSpacer />
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" 
                                                   OnClick="@(() => DescargarConstanciaPDF(mesa.IdInscripcionFinal!.Value, mesa.MateriaNombre))" Disabled="procesando">
                                            Comprobante
                                        </MudButton>
                                    }
                                    else if (mesa.PuedeInscribirse)
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.AssignmentTurnedIn"
                                                   OnClick="@(() => Inscribirse(mesa.IdMesaFinal, mesa.Condicion))" Disabled="procesando" Style="font-weight: 700;">
                                            Confirmar Inscripción
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Outlined" FullWidth="true" Disabled="true">No Habilitado</MudButton>
                                    }
                                </div>
                            </div>
                        </MudItem>
                    }
                }
            </MudGrid>
        }
    }
</MudContainer>

@code {
    private bool loading = true;
    private bool procesando = false;
    private PeriodoAcademicoDTO? periodoActual;
    private List<MesaFinalOfertaDTO> ofertaMesas = new();
    private int idAlumnoActual;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        loading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var idUsuarioClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value;

                if (int.TryParse(idUsuarioClaim, out int idUsuario))
                {
                    var alumnoLogueado = await AlumnoService.GetByUsuarioIdAsync(idUsuario);

                    if (alumnoLogueado != null)
                    {
                        idAlumnoActual = alumnoLogueado.Id;
                        var periodos = await PeriodoService.GetAllAsync();
                        periodoActual = periodos.FirstOrDefault(p => p.Activo);

                        if (periodoActual != null)
                        {
                            ofertaMesas = await InscripcionFinalService.GetOfertaAsync(idAlumnoActual, periodoActual.Id);
                        }
                    }
                }
            }
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo conectar con el servicio de inscripciones.", Severity.Error);
        }
        finally { loading = false; }
    }

    private async Task Inscribirse(int idMesa, string condicion)
    {
        procesando = true;
        try
        {
            var request = new InscripcionFinalRequestDTO
            {
                IdAlumno = idAlumnoActual,
                IdMesaFinal = idMesa,
                Condicion = condicion
            };

            var res = await InscripcionFinalService.InscribirAsync(request);
            if (res.Exito)
            {
                Snackbar.Add("¡Inscripción exitosa!", Severity.Success);
                await CargarDatos();
            }
            else Snackbar.Add(res.Mensaje, Severity.Warning);
        }
        finally { procesando = false; }
    }

    private async Task CancelarInscripcion(int idInscripcion)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Confirmar Acción",
            "¿Deseas anular tu inscripción a esta mesa de examen?",
            yesText: "Sí, anular", cancelText: "Volver");

        if (result == true)
        {
            procesando = true;
            try
            {
                var res = await InscripcionFinalService.CancelarInscripcionAsync(idInscripcion, idAlumnoActual);
                if (res.Exito)
                {
                    Snackbar.Add("Inscripción anulada.", Severity.Info);
                    await CargarDatos();
                }
                else Snackbar.Add(res.Mensaje, Severity.Error);
            }
            finally { procesando = false; }
        }
    }

    private async Task DescargarConstanciaPDF(int idInscripcion, string materia)
    {
        procesando = true;
        try
        {
            Snackbar.Add("Generando PDF...", Severity.Info);
            var pdfBytes = await ReportesService.DescargarConstanciaFinalAsync(idInscripcion);

            using var stream = new MemoryStream(pdfBytes);
            using var streamRef = new DotNetStreamReference(stream);
            string fileName = $"Comprobante_Mesa_{materia.Replace(" ", "_")}.pdf";

            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
            Snackbar.Add("Comprobante descargado.", Severity.Success);
        }
        catch (Exception) { Snackbar.Add("Error al generar el documento.", Severity.Error); }
        finally { procesando = false; }
    }
}