@page "/inscripcion-materias"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject IVentanaService VentanaService
@inject IComisionService ComisionService
@inject IInscripcionService InscripcionService
@inject IPeriodoService PeriodoService
@inject IAlumnoService AlumnoService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<style>
    :root {
        --edusys-coral: #EF767A;
        --edusys-blue: #456990;
        --edusys-teal: #49BEAA;
        --edusys-gray: #f8fafc;
        --edusys-purple: #9c27b0;
    }

    .header-institucional {
        background: linear-gradient(135deg, var(--edusys-blue) 0%, #1e3a58 100%);
        color: white;
        padding: 2rem;
        border-radius: 16px;
        margin-bottom: 2rem;
        box-shadow: 0 10px 25px rgba(30,58,88,0.15);
    }

    .materia-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .materia-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 20px rgba(0,0,0,0.08);
    }

    .materia-header {
        padding: 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        gap: 1rem;
    }

    .materia-header.inscripto  { border-left: 6px solid var(--edusys-teal);   background-color: #f0fdfa; }
    .materia-header.disponible { border-left: 6px solid var(--edusys-blue); }
    .materia-header.bloqueado  { border-left: 6px solid #cbd5e1;              background-color: #f8fafc; }
    .materia-header.libre      { border-left: 6px solid var(--edusys-purple);  background-color: #fdf4ff; }

    .materia-nombre { 
        font-size: 1rem; 
        font-weight: 800; 
        color: #1e293b; 
        flex: 1; 
        word-break: normal; 
        overflow-wrap: normal;
    }

    .estado-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .estado-badge.inscripto  { background: var(--edusys-teal);  color: white; }
    .estado-badge.disponible { background: #e0f2fe;               color: #0369a1; }
    .estado-badge.bloqueado  { background: #f1f5f9;               color: #64748b; }
    .estado-badge.libre      { background: var(--edusys-purple);  color: white; }

    .comision-item {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 1rem;
        margin-bottom: 0.75rem;
        transition: border-color 0.2s;
    }

    .comision-item.mi-comision {
        border: 2px solid var(--edusys-teal);
        background: #f0fdfa;
    }

    .btn-action {
        height: 42px;
        border-radius: 8px;
        font-weight: 700;
        letter-spacing: 0.5px;
        width: 100%;
        transition: all 0.2s;
    }

    /* --- CLASES DEL DIALOGO UNIFICADO DE EDUSYS --- */
    .unified-dialog-card {
        background-color: white !important;
        border-radius: 16px !important;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1) !important;
    }

    .modal-title-warning {
        color: #d97706;
        font-weight: 800;
        font-size: 1.5rem;
        letter-spacing: -0.5px;
    }
</style>

@* --- OVERLAY --- *@
<MudOverlay Visible="procesando" DarkBackground="true" Absolute="false" ZIndex="9999">
    <MudStack AlignItems="AlignItems.Center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.h6" Style="color: white; font-weight: 600;">Procesando solicitud...</MudText>
    </MudStack>
</MudOverlay>

<div class="inscripcion-container pa-4">

    @* --- HEADER INSTITUCIONAL --- *@
    <div class="header-institucional">
        <div class="d-flex justify-space-between align-center flex-wrap gap-4">

            @* Título + período *@
            <div>
                <MudText Typo="Typo.h3" Style="font-weight: 800; letter-spacing: -1px;">Inscripción a Cursadas</MudText>
                @if (periodoActual != null)
                {
                    <div class="d-flex align-center gap-2 mt-2">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Style="color: #49DCB1;" />
                        <MudText Typo="Typo.h6" Style="font-weight: 400; opacity: 0.9;">
                            Periodo: <b>@periodoActual.Nombre</b>
                        </MudText>
                    </div>
                }
            </div>

            @* --- CRONOGRAMA MEJORADO --- *@
            @if (ventanaInscripcion != null)
            {
                <div style="background: rgba(255,255,255,0.08); backdrop-filter: blur(8px);
                            border: 1px solid rgba(255,255,255,0.15); border-radius: 14px;
                            padding: 1rem 1.5rem; min-width: 280px;">

                    @* Título con pill de estado *@
                    <div class="d-flex align-center justify-space-between mb-3">
                        <div class="d-flex align-center gap-2">
                            <div style="background: @(inscripcionesAbiertas ? "rgba(73,190,170,0.2)" : "rgba(239,118,122,0.2)");
                                        padding: 6px; border-radius: 8px;">
                                <MudIcon Icon="@(inscripcionesAbiertas ? Icons.Material.Filled.LockOpen : Icons.Material.Filled.Lock)"
                                         Style="@($"color: {(inscripcionesAbiertas ? "#49BEAA" : "#EF767A")}; font-size: 1.1rem;")" />
                            </div>
                            <MudText Style="font-weight: 800; font-size: 0.8rem; letter-spacing: 1px; color: white;">
                                CRONOGRAMA DE ACCESO
                            </MudText>
                        </div>
                        <div style="background: @(inscripcionesAbiertas ? "#49BEAA" : "#EF767A");
                                    color: white; padding: 2px 10px; border-radius: 20px;
                                    font-size: 0.65rem; font-weight: 800; letter-spacing: 0.5px;">
                            @(inscripcionesAbiertas ? "ABIERTO" : "CERRADO")
                        </div>
                    </div>

                    @* Separador *@
                    <div style="height: 1px; background: rgba(255,255,255,0.1); margin-bottom: 0.75rem;"></div>

                    @* Fechas *@
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-center justify-space-between gap-4">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Style="color: #49BEAA; font-size: 1rem;" />
                                <MudText Style="font-size: 0.75rem; opacity: 0.7; font-weight: 600;">INICIO</MudText>
                            </div>
                            <MudText Style="font-size: 0.8rem; font-weight: 800; color: white;">
                                @(ventanaInscripcion.FechaInicio?.ToString("dd/MM/yy") ?? "--")
                                <span style="opacity: 0.6; font-weight: 600; font-size: 0.72rem;">
                                    @(ventanaInscripcion.FechaInicio?.ToString(" HH:mm") ?? "") hs
                                </span>
                            </MudText>
                        </div>
                        <div class="d-flex align-center justify-space-between gap-4">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.StopCircle" Style="color: #EF767A; font-size: 1rem;" />
                                <MudText Style="font-size: 0.75rem; opacity: 0.7; font-weight: 600;">CIERRE</MudText>
                            </div>
                            <MudText Style="font-size: 0.8rem; font-weight: 800; color: white;">
                                @(ventanaInscripcion.FechaFin?.ToString("dd/MM/yy") ?? "--")
                                <span style="opacity: 0.6; font-weight: 600; font-size: 0.72rem;">
                                    @(ventanaInscripcion.FechaFin?.ToString(" HH:mm") ?? "") hs
                                </span>
                            </MudText>
                        </div>
                    </div>

                </div>
            }

        </div>
    </div>

    @* --- CUERPO --- *@
    @if (loading)
    {
        <div class="d-flex flex-column align-center justify-center pa-12">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"
                                 Style="width: 70px; height: 70px;" />
            <MudText Typo="Typo.h6" Class="mt-4" Color="Color.Primary">Sincronizando oferta académica...</MudText>
        </div>
    }
    else
    {
        @if (!inscripcionesAbiertas)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled"
                      Class="mb-6 rounded-lg animate__animated animate__shakeX">
                El periodo de inscripción se encuentra <b>CERRADO</b>. No se pueden realizar cambios en tu cursada actual.
            </MudAlert>
        }

        <MudTabs Elevation="0" Rounded="true" Color="Color.Transparent"
                 SliderColor="Color.Primary" ApplyEffectsToContainer="true" PanelClass="pt-6">

            @foreach (var grupoAnio in comisionesFiltradas.GroupBy(c => c.AnioCursada).OrderBy(g => g.Key))
            {
                <MudTabPanel Text="@($"{grupoAnio.Key}° AÑO")">

                    <div class="d-flex justify-end mb-4">
                        <MudButton Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.UnfoldMore"
                                   Color="Color.Primary"
                                   OnClick="ToggleTodasLasMaterias">
                            @(TodasExpandidas() ? "Contraer todas" : "Expandir todas")
                        </MudButton>
                    </div>

                    <MudGrid Spacing="3">
                        @foreach (var grupoMateria in grupoAnio.GroupBy(c => c.MateriaNombre))
                        {
                            var primera     = grupoMateria.First();
                            var miInscripcion = misInscripciones.FirstOrDefault(i =>
                                i.Materia.Trim().Equals(primera.MateriaNombre.Trim(), StringComparison.OrdinalIgnoreCase));
                            bool inscripto  = miInscripcion != null;
                            bool expandida  = EstaExpandida(primera.MateriaNombre);

                            string estadoClass = "disponible";
                            string estadoTexto = "Disponible";

                            if (inscripto)                      { estadoClass = "inscripto";  estadoTexto = "Inscripto"; }
                            else if (!primera.CumpleCorrelativas){ estadoClass = "bloqueado";  estadoTexto = "Bloqueado"; }
                            else if (primera.EsMateriaLibre)    { estadoClass = "libre";       estadoTexto = "Libre"; }

                            <MudItem xs="12" md="6" lg="4">
                                <div class="materia-card">

                                    @* Header de materia *@
                                    <div class="materia-header @estadoClass"
                                         @onclick="() => ToggleMateria(primera.MateriaNombre)">
                                        <MudText Class="materia-nombre">@primera.MateriaNombre</MudText>
                                        <div class="estado-badge @estadoClass">
                                            <span>@estadoTexto.ToUpper()</span>
                                            <MudIcon Icon="@(expandida ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                     Size="Size.Small" />
                                        </div>
                                    </div>

                                    @if (expandida)
                                    {
                                        <div class="pa-4 animate__animated animate__fadeIn animate__faster"
                                             style="border-top: 1px solid #f1f5f9;">

                                            @if (!inscripto && !primera.CumpleCorrelativas)
                                            {
                                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                                                    <b>Requisito:</b> @primera.MensajeError
                                                </MudAlert>
                                            }

                                            @foreach (var comision in grupoMateria)
                                            {
                                                bool esMiComision = inscripto &&
                                                    miInscripcion!.ComisionCodigo.Trim().Equals(
                                                        comision.Codigo.Trim(), StringComparison.OrdinalIgnoreCase);

                                                <div class="comision-item @(esMiComision ? "mi-comision" : "")">

                                                    <div class="d-flex justify-space-between align-center mb-2">
                                                        <MudText Typo="Typo.subtitle2"
                                                                 Style="font-weight: 800; color: #456990;">
                                                            COMISIÓN @comision.Codigo
                                                        </MudText>
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                                                 Color="@(comision.CupoDisponible > 0 ? Color.Success : Color.Error)">
                                                            Cupo: @comision.CupoDisponible / @comision.CupoMaximo
                                                        </MudChip>
                                                    </div>

                                                    <MudStack Spacing="1" Class="mb-4">
                                                        <div class="d-flex align-center gap-2">
                                                            <MudIcon Icon="@Icons.Material.Filled.Person"
                                                                     Size="Size.Small" Color="Color.Default"
                                                                     Style="opacity: 0.5;" />
                                                            <MudText Typo="Typo.caption">
                                                                Prof: <b>@comision.Profesor</b>
                                                            </MudText>
                                                        </div>
                                                        <div class="d-flex align-center gap-2">
                                                            <MudIcon Icon="@Icons.Material.Filled.AccessTime"
                                                                     Size="Size.Small" Color="Color.Default"
                                                                     Style="opacity: 0.5;" />
                                                            <MudText Typo="Typo.caption">@comision.Horarios</MudText>
                                                        </div>
                                                    </MudStack>

                                                    @if (esMiComision)
                                                    {
                                                        @if (inscripcionesAbiertas)
                                                        {
                                                            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                                                       FullWidth="true" Class="btn-action"
                                                                       StartIcon="@Icons.Material.Filled.Delete"
                                                                       OnClick="@(() => AbrirModalBaja(miInscripcion!.IdInscripcion, comision.MateriaNombre))">
                                                                ANULAR INSCRIPCIÓN
                                                            </MudButton>
                                                        }
                                                        else
                                                        {
                                                            <MudButton Variant="Variant.Filled" Color="Color.Success"
                                                                       FullWidth="true" Class="btn-action"
                                                                       Disabled="true"
                                                                       StartIcon="@Icons.Material.Filled.Check">
                                                                CURSANDO
                                                            </MudButton>
                                                        }
                                                    }
                                                    else if (inscripto)
                                                    {
                                                        <MudAlert Severity="Severity.Info" Dense="true">
                                                            Ya estás en otra comisión
                                                        </MudAlert>
                                                    }
                                                    else if (!inscripcionesAbiertas)
                                                    {
                                                        <MudButton Variant="Variant.Outlined" FullWidth="true"
                                                                   Disabled="true" Class="btn-action">
                                                            FUERA DE FECHA
                                                        </MudButton>
                                                    }
                                                    else if (comision.CupoDisponible <= 0)
                                                    {
                                                        <MudButton Variant="Variant.Outlined" FullWidth="true"
                                                                   Disabled="true" Class="btn-action">
                                                            COMISIÓN COMPLETA
                                                        </MudButton>
                                                    }
                                                    else if (primera.CumpleCorrelativas)
                                                    {
                                                        @if (primera.EsMateriaLibre)
                                                        {
                                                            <div class="mb-2 pa-2 rounded-lg"
                                                                 style="background: #fdf4ff; border: 1px solid #f5d0fe;">
                                                                <MudCheckBox T="bool"
                                                                             @bind-Value="@(esLibreSelection[comision.Id])"
                                                                             Label="Inscribirme como LIBRE"
                                                                             Color="Color.Secondary"
                                                                             Dense="true" Size="Size.Small" />
                                                            </div>
                                                        }
                                                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                                   FullWidth="true" Class="btn-action"
                                                                   StartIcon="@Icons.Material.Filled.AddCircle"
                                                                   OnClick="@(() => Inscribirse(comision))">
                                                            SOLICITAR INSCRIPCIÓN
                                                        </MudButton>
                                                    }

                                                </div>
                                            }
                                        </div>
                                    }

                                </div>
                            </MudItem>
                        }
                    </MudGrid>

                </MudTabPanel>
            }

        </MudTabs>
    }

</div>

@* --- DIALOGO DE BAJA (DISEÑO UNIFICADO) --- *@
<MudDialog @bind-Visible="mostrarDialogoBaja" Options="optionsBaja" Class="unified-dialog-card pb-2">
    <DialogContent>
        <div class="pa-4 d-flex flex-column align-center text-center">
            <div style="background-color: #fffbeb; padding: 16px; border-radius: 50%; margin-bottom: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Style="font-size: 3rem;" />
            </div>
            <MudText Class="modal-title-warning mb-2">Confirmar Baja</MudText>
            <MudText Typo="Typo.body1" Style="color: #334155; font-weight: 600;" Class="mb-2">
                La inscripción en <b>@nombreMateriaParaBaja</b> será anulada.
            </MudText>
            <MudText Typo="Typo.caption" Style="color: #64748b;">
                Perderás tu lugar en la comisión y deberás inscribirte nuevamente si cambias de opinión.
            </MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="px-4 pb-4 d-flex justify-center gap-3 w-100">
            <MudButton OnClick="CerrarModalBaja" Variant="Variant.Outlined" Color="Color.Default" Class="rounded-lg font-weight-bold" Disabled="procesando">Cancelar</MudButton>
            <MudButton OnClick="ConfirmarBaja" Variant="Variant.Filled" Color="Color.Warning" Class="rounded-lg font-weight-bold px-6" Disabled="procesando">
                @(procesando ? "Procesando..." : "Confirmar Baja")
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    private bool loading    = true;
    private bool procesando = false;

    private AlumnoDTO?                  alumnoActual        = null;
    private PeriodoAcademicoDTO?        periodoActual       = null;
    private VentanaOperativaDTO?        ventanaInscripcion  = null;
    private List<ComisionDTO>           comisionesFiltradas = new();
    private List<InscripcionCursadaListadoDTO>  misInscripciones    = new();
    private Dictionary<string, bool>    materiasExpandidas  = new();
    private Dictionary<int, bool>       esLibreSelection    = new();

    private bool inscripcionesAbiertas => ventanaInscripcion != null && ventanaInscripcion.EstaVigente;

    private bool   mostrarDialogoBaja     = false;
    private int    idInscripcionParaBaja  = 0;
    private string nombreMateriaParaBaja  = "";
    private DialogOptions optionsBaja = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, BackdropClick = false, CloseButton = false };

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarDatos()
    {
        loading = true;
        try
        {
            var authState    = await AuthStateProvider.GetAuthenticationStateAsync();
            var idUsuarioStr = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (int.TryParse(idUsuarioStr, out int idUsuario))
            {
                alumnoActual = await AlumnoService.GetByUsuarioIdAsync(idUsuario);
                if (alumnoActual != null)
                {
                    var periodos = await PeriodoService.GetAllAsync();
                    periodoActual = periodos.FirstOrDefault(p => p.Activo && p.Estado == "Abierto");

                    if (periodoActual != null)
                    {
                        var ventanas = await VentanaService.GetAllAsync();
                        ventanaInscripcion = ventanas.FirstOrDefault(v =>
                            v.IdPeriodo == periodoActual.Id &&
                            v.TipoAccion.Contains("INSCRIPCION_CURSADA"));

                        comisionesFiltradas = await InscripcionService
                            .GetOfertaParaAlumnoAsync(alumnoActual.Id, periodoActual.Id);
                        misInscripciones = await InscripcionService
                            .GetInscripcionesAlumnoAsync(alumnoActual.Id, periodoActual.Id);

                        foreach (var c in comisionesFiltradas)
                        {
                            if (!materiasExpandidas.ContainsKey(c.MateriaNombre))
                                materiasExpandidas[c.MateriaNombre] = false;
                            if (!esLibreSelection.ContainsKey(c.Id))
                                esLibreSelection[c.Id] = false;
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al sincronizar datos: " + ex.Message, Severity.Error);
        }
        finally { loading = false; }
    }

    private void ToggleMateria(string m)   => materiasExpandidas[m] = !materiasExpandidas[m];
    private bool EstaExpandida(string m)   => materiasExpandidas.TryGetValue(m, out var v) && v;
    private bool TodasExpandidas()         => materiasExpandidas.Values.All(v => v);

    private void ToggleTodasLasMaterias()
    {
        bool target = !TodasExpandidas();
        foreach (var k in materiasExpandidas.Keys.ToList())
            materiasExpandidas[k] = target;
    }

    private async Task Inscribirse(ComisionDTO comision)
    {
        if (procesando) return;
        procesando = true;
        try
        {
            var req = new InscripcionCursadaRequestDTO
            {
                IdAlumno   = alumnoActual!.Id,
                IdComision = comision.Id,
                EsLibre    = esLibreSelection[comision.Id]
            };

            var res = await InscripcionService.InscribirAlumnoAsync(req);

            if (res.Exito)
            {
                Snackbar.Add("¡Inscripción confirmada con éxito!", Severity.Success);
                await CargarDatos();
            }
            else
            {
                await DialogService.ShowMessageBox("Inscripción no procesada", res.Mensaje);
            }
        }
        finally { procesando = false; }
    }

    private void AbrirModalBaja(int id, string materia)
    {
        idInscripcionParaBaja = id;
        nombreMateriaParaBaja = materia;
        mostrarDialogoBaja    = true;
    }

    private void CerrarModalBaja() => mostrarDialogoBaja = false;

    private async Task ConfirmarBaja()
    {
        procesando = true;
        try
        {
            if (await InscripcionService.CancelarInscripcionAsync(idInscripcionParaBaja))
            {
                Snackbar.Add("Inscripción anulada.", Severity.Info);
                await CargarDatos();
            }
        }
        finally
        {
            procesando = false;
            CerrarModalBaja();
        }
    }
}