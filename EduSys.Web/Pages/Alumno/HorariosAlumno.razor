@page "/horarios-alumno"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using System.IO

@attribute [Authorize(Roles = "Alumno")]

@inject AuthenticationStateProvider AuthStateProvider
@inject IAlumnoService AlumnoService
@inject IHorarioService HorarioService
@inject IPeriodoService PeriodoService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<style>
    /* REUTILIZAMOS TUS ESTILOS EXACTOS PARA MANTENER COHERENCIA */
    .schedule-container {
        border: 2px solid #456990;
        border-radius: 6px;
        overflow: hidden;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: white;
    }

    .career-header {
        background-color: white;
        color: #456990;
        padding: 10px;
        border-bottom: 2px solid #456990;
        display: block;
        text-align: center;
        width: 100%;
        font-weight: 900;
        font-size: 1.2rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .schedule-header {
        background-color: #456990;
        color: white;
        padding: 10px;
        border-bottom: 2px solid white;
        display: block;
        text-align: center;
        width: 100%;
        font-weight: 700;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .columns-header {
        display: flex;
        background-color: #456990;
        color: white;
        font-weight: 700;
        font-size: 0.85rem;
        border-bottom: 2px solid white;
    }

    .header-cell {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 6px 4px;
        border-right: 1px solid white;
    }

        .header-cell:last-child {
            border-right: none;
        }

    .col-width-day {
        width: 50px;
        min-width: 50px;
    }

    .col-width-course {
        width: 100px;
        min-width: 100px;
    }

    .col-width-subjects {
        flex-grow: 1;
    }

    .day-row {
        display: flex;
        border-bottom: 2px solid #456990;
    }

        .day-row:last-child {
            border-bottom: none;
        }

    .day-column {
        background-color: #456990;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 1rem;
        writing-mode: vertical-rl;
        text-orientation: upright;
        border-right: 1px solid #456990;
        padding: 2px;
    }

    .courses-column {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .course-row {
        display: flex;
        border-bottom: 1px solid #456990;
        min-height: 65px;
    }

        .course-row:last-child {
            border-bottom: none;
        }

    .course-label {
        background-color: #F1F5F9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #456990;
        font-size: 0.9rem;
        padding: 4px;
        text-align: center;
        border-right: 1px solid #456990;
    }

    .subjects-area {
        flex-grow: 1;
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        padding: 0;
        background-color: white;
    }

    .subject-block {
        flex: 1;
        padding: 4px 6px;
        font-size: 0.8rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        text-align: center;
        min-width: 140px;
        border-right: 1px solid #456990;
        transition: background-color 0.2s;
    }

        .subject-block:hover {
            background-color: #F8FAFC;
        }

        .subject-block:last-child {
            border-right: none;
        }

    .subject-time {
        font-weight: 700;
        color: #456990;
        background-color: #E0F2F1;
        border: 1px solid #49BEAA;
        border-radius: 4px;
        padding: 1px 6px;
        margin-bottom: 4px;
        font-size: 0.7rem;
        display: inline-block;
        align-self: center;
    }

    .subject-name {
        font-weight: 700;
        color: #1F2937;
        line-height: 1.1;
        font-size: 0.8rem;
        text-transform: uppercase;
    }

    .subject-classroom {
        color: #6c757d;
        font-weight: 700;
        font-size: 0.7rem;
        margin-top: 3px;
    }
</style>

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5" Color="Color.Primary"><b>Mis Horarios de Cursada</b></MudText>

    @if (horarios.Any())
    {
        <div class="d-flex gap-2">
            <MudButton StartIcon="@Icons.Material.Filled.Visibility"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       OnClick="@(() => DescargarOVisualizarPdf(false))">
                Ver PDF
            </MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.Download"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="@(() => DescargarOVisualizarPdf(true))">
                Descargar
            </MudButton>
        </div>
    }
</div>

@if (isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (datosIncompletos)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        No se encontraron datos de carrera o sede asociados a tu usuario. Por favor, contacta a administración.
    </MudAlert>
}
else if (!horarios.Any())
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No hay horarios cargados para tu carrera en este período (@nombrePeriodo).
    </MudAlert>
}
else
{
    // --- GRILLA DE HORARIOS (AUTOMÁTICA) ---
    <div class="schedule-container animate__animated animate__fadeIn">
        <div class="career-header">
            CARRERA: @nombreCarrera
        </div>

        <div class="schedule-header">
            HORARIO DE CLASES - @nombrePeriodo.ToUpper() - @nombreSede.ToUpper()
        </div>

        <div class="columns-header">
            <div class="header-cell col-width-day">DÍA</div>
            <div class="header-cell col-width-course">CURSO</div>
            <div class="header-cell col-width-subjects">ASIGNATURAS Y HORARIOS</div>
        </div>

        @foreach (var dia in diasOrdenados)
        {
            var clasesDelDia = horarios.Where(h => h.Dia.Equals(dia, StringComparison.OrdinalIgnoreCase)).ToList();
            if (clasesDelDia.Any())
            {
                <div class="day-row">
                    <div class="day-column col-width-day">
                        @dia.Substring(0, 3).ToUpper()
                    </div>

                    <div class="courses-column" style="flex-grow:1;">
                        @foreach (var grupo in clasesDelDia
                                    .GroupBy(c => new { Anio = c.AnioCursada, Codigo = c.ComisionCodigo.Trim().ToUpper() })
                                    .OrderBy(g => g.Key.Anio)
                                    .ThenBy(g => g.Key.Codigo))
                        {
                            <div class="course-row">
                                <div class="course-label col-width-course">
                                    <span>@grupo.First().ComisionCodigo</span>
                                </div>

                                <div class="subjects-area">
                                    @foreach (var clase in grupo.OrderBy(c => c.HoraInicio))
                                    {
                                        <div class="subject-block">
                                            <span class="subject-time">@clase.HoraInicio.ToString(@"hh\:mm") - @clase.HoraFin.ToString(@"hh\:mm")</span>
                                            <span class="subject-name">@clase.Materia</span>
                                            <span class="subject-classroom">@clase.Aula</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    private bool isLoading = true;
    private bool datosIncompletos = false;

    private List<HorarioVisualizacionDTO> horarios = new();
    private List<string> diasOrdenados = new() { "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado" };

    // Datos del Alumno Logueado
    private int alumnoCarreraId;
    private int alumnoSedeId;
    private int periodoActualId;

    private string nombreCarrera = "";
    private string nombreSede = "";
    private string nombrePeriodo = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarHorariosAlumno();
    }

    private async Task CargarHorariosAlumno()
    {
        isLoading = true;
        try
        {
            // 1. Obtener ID Usuario
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value;

            if (int.TryParse(userIdClaim, out int idUsuario))
            {
                // 2. Obtener Datos Alumno
                var alumno = await AlumnoService.GetByUsuarioIdAsync(idUsuario);

                // 3. Obtener Periodo Activo
                var periodos = await PeriodoService.GetAllAsync();
                var periodoActivo = periodos.FirstOrDefault(p => p.Activo) ?? periodos.LastOrDefault();

                if (alumno != null && periodoActivo != null)
                {
                    alumnoCarreraId = alumno.IdCarrera;
                    alumnoSedeId = alumno.IdSede;
                    periodoActualId = periodoActivo.Id;

                    nombreCarrera = alumno.NombreCarrera;
                    nombreSede = alumno.NombreSede;
                    nombrePeriodo = periodoActivo.Nombre;

                    // 4. TRAER HORARIOS DIRECTAMENTE (Sin filtros UI)
                    horarios = await HorarioService.GetVisualizacionAsync(periodoActualId, alumnoCarreraId, alumnoSedeId);
                }
                else
                {
                    datosIncompletos = true;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al cargar horarios: " + ex.Message, Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DescargarOVisualizarPdf(bool forzarDescarga)
    {
        try
        {
            var pdfBytes = await HorarioService.DescargarPdfAsync(periodoActualId, alumnoCarreraId, alumnoSedeId);
            using var stream = new MemoryStream(pdfBytes);
            using var streamRef = new DotNetStreamReference(stream);

            var nombreArchivo = $"Horario_{nombreCarrera}_{nombreSede}.pdf".Replace(" ", "_");

            if (forzarDescarga)
            {
                await JS.InvokeVoidAsync("downloadFileFromStream", nombreArchivo, streamRef);
                Snackbar.Add("Descarga iniciada", Severity.Success);
            }
            else
            {
                await JS.InvokeVoidAsync("openFileInNewTab", nombreArchivo, streamRef);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al generar PDF: {ex.Message}", Severity.Error);
        }
    }
}