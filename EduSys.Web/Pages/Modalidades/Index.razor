@page "/modalidades"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@inject IModalidadService ModalidadService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    /* 1. TEXTO NEGRO FORZADO Y PAGINADOR */
    .force-black-text,
    .force-black-text input,
    .force-black-text textarea,
    .force-black-text .mud-input-slot,
    .force-black-text .mud-input-root,
    .force-black-text .mud-table-pagination-caption,
    .force-black-text .mud-table-pagination-select .mud-input-slot,
    .force-black-text .mud-select-input {
        color: #1F2937 !important;
        -webkit-text-fill-color: #1F2937 !important;
        font-weight: 500;
    }

        .force-black-text .mud-input-label {
            color: #456990 !important; /* Label Azul Corporativo */
            background-color: white !important;
            padding: 0 4px;
            z-index: 2;
            font-weight: 600;
        }

    /* 2. ESTILO DE MODALES UNIFICADO */
    .unified-dialog-card {
        background-color: white !important;
        border-radius: 12px !important;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2) !important;
    }

    .modal-title {
        color: var(--mud-palette-primary);
        font-weight: 800;
        font-size: 1.5rem;
    }

    .modal-title-warning {
        color: #d97706;
        font-weight: 800;
        font-size: 1.5rem;
    }

    /* --- ESTILO DE INPUTS DENTRO DEL MODAL (CON BORDE AZUL) --- */
    .mud-dialog .mud-input-outlined-border {
        border-color: #456990 !important;
        border-width: 1px !important;
    }

    .mud-dialog .mud-input-control {
        background-color: #FAFAFA;
        border-radius: 4px;
    }

        .mud-dialog .mud-input-control input {
            color: #0F172A !important;
            font-weight: 500;
        }

    /* Iconos grises */
    .mud-input-adornment-start .mud-icon-root,
    .force-black-text .mud-icon-root {
        color: #6B7280 !important;
    }

    /* 3. CONTROLES */
    .search-modern {
        background-color: white !important;
        border: 1px solid #E5E7EB !important;
        border-radius: 8px !important;
    }

    .filter-btn {
        transition: all 0.2s ease-in-out;
        border-radius: 20px !important;
        text-transform: none !important;
        font-weight: 600 !important;
    }
</style>

<MudText Typo="Typo.h5" Color="Color.Primary" Align="Align.Center" Class="mb-4"><b>Gestión de Modalidades</b></MudText>

<MudTable @ref="_table" Items="@modalidades" Hover="true" Loading="@loading" RowsPerPage="5" Filter="new Func<ModalidadDTO, bool>(FilterFunc)" Elevation="3" Class="rounded-xl" ReadOnly="false" CanCancelEdit="true" RowEditCommit="ItemHasBeenCommitted" EditTrigger="TableEditTrigger.EditButton" ApplyButtonPosition="TableApplyButtonPosition.End">

    <ToolBarContent>
        <MudText Typo="Typo.h6" Color="Color.Primary" Class="d-none d-md-flex font-weight-bold mr-4">Catálogo</MudText>
        <MudSpacer />

        <div class="d-flex align-center gap-2 px-4 border-r mr-4" style="border-color: #e5e7eb;">
            <MudText Typo="Typo.body2" Style="color: #6B7280; font-weight: 500;">Mostrar:</MudText>
            <MudButton OnClick="@(() => CambiarFiltro("Todos"))" Variant="@(filtroEstado == "Todos" ? Variant.Filled : Variant.Outlined)" Color="@(filtroEstado == "Todos" ? Color.Primary : Color.Default)" Size="Size.Small" Class="filter-btn">Todas</MudButton>
            <MudButton OnClick="@(() => CambiarFiltro("Activas"))" Variant="@(filtroEstado == "Activas" ? Variant.Filled : Variant.Outlined)" Color="@(filtroEstado == "Activas" ? Color.Success : Color.Default)" Size="Size.Small" Class="filter-btn">Activas</MudButton>
            <MudButton OnClick="@(() => CambiarFiltro("Bajas"))" Variant="@(filtroEstado == "Bajas" ? Variant.Filled : Variant.Outlined)" Color="@(filtroEstado == "Bajas" ? Color.Warning : Color.Default)" Size="Size.Small" Class="filter-btn">Bajas</MudButton>
        </div>

        <MudTextField @bind-Value="searchString" Placeholder="Buscar modalidad..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Variant="Variant.Text" Margin="Margin.Dense" Class="mt-0 search-modern force-black-text px-2" Style="min-width: 250px;" Immediate="true" Clearable="true" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirModalCrear" Class="ml-4 rounded-lg px-4" Elevation="0">Nueva</MudButton>
    </ToolBarContent>

    <EditButtonContent><span style="display:none;"></span></EditButtonContent>

    <HeaderContent>
        <MudTh Style="text-align: center;">Nombre</MudTh>
        <MudTh Style="text-align: center;">Código</MudTh>
        <MudTh Style="text-align: center;">Estado</MudTh>
        <MudTh Style="width: 120px; text-align: center;">Acciones</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Nombre" Style="text-align: center;">
            <MudText Typo="Typo.body2" Style="font-weight: 600;">@context.Nombre</MudText>
        </MudTd>

        <MudTd DataLabel="Código" Style="text-align: center;">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="force-black-text">@context.Codigo</MudChip>
        </MudTd>

        <MudTd DataLabel="Estado" Style="text-align: center;">
            <MudChip T="string" Color="@(context.Activo? Color.Success: Color.Warning)" Size="Size.Small" Variant="Variant.Filled" Class="rounded">
                @(context.Activo ? "Activa" : "Baja")
            </MudChip>
        </MudTd>

        <MudTd DataLabel="Acciones" Style="text-align: center;">
            <div class="d-flex justify-center">
                @if (context.Activo)
                {
                    <MudTooltip Text="Dar de Baja">
                        <MudIconButton Icon="@Icons.Material.Filled.Block" Color="Color.Warning" Size="Size.Small" OnClick="@(() => AbrirModalBaja(context))" Class="mr-2" />
                    </MudTooltip>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="Color.Default" Style="opacity: 0.3;" Class="mr-2" />
                }

                <MudTooltip Text="Editar">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => _table.SetEditingItem(context))" />
                </MudTooltip>
            </div>
        </MudTd>
    </RowTemplate>

    <RowEditingTemplate>
        <MudTd DataLabel="Nombre"><MudTextField @bind-Value="@context.Nombre" Label="Nombre" Variant="Variant.Text" Class="force-black-text" /></MudTd>
        <MudTd DataLabel="Código"><MudTextField @bind-Value="@context.Codigo" Label="Cód." Variant="Variant.Text" Class="force-black-text" /></MudTd>
        <MudTd DataLabel="Estado"><MudSwitch @bind-Value="@context.Activo" Color="Color.Success" Label="@(context.Activo ? "Act" : "Baj")" /></MudTd>
    </RowEditingTemplate>

    <PagerContent>
        <MudTablePager RowsPerPageString="Filas:"
                       PageSizeOptions="new int[] { 5, 10, 25, 50 }"
                       InfoFormat="{first_item}-{last_item} de {all_items}"
                       Class="force-black-text" />
    </PagerContent>
</MudTable>

@* --- MODAL 1: CREAR --- *@
<MudDialog @bind-Visible="mostrarDialogoCrear" Options="optionsCrear" Class="unified-dialog-card">
    <TitleContent>
        <div class="pa-6 pb-2 d-flex justify-space-between align-center">
            <div>
                <MudText Class="modal-title">Nueva Modalidad</MudText>
                <MudText Typo="Typo.body2" Style="color: #6B7280;">Registra una forma de cursada.</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CerrarModales" Color="Color.Default" />
        </div>
    </TitleContent>
    <DialogContent>
        <div class="px-6 pb-6">
            <EditForm Model="@modalidadModel" OnValidSubmit="GuardarNueva">
                <DataAnnotationsValidator />
                <MudGrid Spacing="2">
                    <MudItem xs="8">
                        <MudTextField Label="Nombre"
                                      Placeholder="Ej: Presencial"
                                      @bind-Value="modalidadModel.Nombre"
                                      For="@(() => modalidadModel.Nombre)"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.SettingsInputAntenna"
                                      Class="force-black-text" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudTextField Label="Código"
                                      Placeholder="Ej: PRES"
                                      @bind-Value="modalidadModel.Codigo"
                                      Variant="Variant.Outlined"
                                      Class="force-black-text" />
                    </MudItem>

                    <MudItem xs="12" Class="d-flex justify-end gap-2 mt-4 pt-4" style="border-top: 1px solid #E5E7EB;">
                        <MudButton OnClick="CerrarModales" Variant="Variant.Text" Color="Color.Default">Cancelar</MudButton>
                        <MudButton OnClick="GuardarNueva" Variant="Variant.Filled" Color="Color.Primary" Class="rounded-lg px-6" Elevation="0">Guardar</MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </div>
    </DialogContent>
</MudDialog>

@* --- MODAL 2: CONFIRMAR BAJA --- *@
<MudDialog @bind-Visible="mostrarDialogoBaja" Options="optionsBaja" Class="unified-dialog-card">
    <DialogContent>
        <div class="pa-4 d-flex flex-column align-center text-center">
            <MudIcon Icon="@Icons.Material.Filled.Block" Color="Color.Warning" Style="font-size: 4rem;" Class="mb-4" />
            <MudText Class="modal-title-warning mb-2">Confirmar Baja</MudText>
            <MudText Typo="Typo.body1" Class="force-black-text mb-4">La modalidad <b>@modalidadParaBaja?.Nombre</b> pasará a inactiva.</MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="px-6 pb-6 d-flex justify-center gap-4" style="width: 100%;">
            <MudButton OnClick="CerrarModales" Variant="Variant.Outlined" Color="Color.Default" Class="rounded-lg">Cancelar</MudButton>
            <MudButton OnClick="ConfirmarBaja" Variant="Variant.Filled" Color="Color.Warning" Class="rounded-lg px-6" Elevation="0">Confirmar</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    private MudTable<ModalidadDTO> _table;

    private List<ModalidadDTO> modalidades = new List<ModalidadDTO>();
    private string searchString = "";
    private string filtroEstado = "Activas";

    private ModalidadDTO modalidadModel = new ModalidadDTO();
    private ModalidadDTO modalidadParaBaja;

    private bool mostrarDialogoCrear = false;
    private bool mostrarDialogoBaja = false;
    private bool loading = true;

    private DialogOptions optionsCrear = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
    private DialogOptions optionsBaja = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = false };

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        loading = true;
        modalidades = await ModalidadService.GetAllAsync();
        loading = false;
    }

    private void CambiarFiltro(string nuevoEstado) { filtroEstado = nuevoEstado; }

    private bool FilterFunc(ModalidadDTO mod)
    {
        bool matchTexto = true;
        if (!string.IsNullOrWhiteSpace(searchString))
        {
            matchTexto = (mod.Nombre?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                         (mod.Codigo?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false);
        }

        bool matchEstado = true;
        switch (filtroEstado)
        {
            case "Activas": matchEstado = mod.Activo; break;
            case "Bajas": matchEstado = !mod.Activo; break;
        }

        return matchTexto && matchEstado;
    }

    private void AbrirModalCrear()
    {
        modalidadModel = new ModalidadDTO { Activo = true };
        mostrarDialogoCrear = true;
    }

    private async Task GuardarNueva()
    {
        if (string.IsNullOrWhiteSpace(modalidadModel.Nombre))
        {
            Snackbar.Add("El nombre es obligatorio", Severity.Warning);
            return;
        }

        var exito = await ModalidadService.CreateAsync(modalidadModel);
        if (exito)
        {
            Snackbar.Add("Modalidad creada", Severity.Success);
            mostrarDialogoCrear = false;
            await CargarDatos();
        }
        else
        {
            Snackbar.Add("Error al crear (posible duplicado)", Severity.Error);
        }
    }

    private void AbrirModalBaja(ModalidadDTO mod)
    {
        modalidadParaBaja = mod;
        mostrarDialogoBaja = true;
    }

    private async Task ConfirmarBaja()
    {
        if (modalidadParaBaja == null) return;
        var exito = await ModalidadService.DeleteAsync(modalidadParaBaja.Id);
        if (exito) { Snackbar.Add("Modalidad dada de baja", Severity.Warning); await CargarDatos(); }
        else { Snackbar.Add("Error al dar de baja", Severity.Error); }
        mostrarDialogoBaja = false;
    }

    private void CerrarModales()
    {
        mostrarDialogoCrear = false;
        mostrarDialogoBaja = false;
    }

    private async void ItemHasBeenCommitted(object element)
    {
        var modEditada = (ModalidadDTO)element;
        var exito = await ModalidadService.UpdateAsync(modEditada);
        if (exito) Snackbar.Add("Actualizado", Severity.Success);
        else { Snackbar.Add("Error al actualizar", Severity.Error); await CargarDatos(); }
    }
}