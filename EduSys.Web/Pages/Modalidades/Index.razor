@page "/modalidades"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@* 🔓 Lectura permitida para consulta general *@
@attribute [Authorize]

@inject IModalidadService ModalidadService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    /* --- ESTILOS ESTÁNDAR EDUSYS --- */
    .table-header-custom .mud-table-head .mud-table-cell {
        color: #456990 !important;
        font-weight: 800 !important;
        background-color: #f8fafc !important;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
    }

    .row-hover-effect:hover {
        background-color: #f1f5f9 !important;
    }

    /* Buscador y Selects consistentes */
    .custom-filter-input .mud-input-outlined-border {
        border-color: #cbd5e1 !important;
        transition: border-color 0.2s;
    }
    
    .custom-filter-input:hover .mud-input-outlined-border {
        border-color: #456990 !important;
    }

    .custom-filter-input.mud-input-control.mud-input-focused .mud-input-outlined-border {
        border-color: #456990 !important;
        border-width: 2px !important;
    }

    .custom-filter-input .mud-input-label {
        color: #456990 !important;
        background-color: white !important;
        padding: 0 5px;
        font-weight: 600;
    }

    /* ✅ FIX PRINCIPAL: texto visible en todos los tipos de input */
    .custom-filter-input input,
    .custom-filter-input textarea,
    .custom-filter-input .mud-select-input,
    .custom-filter-input .mud-input-slot,
    .custom-filter-input .mud-input input,
    .custom-filter-input .mud-input textarea,
    .custom-filter-input .mud-input .mud-select-input {
        color: #1e293b !important;
        font-weight: 600 !important;
        -webkit-text-fill-color: #1e293b !important;
    }

    /* ✅ FIX: Visibilidad de iconos en los inputs (Adornments y Selects) */
    .custom-filter-input .mud-icon-root,
    .custom-filter-input .mud-input-adornment .mud-icon-root,
    .custom-filter-input .mud-select-icon {
        color: #456990 !important;
        opacity: 1 !important;
    }

    /* Botones de Filtro Tipo Segmented Control */
    .filter-group {
        display: flex;
        background-color: #f1f5f9;
        border-radius: 8px;
        padding: 4px;
        border: 1px solid #e2e8f0;
    }

    .filter-btn {
        border-radius: 6px !important;
        text-transform: none !important;
        font-weight: 700 !important;
        padding: 4px 16px !important;
    }

    /* --- MODALES --- */
    .unified-dialog-card {
        background-color: white !important;
        border-radius: 16px !important;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1) !important;
    }

    .dialog-header-integrated {
        background: #456990;
        color: white;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
        border-radius: 16px 16px 0 0;
    }

    .modal-title-warning {
        color: #d97706;
        font-weight: 800;
        font-size: 1.5rem;
        letter-spacing: -0.5px;
    }
</style>

@* OVERLAY DE PROTECCIÓN DURANTE PROCESAMIENTO *@
<MudOverlay Visible="_procesando" DarkBackground="true" Absolute="false" ZIndex="9999">
    <MudStack AlignItems="AlignItems.Center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.h6" Style="color: white; font-weight: 600;">Procesando operación...</MudText>
    </MudStack>
</MudOverlay>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-10">

    @* --- ENCABEZADO DE PÁGINA --- *@
    <div class="d-flex align-center justify-space-between mb-6 flex-wrap gap-4">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 800; color: #456990; letter-spacing: -0.5px;">Gestión de Modalidades</MudText>
            <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Tipos de formato de dictado institucional (Presencial, Virtual, etc.).</MudText>
        </div>
        
        @* 🔒 CANDADO: Crear Modalidad *@
        <AuthorizeView Roles="CFG_PARAMETROS_ACA" Context="crearContext">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Size="Size.Large"
                       Style="font-weight: 700; border-radius: 8px;"
                       OnClick="AbrirModalCrear"
                       Disabled="loading">
                Nueva Modalidad
            </MudButton>
        </AuthorizeView>
    </div>

    @* --- TABLA PRINCIPAL --- *@
    <MudTable @ref="_table"
              Items="@modalidades"
              Hover="true"
              Loading="@loading"
              RowsPerPage="15"
              Filter="new Func<ModalidadDTO, bool>(FilterFunc)"
              Elevation="2"
              Class="rounded-lg table-header-custom overflow-hidden"
              RowClass="row-hover-effect">
        
        <ToolBarContent>
            <div class="d-flex flex-wrap align-center gap-4 w-100 mb-2">
                <div class="filter-group">
                    <MudButton OnClick="@(() => CambiarFiltro("Todos"))" Variant="@(filtroEstado == "Todos" ? Variant.Filled : Variant.Text)" Color="@(filtroEstado == "Todos" ? Color.Primary : Color.Default)" Size="Size.Small" Class="filter-btn" DisableElevation="true">Todas</MudButton>
                    <MudButton OnClick="@(() => CambiarFiltro("Activas"))" Variant="@(filtroEstado == "Activas" ? Variant.Filled : Variant.Text)" Color="@(filtroEstado == "Activas" ? Color.Success : Color.Default)" Size="Size.Small" Class="filter-btn" DisableElevation="true">Activas</MudButton>
                    <MudButton OnClick="@(() => CambiarFiltro("Bajas"))" Variant="@(filtroEstado == "Bajas" ? Variant.Filled : Variant.Text)" Color="@(filtroEstado == "Bajas" ? Color.Error : Color.Default)" Size="Size.Small" Class="filter-btn" DisableElevation="true">Bajas</MudButton>
                </div>

                <MudSpacer />

                <MudTextField @bind-Value="searchString"
                              Placeholder="Buscar por nombre o código..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Primary"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="custom-filter-input mt-0"
                              Style="min-width: 280px; background-color: white; border-radius: 8px;"
                              Immediate="true"
                              DebounceInterval="300"
                              Clearable="true" />
            </div>
        </ToolBarContent>

        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<ModalidadDTO, object>(x => x.Nombre ?? string.Empty)">Nombre de Modalidad</MudTableSortLabel></MudTh>
            <MudTh Style="text-align: center;"><MudTableSortLabel SortBy="new Func<ModalidadDTO, object>(x => x.Codigo ?? string.Empty)">Código</MudTableSortLabel></MudTh>
            <MudTh Style="text-align: center;">Estado</MudTh>
            <MudTh Style="width: 120px; text-align: center;">Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Nombre">
                <MudText Typo="Typo.body2" Style="font-weight: 700; color: #1e293b;">@context.Nombre</MudText>
            </MudTd>

            <MudTd DataLabel="Código" Style="text-align: center;">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Class="ma-0" Style="font-weight: 700; letter-spacing: 0.5px;">@context.Codigo</MudChip>
            </MudTd>

            <MudTd DataLabel="Estado" Style="text-align: center;">
                @if (context.Activo)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined" Style="font-weight: 700;">ACTIVA</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined" Style="font-weight: 700;">INACTIVA</MudChip>
                }
            </MudTd>

            <MudTd DataLabel="Acciones" Style="text-align: center;">
                <div class="d-flex justify-center gap-1">
                    @* 🔒 CANDADO: Editar y Baja de Modalidad *@
                    <AuthorizeView Roles="CFG_PARAMETROS_ACA" Context="abmContext">
                        <Authorized>
                            <MudTooltip Text="Editar">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => AbrirModalEditar(context))" Disabled="_procesando" />
                            </MudTooltip>
                            @if (context.Activo)
                            {
                                <MudTooltip Text="Dar de Baja">
                                    <MudIconButton Icon="@Icons.Material.Filled.Block" Color="Color.Warning" Size="Size.Small" OnClick="@(() => AbrirModalBaja(context))" Disabled="_procesando" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="Color.Default" Disabled="true" Style="opacity: 0.3;" />
                            }
                        </Authorized>
                        <NotAuthorized>
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="color: #cbd5e1;" />
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager RowsPerPageString="Filas:" InfoFormat="{first_item}-{last_item} de {all_items}" />
        </PagerContent>
    </MudTable>
</MudContainer>

@* --- MODAL 1: CREAR / EDITAR MODALIDAD --- *@
<MudDialog @bind-Visible="mostrarDialogoCrear" Options="optionsCrear" Class="unified-dialog-card pa-0">
    <DialogContent>
        <div class="dialog-header-integrated">
            <div class="d-flex align-center">
                <MudIcon Icon="@(esEdicion ? Icons.Material.Filled.Edit : Icons.Material.Filled.AddBox)" Class="mr-3" />
                <MudText Typo="Typo.h6" Style="font-weight: 700; letter-spacing: -0.5px;">
                    @(esEdicion ? "Modificar Modalidad" : "Nueva Modalidad")
                </MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="CerrarModales" Size="Size.Small" Disabled="_procesando" />
        </div>
        <div class="pa-6" style="background-color: #f8fafc;">
            <MudForm @ref="_form" Model="modalidadModel">
                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="modalidadModel.Nombre" Label="Nombre de Modalidad (Ej: Presencial, Virtual)" Required="true" RequiredError="Debe indicar el nombre" Variant="Variant.Outlined" Class="custom-filter-input bg-white" Disabled="_procesando" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="modalidadModel.Codigo" Label="Código (Ej: PRE, VIR)" Required="true" RequiredError="Debe indicar un código" Variant="Variant.Outlined" Class="custom-filter-input bg-white" Disabled="_procesando" />
                    </MudItem>
                    @if (esEdicion)
                    {
                        <MudItem xs="12">
                            <MudSwitch @bind-Value="modalidadModel.Activo" Color="Color.Success" Label="Estado Activo" Class="font-weight-bold" Disabled="_procesando" />
                        </MudItem>
                    }
                </MudGrid>
            </MudForm>
        </div>
        <div class="d-flex justify-end gap-3 pa-4 border-t border-solid" style="background-color: #f1f5f9; border-color: #e2e8f0; border-radius: 0 0 16px 16px;">
            <MudButton OnClick="CerrarModales" Variant="Variant.Outlined" Color="Color.Default" Class="rounded-lg font-weight-bold px-4" Disabled="_procesando">Cancelar</MudButton>
            <MudButton OnClick="GuardarCambios" Variant="Variant.Filled" Color="Color.Primary" Class="rounded-lg font-weight-bold px-6" Disabled="_procesando">Guardar</MudButton>
        </div>
    </DialogContent>
</MudDialog>

@* --- MODAL 2: CONFIRMAR BAJA --- *@
<MudDialog @bind-Visible="mostrarDialogoBaja" Options="optionsBaja" Class="unified-dialog-card pb-2">
    <DialogContent>
        <div class="pa-4 d-flex flex-column align-center text-center">
            <div style="background-color: #fffbeb; padding: 16px; border-radius: 50%; margin-bottom: 16px;">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Style="font-size: 3rem;" />
            </div>
            <MudText Class="modal-title-warning mb-2">Desactivar Modalidad</MudText>
            <MudText Typo="Typo.body1" Style="color: #334155; font-weight: 600;" Class="mb-2">
                ¿Seguro que deseas dar de baja <b>@modalidadParaBaja?.Nombre</b>?
            </MudText>
            <MudText Typo="Typo.caption" Style="color: #64748b; line-height: 1.4;">
                No se mostrará más como opción activa, pero se conservará el histórico en carreras vigentes.
            </MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="px-4 pb-4 d-flex justify-center gap-3 w-100">
            <MudButton OnClick="CerrarModales" Variant="Variant.Outlined" Color="Color.Default" Class="rounded-lg font-weight-bold" Disabled="_procesando">Cancelar</MudButton>
            <MudButton OnClick="ConfirmarBaja" Variant="Variant.Filled" Color="Color.Warning" Class="rounded-lg font-weight-bold px-6" Disabled="_procesando">
                Desactivar
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    private MudTable<ModalidadDTO> _table = null!;
    private MudForm _form = null!;
    private List<ModalidadDTO> modalidades = new();

    private string searchString = "";
    private string filtroEstado = "Activas";

    private bool loading = true;
    private bool _procesando = false;

    private ModalidadDTO modalidadModel = new();
    private bool esEdicion = false;
    private bool mostrarDialogoCrear = false;

    private ModalidadDTO? modalidadParaBaja;
    private bool mostrarDialogoBaja = false;

    private DialogOptions optionsCrear = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseButton = false, NoHeader = true };
    private DialogOptions optionsBaja = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, BackdropClick = false, CloseButton = false, NoHeader = true };

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarDatos()
    {
        loading = true;
        try
        {
            modalidades = await ModalidadService.GetAllAsync();
        }
        catch { Snackbar.Add("Error al cargar modalidades.", Severity.Error); }
        finally { loading = false; StateHasChanged(); }
    }

    private void CambiarFiltro(string nuevoEstado) { filtroEstado = nuevoEstado; StateHasChanged(); }

    private bool FilterFunc(ModalidadDTO mod)
    {
        bool matchEstado = filtroEstado switch { "Activas" => mod.Activo, "Bajas" => !mod.Activo, _ => true };
        if (!matchEstado) return false;

        if (!string.IsNullOrWhiteSpace(searchString))
        {
            var term = searchString.Trim().ToLower();
            return (mod.Nombre?.ToLower().Contains(term) ?? false) || (mod.Codigo?.ToLower().Contains(term) ?? false);
        }
        return true;
    }

    private void AbrirModalCrear() { modalidadModel = new ModalidadDTO { Activo = true }; esEdicion = false; mostrarDialogoCrear = true; }

    private void AbrirModalEditar(ModalidadDTO item)
    {
        modalidadModel = new ModalidadDTO { Id = item.Id, Nombre = item.Nombre, Codigo = item.Codigo, Activo = item.Activo };
        esEdicion = true; mostrarDialogoCrear = true;
    }

    private async Task GuardarCambios()
    {
        await _form.Validate();
        if (!_form.IsValid) return;
        _procesando = true;
        try
        {
            bool exito = esEdicion ? await ModalidadService.UpdateAsync(modalidadModel) : await ModalidadService.CreateAsync(modalidadModel);
            if (exito)
            {
                Snackbar.Add("Cambios guardados.", Severity.Success);
                mostrarDialogoCrear = false; await CargarDatos();
            }
        }
        finally { _procesando = false; StateHasChanged(); }
    }

    private void AbrirModalBaja(ModalidadDTO mod) { modalidadParaBaja = mod; mostrarDialogoBaja = true; }

    private async Task ConfirmarBaja()
    {
        if (modalidadParaBaja == null) return;
        _procesando = true;
        try
        {
            if (await ModalidadService.DeleteAsync(modalidadParaBaja.Id))
            {
                Snackbar.Add("Inhabilitada correctamente.", Severity.Warning);
                await CargarDatos();
            }
        }
        finally { _procesando = false; mostrarDialogoBaja = false; StateHasChanged(); }
    }

    private void CerrarModales() { if (!_procesando) { mostrarDialogoCrear = false; mostrarDialogoBaja = false; } }
}