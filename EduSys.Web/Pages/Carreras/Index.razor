@page "/carreras"
@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces

@inject ICarreraService CarreraService
@inject ISedeService SedeService
@inject IModalidadService ModalidadService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    /* --- ESTILOS ESTÁNDAR EDUSYS --- */
    .table-header-custom .mud-table-head .mud-table-cell {
        color: #456990 !important;
        font-weight: 800 !important;
        background-color: #f8fafc !important;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
    }

    .row-hover-effect:hover {
        background-color: #f1f5f9 !important;
    }

    /* Buscador y Selects consistentes - FIX VISIBILIDAD */
    .custom-filter-input .mud-input-outlined-border {
        border-color: #cbd5e1 !important;
        transition: border-color 0.2s;
    }
    
    .custom-filter-input:hover .mud-input-outlined-border {
        border-color: #456990 !important;
    }

    .custom-filter-input.mud-input-control.mud-input-focused .mud-input-outlined-border {
        border-color: #456990 !important;
        border-width: 2px !important;
    }

    /* Asegura que el Label sea visible y tenga fondo blanco para no chocar con el borde */
    .custom-filter-input .mud-input-label {
        color: #456990 !important;
        background-color: white !important;
        padding: 0 8px !important;
        font-weight: 600 !important;
    }

    /* FIX: Asegura que el texto ingresado sea negro y el placeholder gris oscuro */
    .custom-filter-input input,
    .custom-filter-input .mud-select-input,
    .custom-filter-input textarea {
        color: #1e293b !important; /* Texto principal */
        font-weight: 500 !important;
        -webkit-text-fill-color: #1e293b !important;
    }

        .custom-filter-input input::placeholder {
            color: #94a3b8 !important; /* Color del placeholder visible */
            opacity: 1 !important;
        }

    /* Fix para los iconos (Adornments) */
    .custom-filter-input .mud-input-adornment .mud-icon-root {
        color: #456990 !important;
    }

    /* --- MODALES --- */
    .unified-dialog-card {
        background-color: white !important;
        border-radius: 16px !important;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1) !important;
    }

    .dialog-header-integrated {
        background: #456990;
        color: white;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
        border-radius: 16px 16px 0 0;
    }

    .modal-title-warning {
        color: #d97706;
        font-weight: 800;
        font-size: 1.5rem;
        letter-spacing: -0.5px;
    }

    /* Botones de Filtro Tipo Segmented Control */
    .filter-group {
        display: flex;
        background-color: #f1f5f9;
        border-radius: 8px;
        padding: 4px;
        border: 1px solid #e2e8f0;
    }

    .filter-btn {
        border-radius: 6px !important;
        text-transform: none !important;
        font-weight: 700 !important;
        padding: 4px 16px !important;
    }
</style>

@* OVERLAY DE PROTECCIÓN DURANTE PROCESAMIENTO *@
<MudOverlay Visible="_procesando" DarkBackground="true" Absolute="false" ZIndex="9999">
    <MudStack AlignItems="AlignItems.Center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.h6" Style="color: white; font-weight: 600;">Procesando operación...</MudText>
    </MudStack>
</MudOverlay>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-10">

    @* --- ENCABEZADO DE PÁGINA --- *@
    <div class="d-flex align-center justify-space-between mb-6 flex-wrap gap-4">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 800; color: #456990; letter-spacing: -0.5px;">Gestión de Carreras</MudText>
            <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Administración de la oferta académica, modalidades y sedes.</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Size="Size.Large"
                   Style="font-weight: 700; border-radius: 8px;"
                   OnClick="AbrirModalCrear"
                   Disabled="loading">
            Nueva Carrera
        </MudButton>
    </div>

    @* --- TABLA PRINCIPAL --- *@
    <MudTable @ref="_table"
              Items="@carreras"
              Hover="true"
              Loading="@loading"
              RowsPerPage="10"
              Filter="new Func<CarreraDTO, bool>(FilterFunc)"
              Elevation="2"
              Class="rounded-lg table-header-custom overflow-hidden"
              RowClass="row-hover-effect">
        
        <ToolBarContent>
            @* ZONA DE FILTROS OPTIMIZADA *@
            <div class="d-flex flex-wrap align-center gap-4 w-100 mb-2">
                
                @* 1. Filtro Estado *@
                <div class="filter-group">
                    <MudButton OnClick="@(() => CambiarFiltro("Todos"))" Variant="@(filtroEstado == "Todos" ? Variant.Filled : Variant.Text)" Color="@(filtroEstado == "Todos" ? Color.Primary : Color.Default)" Size="Size.Small" Class="filter-btn" DisableElevation="true">Todos</MudButton>
                    <MudButton OnClick="@(() => CambiarFiltro("Activas"))" Variant="@(filtroEstado == "Activas" ? Variant.Filled : Variant.Text)" Color="@(filtroEstado == "Activas" ? Color.Success : Color.Default)" Size="Size.Small" Class="filter-btn" DisableElevation="true">Activas</MudButton>
                    <MudButton OnClick="@(() => CambiarFiltro("Bajas"))" Variant="@(filtroEstado == "Bajas" ? Variant.Filled : Variant.Text)" Color="@(filtroEstado == "Bajas" ? Color.Error : Color.Default)" Size="Size.Small" Class="filter-btn" DisableElevation="true">Bajas</MudButton>
                </div>

                @* 2. Filtro Sede *@
                <MudSelect T="string" @bind-Value="filtroSede" Placeholder="Filtrar por Sede..." Clearable="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Class="custom-filter-input" Style="min-width: 180px;">
                    @foreach (var s in listasSedesFiltro)
                    {
                        <MudSelectItem Value="@s.Nombre">@s.Nombre</MudSelectItem>
                    }
                </MudSelect>

                @* 3. Filtro Modalidad *@
                <MudSelect T="string" @bind-Value="filtroModalidad" Placeholder="Filtrar por Modalidad..." Clearable="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Class="custom-filter-input" Style="min-width: 180px;">
                    @foreach (var m in listasModalidadesFiltro)
                    {
                        <MudSelectItem Value="@m.Nombre">@m.Nombre</MudSelectItem>
                    }
                </MudSelect>

                <MudSpacer />

                @* 4. Buscador Ajustado *@
                <MudTextField @bind-Value="searchString"
                              Placeholder="Buscar carrera, título..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              AdornmentColor="Color.Primary"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="custom-filter-input mt-0"
                              Style="min-width: 250px; background-color: white; border-radius: 8px;"
                              Immediate="true"
                              DebounceInterval="300"
                              Clearable="true" />
            </div>
        </ToolBarContent>

        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<CarreraDTO, object>(x => x.Nombre)">Nombre</MudTableSortLabel></MudTh>
            <MudTh>Título</MudTh>
            <MudTh Style="text-align: center;">Res. Min.</MudTh>
            <MudTh Style="text-align: center;">Modalidad</MudTh>
            <MudTh Style="text-align: center;"><MudTableSortLabel SortBy="new Func<CarreraDTO, object>(x => x.DuracionAnios)">Duración</MudTableSortLabel></MudTh>
            <MudTh Style="text-align: center;">Estado</MudTh>
            <MudTh Style="text-align: center;">Sedes</MudTh>
            <MudTh Style="text-align: center;">Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Nombre"><MudText Typo="Typo.body2" Style="font-weight: 700; color: #1e293b;">@context.Nombre</MudText></MudTd>
            <MudTd DataLabel="Título"><MudText Typo="Typo.body2" Style="color: #475569;">@context.Titulo</MudText></MudTd>
            <MudTd DataLabel="Resolución" Style="text-align: center;">
                <MudText Typo="Typo.caption" Style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-weight: 600; color: #64748b;">
                    @(string.IsNullOrWhiteSpace(context.ResolucionMinisterial) ? "N/A" : context.ResolucionMinisterial)
                </MudText>
            </MudTd>
            <MudTd DataLabel="Modalidad" Style="text-align: center;">
                @if (context.Modalidades != null && context.Modalidades.Any())
                {
                    <div class="d-flex flex-wrap justify-center gap-1">
                        @foreach (var mod in context.Modalidades)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="ma-0" Style="font-size: 0.7rem; font-weight: 700;">@mod</MudChip>
                        }
                    </div>
                }
            </MudTd>
            <MudTd DataLabel="Duración" Style="text-align: center;"><MudText Typo="Typo.body2" Style="font-weight: 600;">@context.DuracionAnios años</MudText></MudTd>
            <MudTd DataLabel="Estado" Style="text-align: center;">
                @if (context.Activo)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined" Style="font-weight: 700;">ACTIVA</MudChip>
                }
                else
                {

                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Outlined" Style="font-weight: 700;">INACTIVA</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Sedes" Style="text-align: center;">
                @if (context.NombresSedes != null && context.NombresSedes.Any())
                {
                    <MudTooltip Text="@string.Join(", ", context.NombresSedes)">
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled" Style="font-weight: 600;">@context.NombresSedes.Count Sede(s)</MudChip>
                    </MudTooltip>
                }
            </MudTd>
            <MudTd DataLabel="Acciones" Style="text-align: center;">
                <div class="d-flex justify-center gap-1">
                    <MudIconButton Icon="@Icons.Material.Filled.AddLocationAlt" Color="Color.Tertiary" Size="Size.Small" OnClick="@(() => AbrirModalSedes(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => AbrirEditar(context))" />
                    @if (context.Activo)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Block" Color="Color.Error" Size="Size.Small" OnClick="@(() => AbrirModalBaja(context))" />
                    }
                </div>
            </MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página:" />
        </PagerContent>
    </MudTable>
</MudContainer>

@* --- MODALES --- *@
<MudDialog @bind-Visible="mostrarDialogoCrear" Options="optionsCrear" Class="unified-dialog-card pa-0">
    <DialogContent>
        <div class="dialog-header-integrated">
            <div class="d-flex align-center">
                <MudIcon Icon="@(esEdicion? Icons.Material.Filled.Edit : Icons.Material.Filled.AddBox)" Class="mr-3" />
                <MudText Typo="Typo.h6" Style="font-weight: 700;">@(esEdicion ? "Editar Carrera" : "Nueva Carrera")</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="CerrarModales" Size="Size.Small" />
        </div>
        <div class="pa-6">
            <MudForm @ref="_form">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudTextField Label="Nombre Oficial" @bind-Value="carreraModel.Nombre" For="@(() => carreraModel.Nombre)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="custom-filter-input" Required="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField Label="Título a Otorgar" @bind-Value="carreraModel.Titulo" For="@(() => carreraModel.Titulo)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="custom-filter-input" Required="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTextField Label="Resolución" @bind-Value="carreraModel.ResolucionMinisterial" Variant="Variant.Outlined" Margin="Margin.Dense" Class="custom-filter-input" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField Label="Duración (Años)" @bind-Value="carreraModel.DuracionAnios" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" Class="custom-filter-input" Required="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudSelect T="int" Label="Modalidades" MultiSelection="true" @bind-SelectedValues="modalidadesSeleccionadasIds" Variant="Variant.Outlined" Margin="Margin.Dense" Class="custom-filter-input" ToStringFunc="@(id => listaModalidadesBD.FirstOrDefault(x => x.Id == id)?.Nombre)">
                            @foreach (var mod in listaModalidadesBD)
                            {
                                <MudSelectItem T="int" Value="@mod.Id">@mod.Nombre</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField Label="Descripción" @bind-Value="carreraModel.Descripcion" Variant="Variant.Outlined" Lines="3" Class="custom-filter-input" />
                    </MudItem>
                </MudGrid>
            </MudForm>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="px-6 pb-6 d-flex justify-end gap-3 w-100">
            <MudButton OnClick="CerrarModales" Variant="Variant.Outlined">Cancelar</MudButton>
            <MudButton OnClick="GuardarCambios" Variant="Variant.Filled" Color="Color.Primary">@((esEdicion ? "Guardar Cambios" : "Crear Carrera"))</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@* --- MODAL BAJA --- *@
<MudDialog @bind-Visible="mostrarDialogoBaja" Options="optionsBaja" Class="unified-dialog-card">
    <DialogContent>
        <div class="pa-4 text-center">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Style="font-size: 3rem;" />
            <MudText Class="modal-title-warning">Confirmar Baja</MudText>
            <MudText Typo="Typo.body1">¿Desea dar de baja <b>@carreraParaBaja?.Nombre</b>?</MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="px-4 pb-4 d-flex justify-center gap-3 w-100">
            <MudButton OnClick="CerrarModales">Cancelar</MudButton>
            <MudButton OnClick="ConfirmarBaja" Variant="Variant.Filled" Color="Color.Warning">Confirmar</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@* --- MODAL SEDES --- *@
<MudDialog @bind-Visible="mostrarDialogoSedes" Options="optionsCrear" Class="unified-dialog-card pa-0">
    <DialogContent>
        <div class="dialog-header-integrated">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.Map" Class="mr-3" />
                <MudText Typo="Typo.h6">Asignación de Sedes</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="CerrarModales" />
        </div>
        <div class="pa-6">
            <MudGrid>
                @foreach (var sede in listaSedesDisponibles)
                {
                    <MudItem xs="12" sm="6">
                        <div class="pa-2 rounded-lg border">
                            <MudCheckBox T="bool" Value="@sedesSeleccionadas.Contains(sede.Id)" ValueChanged="@((bool c) => ToggleSede(sede.Id, c))" Label="@sede.Nombre" Color="Color.Primary" />
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="px-6 pb-6 d-flex justify-end gap-3 w-100">
            <MudButton OnClick="CerrarModales">Cancelar</MudButton>
            <MudButton OnClick="GuardarSedes" Variant="Variant.Filled" Color="Color.Primary">Guardar</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    private MudTable<CarreraDTO> _table = null!;
    private MudForm _form = null!;
    private List<CarreraDTO> carreras = new();
    private string searchString = "";
    private string filtroEstado = "Activas";
    private string? filtroSede = null;
    private string? filtroModalidad = null;
    private List<SedeDTO> listasSedesFiltro = new();
    private List<ModalidadDTO> listasModalidadesFiltro = new();
    private CarreraDTO carreraModel = new();
    private bool esEdicion = false;
    private List<ModalidadDTO> listaModalidadesBD = new();
    private IEnumerable<int> modalidadesSeleccionadasIds { get; set; } = new HashSet<int>();
    private bool mostrarDialogoCrear = false;
    private bool mostrarDialogoBaja = false;
    private bool mostrarDialogoSedes = false;
    private CarreraDTO? carreraParaBaja;
    private bool loading = true;
    private bool _procesando = false;
    private string carreraSeleccionadaNombre = "";
    private int carreraSeleccionadaId = 0;
    private List<SedeDTO> listaSedesDisponibles = new();
    private HashSet<int> sedesSeleccionadas = new();
    private DialogOptions optionsCrear = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };
    private DialogOptions optionsBaja = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarCarreras(), CargarListasFiltro());
    }

    private async Task CargarListasFiltro()
    {
        listasSedesFiltro = await SedeService.GetAllAsync();
        listasModalidadesFiltro = await ModalidadService.GetAllAsync();
    }

    private async Task CargarCarreras()
    {
        loading = true;
        try { carreras = await CarreraService.GetAllAsync(); }
        catch { Snackbar.Add("Error de carga", Severity.Error); }
        finally { loading = false; }
    }

    private void CambiarFiltro(string nuevo) { filtroEstado = nuevo; StateHasChanged(); }

    private bool FilterFunc(CarreraDTO c)
    {
        if (!string.IsNullOrEmpty(filtroSede) && !(c.NombresSedes?.Contains(filtroSede) ?? false)) return false;
        if (!string.IsNullOrEmpty(filtroModalidad) && !(c.Modalidades?.Contains(filtroModalidad) ?? false)) return false;
        if (!string.IsNullOrWhiteSpace(searchString))
        {
            var t = searchString.ToLower();
            if (!(c.Nombre?.ToLower().Contains(t) ?? false) && !(c.Titulo?.ToLower().Contains(t) ?? false)) return false;
        }
        return filtroEstado switch { "Activas" => c.Activo, "Bajas" => !c.Activo, _ => true };
    }

    private async Task AbrirModalCrear()
    {
        carreraModel = new CarreraDTO { Activo = true, DuracionAnios = 4 };
        listaModalidadesBD = await ModalidadService.GetAllAsync();
        modalidadesSeleccionadasIds = new HashSet<int>();
        esEdicion = false;
        mostrarDialogoCrear = true;
    }

    private async Task AbrirEditar(CarreraDTO item)
    {
        carreraModel = new CarreraDTO { Id = item.Id, Nombre = item.Nombre, Titulo = item.Titulo, DuracionAnios = item.DuracionAnios, Activo = item.Activo, ResolucionMinisterial = item.ResolucionMinisterial, Descripcion = item.Descripcion };
        listaModalidadesBD = await ModalidadService.GetAllAsync();
        modalidadesSeleccionadasIds = new HashSet<int>(await CarreraService.GetModalidadesIdsAsync(item.Id));
        esEdicion = true;
        mostrarDialogoCrear = true;
    }

    private async Task GuardarCambios()
    {
        await _form.Validate();
        if (!_form.IsValid || !modalidadesSeleccionadasIds.Any()) { if (!modalidadesSeleccionadasIds.Any()) Snackbar.Add("Seleccione modalidad", Severity.Warning); return; }
        _procesando = true;
        try
        {
            string err = esEdicion ? await CarreraService.UpdateAsync(carreraModel) : await CarreraService.CreateAsync(carreraModel);
            if (string.IsNullOrEmpty(err))
            {
                int id = esEdicion ? carreraModel.Id : (await CarreraService.GetAllAsync()).OrderByDescending(x => x.Id).First().Id;
                await CarreraService.ActualizarModalidadesAsync(id, modalidadesSeleccionadasIds.ToList());
                Snackbar.Add("Éxito", Severity.Success);
                mostrarDialogoCrear = false;
                await CargarCarreras();
            }
            else Snackbar.Add(err, Severity.Error);
        }
        finally { _procesando = false; }
    }

    private void AbrirModalBaja(CarreraDTO c) { carreraParaBaja = c; mostrarDialogoBaja = true; }

    private async Task ConfirmarBaja()
    {
        _procesando = true;
        try { if (await CarreraService.DeleteAsync(carreraParaBaja!.Id)) { Snackbar.Add("Baja ok", Severity.Warning); await CargarCarreras(); } }
        finally { _procesando = false; mostrarDialogoBaja = false; }
    }

    private async Task AbrirModalSedes(CarreraDTO c)
    {
        carreraSeleccionadaId = c.Id;
        carreraSeleccionadaNombre = c.Nombre!;
        listaSedesDisponibles = await SedeService.GetAllAsync();
        sedesSeleccionadas = new HashSet<int>(await CarreraService.GetSedesIdsAsync(c.Id));
        mostrarDialogoSedes = true;
    }

    private void ToggleSede(int id, bool check) { if (check) sedesSeleccionadas.Add(id); else sedesSeleccionadas.Remove(id); }

    private async Task GuardarSedes()
    {
        _procesando = true;
        try { if (await CarreraService.ActualizarSedesAsync(carreraSeleccionadaId, sedesSeleccionadas.ToList())) { Snackbar.Add("Sedes ok", Severity.Success); mostrarDialogoSedes = false; await CargarCarreras(); } }
        finally { _procesando = false; }
    }

    private void CerrarModales() { if (!_procesando) { mostrarDialogoCrear = false; mostrarDialogoBaja = false; mostrarDialogoSedes = false; } }
}