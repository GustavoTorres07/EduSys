@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces

@inject IPeriodoService PeriodoService
@inject ICarreraService CarreraService
@inject ISedeService SedeService
@inject ISnackbar Snackbar

<style>
    /* --- ESTILOS CORPORATIVOS --- */
    .mud-dialog-close-icon {
        display: none !important;
    }

    .mud-dialog-content {
        padding: 0 !important;
    }

    .dialog-container {
        display: flex;
        flex-direction: column;
        background-color: white;
        max-height: 85vh;
        min-width: 600px;
    }

    /* HEADER AZUL CONSISTENTE */
    .dialog-header-integrated {
        background: #456990;
        color: white;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }

    .dialog-body {
        padding: 24px;
        overflow-y: auto;
        flex-grow: 1;
    }

    .actions-footer {
        padding: 16px 24px;
        border-top: 1px solid #e2e8f0;
        background-color: #f8fafc;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        flex-shrink: 0;
    }

    /* --- ESTILOS FORZADOS DE INPUTS --- */
    .force-black-text input,
    .force-black-text .mud-input-slot,
    .force-black-text .mud-select-input {
        color: #1e293b !important;
        font-weight: 500;
        -webkit-text-fill-color: #1e293b !important;
    }

    .force-black-text .mud-input-label {
        color: #456990 !important;
        background-color: white !important;
        padding: 0 5px;
        font-weight: 600;
    }

    .force-black-text .mud-input-outlined-border {
        border-color: #cbd5e1 !important;
        transition: border-color 0.2s;
    }

    .force-black-text:hover .mud-input-outlined-border {
        border-color: #456990 !important;
    }

    .force-black-text.mud-input-control.mud-input-focused .mud-input-outlined-border {
        border-color: #456990 !important;
        border-width: 2px !important;
    }

    .force-black-text .mud-icon-root {
        color: #456990 !important;
    }

    .section-title {
        color: #456990;
        font-weight: 800;
        font-size: 0.85rem;
        text-transform: uppercase;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 6px;
        margin-bottom: 16px;
        margin-top: 16px;
        letter-spacing: 0.5px;
    }

    .info-alert {
        background-color: #f0f9ff;
        border-left: 4px solid #0284c7;
        padding: 12px 16px;
        border-radius: 4px;
        margin-bottom: 16px;
    }
</style>

<MudDialog DisableSidePadding="true" Class="rounded-lg overflow-hidden">
    <DialogContent>
        <div class="dialog-container">

            @* --- CABECERA --- *@
            <div class="dialog-header-integrated">
                <div class="d-flex align-center">
                    <MudIcon Icon="@(Ventana.Id == 0 ? Icons.Material.Filled.EventNote : Icons.Material.Filled.EditCalendar)" Class="mr-3" />
                    <div>
                        <MudText Typo="Typo.h6" Style="font-weight: 700; line-height: 1.2; letter-spacing: -0.5px;">
                            @(Ventana.Id == 0 ? "Nueva Regla Operativa" : "Editar Regla de Calendario")
                        </MudText>
                        <MudText Typo="Typo.caption" Style="opacity: 0.9;">Configuración de ventanas de inscripción</MudText>
                    </div>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="Cancel" Size="Size.Small" Disabled="_procesando" />
            </div>

            @* --- CUERPO --- *@
            <div class="dialog-body">
                @if (loading)
                {
                    <MudGrid Spacing="2">
                        <MudItem xs="12"><MudSkeleton Height="30px" Width="40%" /></MudItem>
                        <MudItem xs="6"><MudSkeleton Height="60px" /></MudItem>
                        <MudItem xs="6"><MudSkeleton Height="60px" /></MudItem>
                        <MudItem xs="12"><MudSkeleton Height="30px" Width="40%" Class="mt-4" /></MudItem>
                        <MudItem xs="6"><MudSkeleton Height="60px" /></MudItem>
                        <MudItem xs="6"><MudSkeleton Height="60px" /></MudItem>
                    </MudGrid>
                }
                else
                {
                    <MudForm @ref="form" Model="@modelo">
                        <MudGrid Spacing="2">

                            @* 1. CONFIGURACIÓN *@
                            <MudItem xs="12"><div class="section-title mt-0">Configuración General</div></MudItem>

                            <MudItem xs="12" sm="6">
                                <MudSelect T="int" Label="Ciclo Lectivo Base" @bind-Value="modelo.IdPeriodo"
                                           Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                                           Class="force-black-text" Required="true" Disabled="_procesando">
                                    @foreach (var p in periodos)
                                    {
                                        <MudSelectItem Value="@p.Id">@p.Nombre (@(p.FechaInicio?.Year.ToString() ?? "S/F"))</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" Label="Tipo de Acción" @bind-Value="modelo.TipoAccion"
                                           Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                                           Class="force-black-text" Required="true" Disabled="_procesando">
                                    <MudSelectItem Value="@("INSCRIPCION_CURSADA")">Inscripción a Cursadas</MudSelectItem>
                                    <MudSelectItem Value="@("INSCRIPCION_FINAL")">Inscripción a Finales</MudSelectItem>
                                    <MudSelectItem Value="@("INSCRIPCION_INGRESO")">Solicitud de Ingreso</MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            @* 2. VIGENCIA *@
                            <MudItem xs="12"><div class="section-title">Vigencia de la Regla</div></MudItem>

                            <MudItem xs="6">
                                <MudDatePicker Label="Fecha Inicio" @bind-Date="fechaInicioTemp"
                                               Variant="Variant.Outlined" DateFormat="dd/MM/yyyy"
                                               Class="force-black-text" Required="true" Disabled="_procesando" />
                            </MudItem>
                            
                            <MudItem xs="6">
                                <MudDatePicker Label="Fecha Fin" @bind-Date="fechaFinTemp"
                                               Variant="Variant.Outlined" DateFormat="dd/MM/yyyy"
                                               Class="force-black-text" Required="true" Disabled="_procesando" />
                            </MudItem>

                            @* 3. ALCANCE *@
                            <MudItem xs="12"><div class="section-title">Alcance (Filtros Opcionales)</div></MudItem>

                            <MudItem xs="12">
                                <div class="info-alert">
                                    <div class="d-flex align-start gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="color: #0284c7; margin-top: 2px;" />
                                        <MudText Typo="Typo.caption" Style="color: #0369a1; font-weight: 600; line-height: 1.4;">
                                            Si dejas estos campos vacíos, la regla aplicará de manera <b>Global</b> a toda la universidad. Selecciona una carrera o sede solo si deseas restringir esta ventana.
                                        </MudText>
                                    </div>
                                </div>
                            </MudItem>

                            <MudItem xs="6">
                                <MudSelect T="int?" Label="Carrera Específica" @bind-Value="modelo.IdCarrera" Clearable="true"
                                           Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                                           Class="force-black-text" Disabled="_procesando">
                                    <MudSelectItem T="int?" Value="null">-- Global (Todas) --</MudSelectItem>
                                    @foreach (var c in carreras)
                                    {
                                        <MudSelectItem T="int?" Value="@c.Id">@c.Nombre</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="6">
                                <MudSelect T="int?" Label="Sede Específica" @bind-Value="modelo.IdSede" Clearable="true"
                                           Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter"
                                           Class="force-black-text" Disabled="_procesando">
                                    <MudSelectItem T="int?" Value="null">-- Global (Todas) --</MudSelectItem>
                                    @foreach (var s in sedes)
                                    {
                                        <MudSelectItem T="int?" Value="@s.Id">@s.Nombre</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                        </MudGrid>
                    </MudForm>
                }
            </div>

            @* --- FOOTER --- *@
            <div class="actions-footer">
                <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Default" Class="rounded-lg font-weight-bold" Disabled="_procesando">Cancelar</MudButton>
                <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary" Class="rounded-lg font-weight-bold px-6" Disabled="_procesando">
                    @if (_procesando)
                    {
                        <MudProgressCircular Class="ms-n1 mr-2" Size="Size.Small" Indeterminate="true" Color="Color.Surface" />
                        <span>GUARDANDO...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Save" Class="mr-2" />
                        <span>GUARDAR REGLA</span>
                    }
                </MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public VentanaOperativaDTO Ventana { get; set; } = new();

    private VentanaOperativaDTO modelo = new();
    private MudForm form = null!;
    private bool loading = true;
    private bool _procesando = false;

    private List<PeriodoAcademicoDTO> periodos = new();
    private List<CarreraDTO> carreras = new();
    private List<SedeDTO> sedes = new();

    private DateTime? fechaInicioTemp;
    private DateTime? fechaFinTemp;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            var t1 = PeriodoService.GetAllAsync();
            var t2 = CarreraService.GetAllAsync();
            var t3 = SedeService.GetAllAsync();

            await Task.WhenAll(t1, t2, t3);
            periodos = t1.Result;
            carreras = t2.Result;
            sedes = t3.Result;

            if (Ventana != null)
            {
                modelo = new VentanaOperativaDTO
                {
                    Id = Ventana.Id,
                    IdPeriodo = Ventana.IdPeriodo,
                    TipoAccion = Ventana.TipoAccion ?? "INSCRIPCION_CURSADA",
                    IdCarrera = Ventana.IdCarrera,
                    IdSede = Ventana.IdSede,
                    FechaInicio = Ventana.FechaInicio,
                    FechaFin = Ventana.FechaFin
                };
                
                fechaInicioTemp = modelo.FechaInicio;
                fechaFinTemp = modelo.FechaFin;

                // Si es un alta nueva
                if (modelo.Id == 0 && modelo.IdPeriodo == 0)
                {
                    var periodoActivo = periodos.FirstOrDefault(p => p.Activo);
                    modelo.IdPeriodo = periodoActivo?.Id ?? 0;
                    
                    // Valores por defecto seguros si no vinieron por parámetro
                    if (fechaInicioTemp == null || fechaInicioTemp == DateTime.MinValue)
                    {
                        fechaInicioTemp = DateTime.Today;
                        fechaFinTemp = DateTime.Today.AddDays(7);
                    }
                }
            }
        }
        catch
        {
            Snackbar.Add("Error de conexión al cargar los catálogos del sistema.", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Submit()
    {
        await form.Validate();
        if (!form.IsValid) return;

        if (fechaInicioTemp == null || fechaFinTemp == null)
        {
            Snackbar.Add("Las fechas de vigencia son requeridas.", Severity.Warning);
            return;
        }
        if (fechaInicioTemp > fechaFinTemp)
        {
            Snackbar.Add("La fecha de inicio no puede ser mayor a la de fin.", Severity.Warning);
            return;
        }

        // VALIDACIÓN CONTRA EL PERIODO
        var periodoSeleccionado = periodos.FirstOrDefault(p => p.Id == modelo.IdPeriodo);
        if (periodoSeleccionado != null)
        {
            if (periodoSeleccionado.FechaInicio != null && fechaInicioTemp < periodoSeleccionado.FechaInicio)
            {
                Snackbar.Add($"Incoherencia temporal: La regla inicia el {fechaInicioTemp:dd/MM/yyyy} pero el Ciclo Lectivo comienza recién el {periodoSeleccionado.FechaInicio:dd/MM/yyyy}.", Severity.Error);
                return;
            }

            if (periodoSeleccionado.FechaFin != null && fechaFinTemp > periodoSeleccionado.FechaFin)
            {
                Snackbar.Add($"Incoherencia temporal: La regla termina el {fechaFinTemp:dd/MM/yyyy} pero el Ciclo Lectivo finaliza el {periodoSeleccionado.FechaFin:dd/MM/yyyy}.", Severity.Error);
                return;
            }
        }
        else
        {
            Snackbar.Add("Debe seleccionar un Ciclo Lectivo válido.", Severity.Error);
            return;
        }

        _procesando = true;
        StateHasChanged();

        // Pasar valores finales
        modelo.FechaInicio = fechaInicioTemp.Value;
        modelo.FechaFin = fechaFinTemp.Value;
        
        // Limpieza de IDs 0 por si la UI envía 0 en vez de null
        if (modelo.IdCarrera == 0) modelo.IdCarrera = null;
        if (modelo.IdSede == 0) modelo.IdSede = null;

        MudDialog.Close(DialogResult.Ok(modelo));
    }

    private void Cancel()
    {
        if (!_procesando) MudDialog.Cancel();
    }
}