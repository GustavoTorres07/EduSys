@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces

@inject ISoporteService SoporteService
@inject ISnackbar Snackbar

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@400;600&family=Inter:wght@400;500;600;700&display=swap');

    /* ════════════════════════════════════════════════
           FORZAR FONDO BLANCO EN TODOS LOS WRAPPERS
           que MudDialog genera internamente.
           Sin esto, el cuerpo queda transparente.
        ════════════════════════════════════════════════ */
    .mud-dialog {
        background: #ffffff !important;
        border-radius: 12px !important;
        overflow: hidden !important;
        box-shadow: 0 20px 60px rgba(26,45,69,0.22) !important;
        min-width: 480px !important;
        max-width: 520px !important;
        font-family: 'Inter', system-ui, sans-serif !important;
    }

        /* Título: usamos el área para nuestro header azul */
        .mud-dialog .mud-dialog-title {
            background: #456990 !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        /* Contenido: fondo blanco, sin padding propio de Mud */
        .mud-dialog .mud-dialog-content {
            background: #ffffff !important;
            padding: 0 !important;
        }

        /* Acciones: fondo blanco */
        .mud-dialog .mud-dialog-actions {
            background: #ffffff !important;
            padding: 0 !important;
            border-top: 1px solid #eef1f6 !important;
            margin: 0 !important;
        }

    /* ── HEADER ────────────────────────────────────── */
    .sd-header {
        background: #456990;
        padding: 1.125rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .sd-header-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .sd-header-texts {
        flex: 1;
    }

    .sd-header-title {
        font-family: 'Source Serif 4', Georgia, serif;
        font-size: 1rem;
        font-weight: 600;
        color: #ffffff;
        line-height: 1.2;
        margin: 0;
    }

    .sd-header-sub {
        font-size: 0.68rem;
        color: rgba(255,255,255,0.55);
        margin-top: 2px;
        font-weight: 400;
    }

    /* ── BODY ──────────────────────────────────────── */
    .sd-body {
        background: #ffffff;
        padding: 1.375rem 1.5rem 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    /* Aviso público */
    .sd-notice {
        background: #f4f6fa;
        border: 1px solid #dde3ec;
        border-left: 3px solid #456990;
        border-radius: 6px;
        padding: 10px 14px;
        font-size: 0.78rem;
        color: #4a5e75;
        line-height: 1.5;
    }

        .sd-notice strong {
            color: #1a2d45;
        }

    /* Campo genérico */
    .sd-field {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .sd-field-label {
        font-size: 0.63rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #8a9ab5;
    }

    /* SELECT nativo */
    .sd-sel-wrap {
        position: relative;
    }

    .sd-sel {
        width: 100%;
        appearance: none;
        -webkit-appearance: none;
        background: #f7f9fc;
        border: 1px solid #dde3ea;
        border-radius: 6px;
        padding: 9px 32px 9px 11px;
        font-family: 'Inter', sans-serif;
        font-size: 0.84rem;
        font-weight: 500;
        color: #1a2733;
        cursor: pointer;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
    }

        .sd-sel:focus {
            border-color: #456990;
            box-shadow: 0 0 0 3px rgba(69,105,144,0.10);
            background: #ffffff;
        }

    .sd-sel-chev {
        position: absolute;
        right: 9px;
        top: 50%;
        transform: translateY(-50%);
        color: #8a9ab5;
        pointer-events: none;
        font-size: 16px;
    }

    /* INPUT y TEXTAREA nativos */
    .sd-input,
    .sd-textarea {
        width: 100%;
        background: #f7f9fc;
        border: 1px solid #dde3ea;
        border-radius: 6px;
        padding: 9px 11px;
        font-family: 'Inter', sans-serif;
        font-size: 0.84rem;
        font-weight: 500;
        color: #1a2733;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
        resize: vertical;
        box-sizing: border-box;
    }

        .sd-input:focus,
        .sd-textarea:focus {
            border-color: #456990;
            box-shadow: 0 0 0 3px rgba(69,105,144,0.10);
            background: #ffffff;
        }

        .sd-input::placeholder,
        .sd-textarea::placeholder {
            color: #a0aec0;
            font-weight: 400;
        }

    .sd-textarea {
        min-height: 110px;
        line-height: 1.55;
    }

    /* ── FOOTER ────────────────────────────────────── */
    .sd-footer {
        background: #ffffff;
        padding: 1rem 1.5rem 1.125rem;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .sd-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 18px;
        border-radius: 7px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
        transition: all 0.13s;
        border: 1px solid transparent;
        white-space: nowrap;
        line-height: 1;
    }

    .sd-btn-ghost {
        background: transparent;
        border-color: #dde3ec;
        color: #6a7d98;
    }

        .sd-btn-ghost:hover {
            background: #f4f6fa;
            border-color: #c0cdd9;
        }

    .sd-btn-primary {
        background: #456990;
        border-color: #456990;
        color: #ffffff;
    }

        .sd-btn-primary:hover {
            background: #344f6e;
            box-shadow: 0 3px 10px rgba(69,105,144,0.25);
        }

        .sd-btn-primary:disabled {
            opacity: 0.55;
            pointer-events: none;
        }

    @@media (max-width: 520px) {
        .mud-dialog {
            min-width: unset !important;
            width: 96vw !important;
        }
    }
</style>

<MudDialog DisableSidePadding="true">

    <TitleContent>
        <div class="sd-header">
            <div class="sd-header-icon">
                <MudIcon Icon="@Icons.Material.Filled.SupportAgent"
                         Style="color:#EEB868; font-size:18px;" />
            </div>
            <div class="sd-header-texts">
                <h2 class="sd-header-title">Solicitar soporte técnico</h2>
                <div class="sd-header-sub">Mesa de ayuda · EduSys</div>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="sd-body">

            @if (EsPublico)
            {
                <div class="sd-notice">
                    <strong>Aviso de seguridad:</strong> Solo usuarios registrados
                    en el sistema pueden generar solicitudes de soporte.
                </div>

                <div class="sd-field">
                    <label class="sd-field-label">DNI o email registrado</label>
                    <input class="sd-input"
                           type="text"
                           placeholder="Ej: 30123456 o usuario@institucion.edu"
                           @bind="reqPublico.Identificacion"
                           @bind:event="oninput" />
                </div>
            }

            <div class="sd-field">
                <label class="sd-field-label">Categoría del problema</label>
                <div class="sd-sel-wrap">
                    <select class="sd-sel"
                            value="@CategoriaSeleccionada"
                            @onchange="@(e => CategoriaSeleccionada = e.Value?.ToString() ?? "")">
                        <option value="" disabled>— Seleccione una categoría —</option>
                        <option value="Problema de Acceso">Problema de acceso / Login</option>
                        <option value="Problemas con Notas/Actas">Problemas con notas / actas</option>
                        <option value="Error del Sistema">Error del sistema</option>
                        <option value="Consulta Administrativa">Consulta administrativa</option>
                        <option value="Otro">Otro</option>
                    </select>
                    <MudIcon Icon="@Icons.Material.Filled.UnfoldMore" Class="sd-sel-chev" />
                </div>
            </div>

            <div class="sd-field">
                <label class="sd-field-label">Asunto</label>
                <input class="sd-input"
                       type="text"
                       placeholder="Resumen breve del problema"
                       @bind="Asunto"
                       @bind:event="oninput" />
            </div>

            <div class="sd-field">
                <label class="sd-field-label">Descripción</label>
                <textarea class="sd-textarea"
                          placeholder="Describí el problema con el mayor detalle posible: qué estabas haciendo, qué mensaje apareció, desde qué dispositivo…"
                          @bind="Mensaje"
                          @bind:event="oninput"></textarea>
            </div>

        </div>
    </DialogContent>

    <DialogActions>
        <div class="sd-footer">
            <button class="sd-btn sd-btn-ghost" @onclick="Cancelar">
                Cancelar
            </button>
            <button class="sd-btn sd-btn-primary"
                    @onclick="EnviarTicket"
                    disabled="@_enviando">
                @if (_enviando)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                         Style="width:13px;height:13px;color:#fff;" />
                    <span>Enviando…</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Send" Style="font-size:14px;" />
                    <span>Enviar solicitud</span>
                }
            </button>
        </div>
    </DialogActions>

</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public bool EsPublico { get; set; } = false;

    private TicketPublicoRequestDTO reqPublico = new();
    private string CategoriaSeleccionada = "";
    private string Asunto = "";
    private string Mensaje = "";
    private bool _enviando = false;

    private void Cancelar() => MudDialog.Cancel();

    private async Task EnviarTicket()
    {
        if (string.IsNullOrWhiteSpace(CategoriaSeleccionada) ||
            string.IsNullOrWhiteSpace(Asunto) ||
            string.IsNullOrWhiteSpace(Mensaje))
        {
            Snackbar.Add("Por favor, completá todos los campos.", Severity.Warning);
            return;
        }

        if (EsPublico && string.IsNullOrWhiteSpace(reqPublico.Identificacion))
        {
            Snackbar.Add("Debés ingresar tu DNI o email.", Severity.Warning);
            return;
        }

        _enviando = true;
        try
        {
            if (EsPublico)
            {
                reqPublico.Categoria = CategoriaSeleccionada;
                reqPublico.Asunto = Asunto;
                reqPublico.Mensaje = Mensaje;
                await SoporteService.CrearTicketPublicoAsync(reqPublico);
            }
            else
            {
                var req = new TicketInternoRequestDTO
                {
                    Categoria = CategoriaSeleccionada,
                    Asunto = Asunto,
                    Mensaje = Mensaje
                };
                await SoporteService.CrearTicketInternoAsync(req);
            }

            Snackbar.Add("Tu solicitud fue enviada al área de soporte.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al enviar: " + ex.Message, Severity.Error);
        }
        finally
        {
            _enviando = false;
        }
    }
}
