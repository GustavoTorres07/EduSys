@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@inject IDashboardService DashboardService

<style>
    .wam {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        font-family: 'Inter', sans-serif;
    }

    @@media (max-width: 1024px) {
        .wam {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 600px) {
        .wam {
            grid-template-columns: 1fr;
        }
    }

    .wam-cell {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.5rem;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 4px 6px rgba(30, 58, 88, 0.02);
    }

        .wam-cell:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 20px rgba(30, 58, 88, 0.08);
        }

    /* Indicador de tendencia (Sparkline) */
    .wam-sparkline {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 60px;
        opacity: 0.15;
        z-index: 0;
    }

        .wam-sparkline path {
            fill: none;
            stroke-width: 3;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .wam-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .wam-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
    }

    .wam-icon-box {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--c-light);
        color: var(--c-main);
    }

    .wam-eyebrow {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #64748b;
    }

    .wam-num {
        font-family: 'Source Serif 4', serif;
        font-size: 2.5rem;
        font-weight: 600;
        color: #0f172a;
        line-height: 1.1;
        margin: 0.25rem 0;
    }

    .wam-trend {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-top: auto;
    }

    .trend-up {
        color: #10b981;
    }

    .trend-down {
        color: #ef4444;
    }

    /* Tarjeta Especial (Alertas) */
    .wam-cell.alert-card {
        background: linear-gradient(135deg, #fff1f2 0%, #ffffff 100%);
        border-color: #fecdd3;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #ef4444;
        border-radius: 50%;
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        70% {
            box-shadow: 0 0 0 10px rgba(239, 68, 68, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
        }
    }
</style>

@if (!cargando)
{
    <div class="wam">
        <div class="wam-cell" style="--c-main: #456990; --c-light: #f1f5f9;">
            <svg class="wam-sparkline" viewBox="0 0 100 30" preserveAspectRatio="none"><path stroke="#456990" d="M0,25 C20,20 30,28 50,15 C70,2 80,10 100,5"></path></svg>
            <div class="wam-content">
                <div class="wam-header">
                    <span class="wam-eyebrow">Usuarios Activos</span>
                    <div class="wam-icon-box"><MudIcon Icon="@Icons.Material.Filled.PeopleAlt" /></div>
                </div>
                <div class="wam-num">@(data.CantidadAlumnos + data.CantidadDocentes)</div>
                <div class="wam-trend trend-up"><MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" /> +12% este mes</div>
            </div>
        </div>

        <div class="wam-cell" style="--c-main: #49BEAA; --c-light: #f0fdf4;">
            <svg class="wam-sparkline" viewBox="0 0 100 30" preserveAspectRatio="none"><path stroke="#49BEAA" d="M0,20 L20,15 L40,25 L60,10 L80,15 L100,5"></path></svg>
            <div class="wam-content">
                <div class="wam-header">
                    <span class="wam-eyebrow">Oferta Académica</span>
                    <div class="wam-icon-box"><MudIcon Icon="@Icons.Material.Filled.MenuBook" /></div>
                </div>
                <div class="wam-num">@data.CantidadCarreras</div>
                <div class="wam-trend" style="color: #64748b;">Carreras y programas activos</div>
            </div>
        </div>

        <div class="wam-cell" style="--c-main: #EEB868; --c-light: #fffbeb;">
            <svg class="wam-sparkline" viewBox="0 0 100 30" preserveAspectRatio="none"><path stroke="#EEB868" d="M0,10 C30,10 40,25 60,25 C80,25 90,5 100,5"></path></svg>
            <div class="wam-content">
                <div class="wam-header">
                    <span class="wam-eyebrow">Infraestructura</span>
                    <div class="wam-icon-box"><MudIcon Icon="@Icons.Material.Filled.Business" /></div>
                </div>
                <div class="wam-num">@data.CantidadSedes</div>
                <div class="wam-trend" style="color: #64748b;">Sedes conectadas al sistema</div>
            </div>
        </div>

        <div class="wam-cell alert-card" style="--c-main: #ef4444; --c-light: #fee2e2;">
            <div class="wam-content">
                <div class="wam-header">
                    <span class="wam-eyebrow" style="color: #991b1b;">Estado Operativo</span>
                    <div class="wam-icon-box"><MudIcon Icon="@Icons.Material.Filled.MonitorHeart" /></div>
                </div>
                <div class="d-flex align-center gap-3">
                    <div class="wam-num" style="color: #991b1b;">@alertas</div>
                    @if (alertas > 0)
                    {
                        <div class="pulse-dot"></div>
                    }
                </div>
                <div class="wam-trend @(alertas > 0 ? "trend-down" : "")">
                    @(alertas > 0 ? "Requieren atención inmediata" : "Todos los sistemas estables")
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DashboardDTO data = new();
    private bool cargando = true;
    private int alertas = 0; // Conectar luego con API real

    protected override async Task OnInitializedAsync()
    {
        try { data = await DashboardService.GetResumenAsync(); }
        finally { cargando = false; }
    }
}