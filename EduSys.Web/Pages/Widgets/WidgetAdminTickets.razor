@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@inject ISoporteService SoporteService
@inject NavigationManager Nav

<style>
    .wat-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 6px rgba(30, 58, 88, 0.02);
    }

    .wat-header {
        padding: 1.5rem;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .wat-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .wat-badge-urgent {
        background: #fee2e2;
        color: #ef4444;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 800;
        animation: blink 2s infinite;
    }

    @@keyframes blink {
        50% {
            opacity: 0.6;
        }
    }

    .wat-grid {
        padding: 1.5rem;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
        overflow-y: auto;
    }

    .ticket-box {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.25rem;
        background: #fcfcfd;
        transition: all 0.2s;
        cursor: pointer;
        border-left: 4px solid #456990;
    }

        .ticket-box:hover {
            background: #fff;
            border-color: #cbd5e1;
            box-shadow: 0 6px 12px rgba(0,0,0,0.05);
            transform: translateY(-2px);
        }

        .ticket-box.urgent {
            border-left-color: #ef4444;
        }

    .tk-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .tk-num {
        font-family: 'DM Mono', monospace;
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
    }

    .tk-cat {
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        background: #eef1f6;
        padding: 2px 8px;
        border-radius: 4px;
        color: #475569;
    }

    .tk-subject {
        font-size: 0.9rem;
        font-weight: 700;
        color: #1e293b;
        line-height: 1.3;
        margin-bottom: 6px;
    }

    .tk-user {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        color: #64748b;
    }
</style>

<div class="wat-card">
    <div class="wat-header">
        <div class="wat-title"><MudIcon Icon="@Icons.Material.Filled.SupportAgent" Style="color: #EF767A;" /> Mesa de Ayuda</div>
        @if (!cargando && abiertos > 0)
        {
            <div class="wat-badge-urgent">@abiertos SIN RESPONDER</div>
        }
    </div>

    <div class="wat-grid">
        @if (!cargando && tickets.Any())
        {
            @foreach (var t in tickets)
            {
                <div class="ticket-box @(t.Estado == "Abierto" ? "urgent" : "")" @onclick="@(() => Nav.NavigateTo($"/ticket/{t.Id}"))">
                    <div class="tk-top">
                        <span class="tk-num">@t.NumeroTicket</span>
                        <span class="tk-cat">@t.Categoria</span>
                    </div>
                    <div class="tk-subject">@t.Asunto</div>
                    <div class="tk-user">
                        <MudIcon Icon="@Icons.Material.Filled.PersonOutline" Size="Size.Small" Style="font-size: 14px;" />
                        @t.NombreSolicitante
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<SoporteTicketDTO> tickets = new();
    private bool cargando = true;
    private int abiertos = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            tickets = await SoporteService.GetAllTicketsAdminAsync("Abierto", "", null, null, 6);
            abiertos = tickets.Count;
        }
        finally { cargando = false; }
    }
}