@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@inject IAlumnoPortalService AlumnoPortalService
@inject NavigationManager Nav

<style>
    .waa2 {
        background: #ffffff;
        border: 1px solid #dde3ea;
        border-radius: 10px;
        overflow: hidden;
        font-family: 'Inter', system-ui, sans-serif;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 1px 4px rgba(69,105,144,.08);
    }

    /* ── HEADER ──────────────────────────────────── */
    .waa2-head {
        background: #f8fafc;
        border-bottom: 1px solid #eef1f6;
        padding: .875rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .waa2-head-left {
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .waa2-head-icon {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background: rgba(73,190,170,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #49BEAA;
    }

    .waa2-head-title {
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #5a7090;
    }

    .waa2-ver-btn {
        font-size: .7rem;
        font-weight: 600;
        color: #49BEAA;
        background: none;
        border: none;
        cursor: pointer;
        font-family: inherit;
        transition: color .12s;
    }

        .waa2-ver-btn:hover {
            color: #3aaa95;
        }

    /* ── LISTA ───────────────────────────────────── */
    .waa2-list {
        flex: 1;
        overflow-y: auto;
        padding: .75rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

        .waa2-list::-webkit-scrollbar {
            width: 3px;
        }

        .waa2-list::-webkit-scrollbar-thumb {
            background: #dde3ea;
            border-radius: 3px;
        }

    /* Item por materia */
    .waa2-item {
        animation: waa2-in .4s ease-out both;
    }

    @@keyframes waa2-in {
        from {
            opacity: 0;
            transform: translateY(5px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    .waa2-item-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: .5rem;
        margin-bottom: 5px;
    }

    .waa2-materia {
        font-size: .8rem;
        font-weight: 600;
        color: #1a2733;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .waa2-pct {
        font-family: 'DM Mono', monospace;
        font-size: .75rem;
        font-weight: 700;
        color: var(--bar-c);
        flex-shrink: 0;
    }

    /* Barra de progreso */
    .waa2-bar-track {
        height: 6px;
        background: #f0f3f8;
        border-radius: 6px;
        overflow: hidden;
        margin-bottom: 4px;
    }

    .waa2-bar-fill {
        height: 100%;
        border-radius: 6px;
        background: var(--bar-c);
        /* Animación de entrada */
        animation: waa2-bar .6s cubic-bezier(.4,0,.2,1) both;
        animation-delay: var(--bar-delay, 0s);
        transform-origin: left;
    }

    @@keyframes waa2-bar {
        from {
            width: 0 !important;
        }
        /* width real viene del style inline */
    }

    .waa2-item-foot {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .waa2-stat {
        font-size: .68rem;
        color: #8a9ab5;
        font-weight: 500;
    }

    .waa2-alerta {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        background: #feeef0;
        border: 1px solid #f0b8b8;
        border-radius: 20px;
        padding: 1px 7px;
        font-size: .6rem;
        font-weight: 700;
        color: #8a2020;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    /* Resumen arriba */
    .waa2-summary {
        background: #f8fafc;
        border-bottom: 1px solid #eef1f6;
        padding: .75rem 1.25rem;
        display: flex;
        gap: 1.5rem;
    }

    .waa2-sum-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .waa2-sum-val {
        font-family: 'Source Serif 4', Georgia, serif;
        font-size: 1.4rem;
        font-weight: 600;
        color: #1a2733;
        line-height: 1;
    }

    .waa2-sum-lbl {
        font-size: .62rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #8a9ab5;
    }

    /* empty */
    .waa2-empty {
        padding: 2.5rem 1.5rem;
        text-align: center;
    }

    .waa2-empty-t {
        font-family: 'Source Serif 4', serif;
        font-style: italic;
        font-size: 1rem;
        color: #8a9ab5;
        margin-bottom: .25rem;
    }

    .waa2-empty-s {
        font-size: .75rem;
        color: #b0bcce;
    }

    /* skeleton */
    @@keyframes sk {
        0% {
            background-position: -600px 0
        }

        100% {
            background-position: 600px 0
        }
    }

    .sk {
        background: linear-gradient(90deg,#eaedf1 25%,#f4f6f9 50%,#eaedf1 75%);
        background-size: 1200px 100%;
        animation: sk 1.4s infinite linear;
        border-radius: 4px;
        display: block;
    }
</style>

<div class="waa2">
    <div class="waa2-head">
        <div class="waa2-head-left">
            <div class="waa2-head-icon">
                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Style="font-size:15px;" />
            </div>
            <span class="waa2-head-title">Mis asistencias</span>
        </div>
        <button class="waa2-ver-btn" @onclick="@(() => Nav.NavigateTo("/alumno/asistencias"))">
            Ver detalle →
        </button>
    </div>

    @if (!cargando && asistencias.Any())
    {
        <div class="waa2-summary">
            <div class="waa2-sum-item">
                <span class="waa2-sum-val">@asistencias.Count</span>
                <span class="waa2-sum-lbl">Materias</span>
            </div>
            <div class="waa2-sum-item">
                <span class="waa2-sum-val" style="color:#49DCB1;">@promedioGlobal%</span>
                <span class="waa2-sum-lbl">Promedio</span>
            </div>
            @if (enRiesgo > 0)
            {
                <div class="waa2-sum-item">
                    <span class="waa2-sum-val" style="color:#EF767A;">@enRiesgo</span>
                    <span class="waa2-sum-lbl">En riesgo</span>
                </div>
            }
        </div>
    }

    <div class="waa2-list">
        @if (cargando)
        {
            @for (int i = 0; i < 5; i++)
            {
                <div style="display:flex;flex-direction:column;gap:5px;">
                    <div style="display:flex;justify-content:space-between;">
                        <span class="sk" style="height:11px;width:130px;"></span>
                        <span class="sk" style="height:11px;width:36px;"></span>
                    </div>
                    <span class="sk" style="height:6px;border-radius:6px;"></span>
                    <span class="sk" style="height:9px;width:100px;"></span>
                </div>
            }
        }
        else if (asistencias.Any())
        {
            @foreach (var (a, i) in asistencias.Select((a, i) => (a, i)))
            {
                // 🚀 USAMOS EL PORCENTAJE YA CALCULADO EN EL DTO
                double pct = (double)a.PorcentajeActual;

                string barColor = pct >= 75 ? "#49DCB1"
                                : pct >= 60 ? "#EEB868"
                                : "#EF767A";

                <div class="waa2-item" style="animation-delay:@(i * .05)s;">
                    <div class="waa2-item-head">
                        <span class="waa2-materia">@a.Materia</span>
                        <span class="waa2-pct" style="--bar-c:@barColor;">@pct%</span>
                    </div>
                    <div class="waa2-bar-track">
                        <div class="waa2-bar-fill"
                             style="width:@pct%;--bar-c:@barColor;--bar-delay:@(i * .08)s;">
                        </div>
                    </div>
                    <div class="waa2-item-foot">
                        <span class="waa2-stat">@(a.Presentes + a.Justificados)/@a.TotalClases clases</span>

                        @if (a.EnRiesgo)
                        {
                            <span class="waa2-alerta">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Style="font-size:9px;" />
                                Riesgo de libre
                            </span>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="waa2-empty">
                <MudIcon Icon="@Icons.Material.Outlined.EventNote" Style="font-size:2.2rem;color:#dde3ea;" />
                <div class="waa2-empty-t">Sin registros de asistencia</div>
                <div class="waa2-empty-s">Aún no hay asistencias cargadas para este ciclo.</div>
            </div>
        }
    </div>
</div>

@code {
    // 🚀 AHORA USAMOS EL DTO CORRECTO
    private List<AsistenciaMateriaDTO> asistencias = new();
    private bool cargando = true;
    private int promedioGlobal = 0;
    private int enRiesgo = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var data = await AlumnoPortalService.GetMisAsistenciasAsync();
            asistencias = (data ?? new())
                .Where(a => a.CicloLectivo == DateTime.Now.Year)
                .ToList();

            if (asistencias.Any())
            {
                // Promedio calculado usando el porcentaje real que da tu DTO
                promedioGlobal = (int)Math.Round(asistencias.Average(a => (double)a.PorcentajeActual));
                // Verificamos cuáles están en riesgo directamente de tu DTO
                enRiesgo = asistencias.Count(a => a.EnRiesgo);
            }
        }
        catch { }
        finally { cargando = false; }
    }
}