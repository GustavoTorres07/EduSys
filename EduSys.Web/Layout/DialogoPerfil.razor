@using EduSys.Shared.DTOs
@inject ISnackbar Snackbar

<style>
    /* --- ESTILOS CORPORATIVOS --- */
    .mud-dialog-close-icon {
        display: none !important;
    }

    .mud-dialog-content {
        padding: 0 !important;
    }

    .dialog-container {
        display: flex;
        flex-direction: column;
        background-color: white;
        max-height: 85vh;
        min-width: 500px;
    }

    /* HEADER AZUL */
    .dialog-header-integrated {
        background: #456990;
        color: white;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }

    .dialog-body {
        padding: 24px;
        overflow-y: auto;
        flex-grow: 1;
    }

    .actions-footer {
        padding: 16px 24px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        background-color: white;
        flex-shrink: 0;
    }

    /* Inputs y Labels - Fix Visibilidad */
    .force-black-text input,
    .force-black-text .mud-input-slot,
    .force-black-text .mud-select-input,
    .force-black-text textarea {
        color: #1F2937 !important;
        font-weight: 500;
        -webkit-text-fill-color: #1F2937 !important;
    }

    .force-black-text .mud-input-label {
        color: #456990 !important;
        background-color: white !important;
        padding: 0 5px;
        font-weight: 600;
    }

    .custom-input-borde .mud-input-outlined-border {
        border-color: #456990 !important;
    }

    .custom-input-borde .mud-icon-root {
        color: #456990 !important;
    }

    /* Campos de solo lectura */
    .readonly-field .mud-input-slot,
    .readonly-field input {
        color: #64748b !important;
        -webkit-text-fill-color: #64748b !important;
        background-color: #f8fafc !important;
    }

    .readonly-field .mud-input-outlined-border {
        border-color: #e2e8f0 !important;
    }
</style>

<MudDialog DisableSidePadding="true" Class="rounded-lg overflow-hidden">
    <DialogContent>
        <div class="dialog-container">

            @* --- CABECERA --- *@
            <div class="dialog-header-integrated">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Class="mr-3" />
                    <div>
                        <MudText Typo="Typo.h6" Style="font-weight: 700; line-height: 1.2;">
                            Mi Perfil
                        </MudText>
                        <MudText Typo="Typo.caption" Style="opacity: 0.9;">
                            Información personal y contacto
                        </MudText>
                    </div>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Color="Color.Inherit"
                               OnClick="Cancel"
                               Size="Size.Small" />
            </div>

            @* --- CUERPO --- *@
            <div class="dialog-body">
                <MudText Typo="Typo.body2" Class="mb-4" Style="color: #64748b;">
                    Actualiza tu información de contacto. Los datos de identidad no pueden modificarse.
                </MudText>

                <MudGrid Spacing="2">
                    @* --- DATOS FIJOS (SOLO LECTURA) --- *@
                    <MudItem xs="6">
                        <MudTextField Value="@modelo.Nombre"
                                      Label="Nombre"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"
                                      Margin="Margin.Dense"
                                      Class="readonly-field" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTextField Value="@modelo.Apellido"
                                      Label="Apellido"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"
                                      Margin="Margin.Dense"
                                      Class="readonly-field" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField Value="@modelo.Dni"
                                      Label="DNI"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge"
                                      Class="readonly-field" />
                    </MudItem>

                    @* --- DATOS EDITABLES --- *@
                    <MudItem xs="12">
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.caption"
                                 Style="font-weight:700; color:#456990; text-transform: uppercase; font-size: 0.75rem;">
                            Datos de Contacto
                        </MudText>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="modelo.Email"
                                      Label="Email"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="force-black-text custom-input-borde"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="modelo.Telefono"
                                      Label="Teléfono / Celular"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="force-black-text custom-input-borde"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Phone" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="modelo.Direccion"
                                      Label="Dirección"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="force-black-text custom-input-borde"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Home" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="modelo.Localidad"
                                      Label="Localidad"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="force-black-text custom-input-borde"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Map" />
                    </MudItem>
                </MudGrid>
            </div>

            @* --- FOOTER --- *@
            <div class="actions-footer">
                <MudButton OnClick="Cancel"
                           Variant="Variant.Outlined"
                           Color="Color.Default"
                           Class="rounded-lg">
                    Cancelar
                </MudButton>
                <MudButton OnClick="Guardar"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="rounded-lg"
                           StartIcon="@Icons.Material.Filled.Save">
                    Guardar Cambios
                </MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>

