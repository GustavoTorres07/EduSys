@using EduSys.Shared.DTOs
@using EduSys.Web.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject ISnackbar Snackbar
@* ✅ INYECTAMOS EL SERVICIO REAL DE USUARIOS *@
@inject IUsuarioService UsuarioService

<style>
    /* --- AJUSTES DEL MODAL --- */
    .mud-dialog-close-icon { display: none !important; }
    .mud-dialog-content { padding: 0 !important; }

    .dialog-container {
        display: flex;
        flex-direction: column;
        background-color: #f8fafc;
        max-height: 90vh;
    }

    /* --- HEADER AZUL INTEGRADO --- */
    .dialog-header-integrated {
        background: linear-gradient(135deg, #1e3a58 0%, #456990 100%);
        color: white;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }

    /* --- ÁREA DE CONTENIDO --- */
    .dialog-body {
        padding: 24px;
        overflow-y: auto;
        flex-grow: 1;
        position: relative;
    }

    .profile-avatar-modal {
        width: 72px;
        height: 72px;
        font-size: 2rem;
        font-weight: 800;
        border: 3px solid white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .readonly-field .mud-input-adornment-start .mud-icon-root {
    color: #456990 !important; /* Azul corporativo para que resalte */
    opacity: 1 !important;
}

    /* --- ETIQUETAS DE SECCIÓN --- */
    .section-label {
        color: #456990;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 4px;
        margin-bottom: 12px;
        margin-top: 20px;
    }

    /* --- CAMPOS DE SOLO LECTURA --- */
    .readonly-field .mud-input-slot,
    .readonly-field input {
        color: #64748b !important;
        -webkit-text-fill-color: #64748b !important;
        background-color: #f1f5f9 !important;
        font-weight: 600;
        border-radius: 6px;
    }
    .readonly-field .mud-input-outlined-border { border-color: #e2e8f0 !important; }
    .readonly-field .mud-input-label { color: #94a3b8 !important; font-weight: 600; }

    /* --- CAMPOS EDITABLES --- */
    .force-black-text input,
    .force-black-text .mud-input-slot {
        color: #1e293b !important;
        font-weight: 600;
        -webkit-text-fill-color: #1e293b !important;
    }
    .force-black-text .mud-input-label {
        color: #456990 !important;
        background-color: white !important;
        padding: 0 5px;
        font-weight: 700;
    }
    .custom-input-borde .mud-input-outlined-border { border-color: #cbd5e1 !important; transition: 0.2s; }
    .custom-input-borde:hover .mud-input-outlined-border { border-color: #456990 !important; }
    .custom-input-borde.mud-input-control.mud-input-focused .mud-input-outlined-border { border-width: 2px !important; border-color: #456990 !important; }
    .custom-input-borde .mud-icon-root { color: #64748b !important; }
    .custom-input-borde.mud-input-control.mud-input-focused .mud-icon-root { color: #456990 !important; }

    /* --- FOOTER --- */
    .actions-footer {
        padding: 16px 24px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        background-color: white;
        flex-shrink: 0;
    }
</style>

<MudDialog DisableSidePadding="true" Class="rounded-xl overflow-hidden" Style="max-width: 550px; width: 100%;">
    <DialogContent>
        <div class="dialog-container">

            @* --- CABECERA AZUL --- *@
            <div class="dialog-header-integrated">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="mr-3" />
                    <MudText Typo="Typo.h6" Style="font-weight: 800; letter-spacing: -0.5px;">Mi Perfil de Usuario</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="Cancel" Size="Size.Small" Disabled="@_guardando" />
            </div>

            @* --- CUERPO --- *@
            <div class="dialog-body">
                @if (_cargando)
                {
                    <div class="d-flex flex-column justify-center align-center" style="height: 300px;">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                        <MudText Typo="Typo.body2" Class="mt-3" Style="color: #64748b; font-weight: 600;">Cargando tus datos...</MudText>
                    </div>
                }
                else
                {
                    @* CABECERA DE PERFIL (Avatar + Nombre) *@
                    <div class="d-flex flex-column align-center text-center mb-6 animate__animated animate__fadeIn">
                        <MudAvatar Color="Color.Primary" Class="profile-avatar-modal mb-3">
                            @(string.IsNullOrWhiteSpace(modelo.Nombre) ? "U" : modelo.Nombre.Substring(0, 1).ToUpper())
                        </MudAvatar>
                        <MudText Typo="Typo.h5" Style="font-weight: 800; color: #1e293b; line-height: 1.2;">@modelo.Nombre @modelo.Apellido</MudText>
                        
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mt-1 font-weight-bold">
                            @(_rolUsuario.ToUpper())
                        </MudChip>
                    </div>

                    @* TARJETA BLANCA DE DATOS *@
                    <MudPaper Elevation="0" Class="pa-6 rounded-lg animate__animated animate__fadeInUp" Style="border: 1px solid #e2e8f0; background-color: white;">
                        
                        <div class="section-label mt-0">Identidad Registrada</div>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <MudTextField Value="@modelo.Nombre" Label="Nombres" Variant="Variant.Outlined" ReadOnly="true" Margin="Margin.Dense" Class="readonly-field" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField Value="@modelo.Apellido" Label="Apellidos" Variant="Variant.Outlined" ReadOnly="true" Margin="Margin.Dense" Class="readonly-field" />
                            </MudItem>
<MudItem xs="12">
    <MudTextField Value="@modelo.Dni" 
                  Label="Documento de Identidad (DNI)" 
                  Variant="Variant.Outlined" 
                  ReadOnly="true" 
                  Margin="Margin.Dense" 
                  Adornment="Adornment.Start" 
                  AdornmentIcon="@Icons.Material.Filled.AssignmentInd" 
                  Class="readonly-field" />
</MudItem>
                        </MudGrid>

                        <div class="section-label">Información de Contacto</div>
                        <MudText Typo="Typo.caption" Class="mb-3 d-block" Style="color: #64748b;">
                            Mantén estos datos actualizados para recibir notificaciones del sistema.
                        </MudText>
                        
                        <EditForm Model="@modelo">
                            <MudGrid Spacing="3">
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="modelo.Email" Label="Correo Electrónico" Variant="Variant.Outlined" Margin="Margin.Dense" Class="force-black-text custom-input-borde" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" Disabled="@_guardando" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="modelo.Telefono" Label="Teléfono / Celular" Variant="Variant.Outlined" Margin="Margin.Dense" Class="force-black-text custom-input-borde" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Phone" Disabled="@_guardando" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="modelo.Localidad" Label="Localidad" Variant="Variant.Outlined" Margin="Margin.Dense" Class="force-black-text custom-input-borde" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.LocationCity" Disabled="@_guardando" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="modelo.Direccion" Label="Dirección de Domicilio" Variant="Variant.Outlined" Margin="Margin.Dense" Class="force-black-text custom-input-borde" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Home" Disabled="@_guardando" />
                                </MudItem>
                            </MudGrid>
                        </EditForm>
                    </MudPaper>
                }
            </div>

            @* --- FOOTER --- *@
            <div class="actions-footer">
                <MudButton OnClick="Cancel" Variant="Variant.Outlined" Color="Color.Default" Class="rounded-lg font-weight-bold" Style="min-width: 120px;" Disabled="@(_cargando || _guardando)">
                    Cancelar
                </MudButton>
                <MudButton OnClick="GuardarAsync" Variant="Variant.Filled" Color="Color.Primary" Class="rounded-lg font-weight-bold" StartIcon="@Icons.Material.Filled.Save" Style="min-width: 160px;" Disabled="@(_cargando || _guardando)">
                    @if (_guardando)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                        <span class="ms-2">Guardando...</span>
                    }
                    else
                    {
                        <span>Guardar Cambios</span>
                    }
                </MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState> authenticationStateTask { get; set; } = null!;

    private string _rolUsuario = "Cargando...";
    private bool _cargando = true;
    private bool _guardando = false;
    private int _idUsuarioActual;

    // ✅ Utilizamos el DTO real del proyecto
    private UsuarioDTO modelo = new UsuarioDTO();

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        try
        {
            var authState = await authenticationStateTask;
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                // 1. Obtenemos el rol
                var roleClaim = user.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role);
                _rolUsuario = roleClaim?.Value ?? "USUARIO";

                // 2. Extraemos el ID del usuario desde los Claims del token
                var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value;
                
                if (int.TryParse(idClaim, out _idUsuarioActual))
                {
                    // 3. LLAMADA REAL A LA API PARA TRAER DATOS DEL ADMINISTRADOR (CON VALIDACIÓN DE NULOS)
                    var resultado = await UsuarioService.GetByIdAsync(_idUsuarioActual);
                    
                    if (resultado != null)
                    {
                        modelo = resultado;
                    }
                    else
                    {
                        Snackbar.Add("No se encontró el perfil en la base de datos.", Severity.Warning);
                        MudDialog.Cancel();
                    }
                }
            }
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudieron cargar los datos del perfil.", Severity.Error);
            MudDialog.Cancel();
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task GuardarAsync()
    {
        _guardando = true;
        try
        {
            // ✅ LLAMADA REAL A LA API PARA ACTUALIZAR
            var resultado = await UsuarioService.UpdateAsync(modelo);
            
            if (resultado) // Si devuelve booleano o un DTO validamos
            {
                Snackbar.Add("Perfil actualizado correctamente.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("No se pudo actualizar el perfil.", Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Error al comunicarse con el servidor.", Severity.Error);
        }
        finally
        {
            _guardando = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}