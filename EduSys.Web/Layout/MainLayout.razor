@inherits LayoutComponentBase
@using EduSys.Web.Services.Interfaces
@using System.Security.Claims
@using EduSys.Web.Auth
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider _authStateProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* --- CONFIGURACIÓN GLOBAL DE COMPONENTES --- *@
<MudThemeProvider Theme="_currentTheme" />
<MudPopoverProvider />
<MudSnackbarProvider Position="SnackbarPosition.TopRight" ShowCloseIcon="true" VisibleStateDuration="4000" />
<MudDialogProvider />

@* --- CORTINA BLANCA INSTANTÁNEA PARA SALIDA LIMPIA --- *@
@if (_saliendo)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: #ffffff; z-index: 999999;"></div>
}

<MudLayout>
    @* --- BARRA SUPERIOR (APPBAR) --- *@
    <MudAppBar Elevation="2" Fixed="true" Style="background: #1e3a58; border-bottom: 1px solid rgba(255,255,255,0.1); z-index: 1300;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" Class="mr-3" />
        <MudText Typo="Typo.h6" Style="font-weight:700; letter-spacing:0.5px; color: white;">EduSys</MudText>
        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-center gap-2">
                    <MudTooltip Text="Mensajería">
                        <MudIconButton Icon="@Icons.Material.Filled.Email" Color="Color.Inherit" />
                    </MudTooltip>
                    
                    <MudTooltip Text="Soporte">
                        <MudIconButton Icon="@Icons.Material.Filled.SupportAgent" Color="Color.Inherit" />
                    </MudTooltip>

                    @* MENÚ DE PERFIL DEL USUARIO *@
                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" LockScroll="true" Class="ml-3 mr-2">
                        <ActivatorContent>
                            <div class="d-flex align-center cursor-pointer pa-1 pr-3 rounded-xl" style="background-color:rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); transition: background-color 0.2s;">
                                <MudAvatar Size="Size.Small" Class="mr-2" Color="@GetAvatarColor(context.User)">
                                    @if (!string.IsNullOrEmpty(ObtenerFotoPerfil(context.User)))
                                    {
                                        <MudImage Src="@ObtenerFotoPerfil(context.User)" Style="width:100%; height:100%; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        @GetUserInitial(context.User)
                                    }
                                </MudAvatar>
                                <MudText Typo="Typo.body2" Style="font-weight:600; color: white;" Class="mr-1 d-none d-sm-block">
                                    @GetFullUserName(context.User)
                                </MudText>
                                <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Color="Color.Inherit" Size="Size.Small" />
                            </div>
                        </ActivatorContent>
                        <ChildContent>
                            <div class="pa-4 d-flex flex-column align-center border-b mb-2" style="min-width: 240px;">
                                <MudAvatar Style="height:64px; width:64px; border: 2px solid #1e3a58;" Class="mb-2 shadow-sm" Color="@GetAvatarColor(context.User)">
                                    @if (!string.IsNullOrEmpty(ObtenerFotoPerfil(context.User)))
                                    {
                                        <MudImage Src="@ObtenerFotoPerfil(context.User)" Style="width:100%; height:100%; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span style="font-size: 1.5rem;">@GetUserInitial(context.User)</span>
                                    }
                                </MudAvatar>
                                <MudText Typo="Typo.body1" Style="font-weight:700;">@GetFullUserName(context.User)</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight:700;">@GetRoleLabel(context.User)</MudText>
                            </div>
                            <MudMenuItem Icon="@Icons.Material.Filled.Person" OnClick="AbrirPerfil">Mi Perfil</MudMenuItem>
                            <MudDivider Class="my-2" />
                            <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" OnClick="CerrarSesionAsync">Cerrar Sesión</MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                </div>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    @* --- MENÚ LATERAL (DRAWER) --- *@
    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Always"
               Elevation="3"
               Width="280px"
               Style="z-index: 1200;">
        <NavMenu />
    </MudDrawer>

    @* --- CONTENIDO PRINCIPAL --- *@
    <MudMainContent Style="background-color: #F8FAFC; min-height: 100vh;">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-10 px-4">
            
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <MudPaper Elevation="2" Class="pa-8 text-center rounded-lg mt-10 mx-auto" Style="max-width: 600px; border-top: 4px solid #EF767A;">
                        <MudIcon Icon="@Icons.Material.Filled.HeartBroken" Color="Color.Error" Size="Size.Large" Class="mb-4" />
                        <MudText Typo="Typo.h5" Style="font-weight: 700;" Class="mb-2">¡Ups! Algo no salió como esperábamos</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
                            La pantalla que intentabas ver tuvo un problema interno. No te preocupes, el resto del sistema sigue funcionando.
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RecargarPagina" StartIcon="@Icons.Material.Filled.Refresh" Class="rounded-lg">
                            Recargar Pantalla
                        </MudButton>
                    </MudPaper>
                </ErrorContent>
            </ErrorBoundary>

        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; } = null!;

    private bool _drawerOpen = true;
    private bool _saliendo = false;
    private ErrorBoundary? _errorBoundary;

    private MudTheme _currentTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#1e3a58",
            Secondary = "#EF767A",
            Tertiary = "#49BEAA",
            AppbarBackground = "#1e3a58",
            Background = "#F8FAFC",
            DrawerBackground = "#ffffff",
            TextPrimary = "#1F2937",
            TextSecondary = "#64748B"
        },
        Typography = new Typography()
        {
            Default = new Default() { FontFamily = new[] { "Inter", "Segoe UI", "sans-serif" } }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        _drawerOpen = true;
        await authenticationStateTask;
    }

    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void RecargarPagina()
    {
        _errorBoundary?.Recover();
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task CerrarSesionAsync()
    {
        try
        {
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception)
        {
            Snackbar.Add("Ocurrió un problema al cerrar sesión.", Severity.Error);
        }
    }

    private async Task AbrirPerfil()
    {
        var authState = await authenticationStateTask;
        var user = authState.User;
        
        if (user.IsInRole("Docente"))
        {
            Navigation.NavigateTo("/docente/mi-perfil");
        }
        else if (user.IsInRole("Alumno"))
        {
            Navigation.NavigateTo("/alumno/perfil");
        }
        else
        {
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                NoHeader = true,
                CloseButton = false,
                BackdropClick = true
            };
            
            DialogService.Show<DialogoPerfil>("", options);
        }
    }

    private string GetFullUserName(ClaimsPrincipal user)
    {
        var nombre = user.FindFirst("Nombre")?.Value ?? user.FindFirst(ClaimTypes.GivenName)?.Value;
        var apellido = user.FindFirst("Apellido")?.Value ?? user.FindFirst(ClaimTypes.Surname)?.Value;
        return (!string.IsNullOrEmpty(nombre)) ? $"{nombre} {apellido}".Trim() : user.Identity?.Name ?? "Usuario";
    }

    private string GetUserInitial(ClaimsPrincipal user)
    {
        var fullName = GetFullUserName(user);
        return string.IsNullOrEmpty(fullName) ? "U" : fullName.Substring(0, 1).ToUpper();
    }

    private string? ObtenerFotoPerfil(ClaimsPrincipal user)
    {
        var foto = user.FindFirst("FotoPerfilUrl")?.Value;
        if (string.IsNullOrWhiteSpace(foto) || foto == "null") return null;
        return foto;
    }

    // 🚀 MODIFICADO: Determina color en base a multirroles
    private Color GetAvatarColor(ClaimsPrincipal user)
    {
        if (user.FindAll(ClaimTypes.Role).Count() > 1) return Color.Dark;
        if (user.IsInRole("Docente")) return Color.Tertiary;
        if (user.IsInRole("Alumno")) return Color.Secondary;
        return Color.Primary;
    }

    // 🚀 MODIFICADO: Genera etiqueta para Multirroles
    private string GetRoleLabel(ClaimsPrincipal user)
    {
        var rolesCount = user.FindAll(ClaimTypes.Role).Count();
        if (rolesCount > 1) return "MULTIRROL";

        if (user.IsInRole("Docente")) return "DOCENTE";
        if (user.IsInRole("Alumno")) return "ALUMNO REGULAR";
        if (user.IsInRole("Administrador")) return "ADMINISTRADOR";
        if (user.IsInRole("Secretaria Academica")) return "SECRETARÍA";
        if (user.IsInRole("Coordinador")) return "COORDINADOR";
        
        return "USUARIO";
    }
}