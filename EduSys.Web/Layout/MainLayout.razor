@inherits LayoutComponentBase
@using EduSys.Web.Services.Interfaces
@using System.Security.Claims
@using EduSys.Web.Auth
@using EduSys.Web.Pages.Shared.Dialogos
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider _authStateProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudSnackbarProvider Position="SnackbarPosition.TopRight"
                     ShowCloseIcon="true"
                     VisibleStateDuration="4000" />
<MudDialogProvider />

@if (_saliendo)
{
    <div style="position:fixed;inset:0;background:#ffffff;z-index:999999;"></div>
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Lora:wght@500&display=swap');

    .eds-appbar {
        background: #456990 !important;
        border-bottom: 1px solid rgba(255,255,255,0.1) !important;
    }

    .eds-appbar-title {
        font-family: 'Lora', Georgia, serif !important;
        font-size: 1.15rem !important;
        font-weight: 500 !important;
        letter-spacing: -0.2px !important;
        color: #ffffff !important;
    }

    .eds-appbar-sub {
        font-size: 0.65rem !important;
        color: rgba(255,255,255,0.45) !important;
        font-weight: 500 !important;
        letter-spacing: 1px !important;
        text-transform: uppercase !important;
        font-family: 'Plus Jakarta Sans', sans-serif !important;
        display: block;
        line-height: 1;
        margin-top: 1px;
    }

    .eds-appbar-icon-btn {
        color: rgba(255,255,255,0.7) !important;
        transition: color 0.15s !important;
    }

        .eds-appbar-icon-btn:hover {
            color: #ffffff !important;
        }

    .eds-user-chip {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.25rem 0.875rem 0.25rem 0.375rem;
        border-radius: 20px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.12);
        cursor: pointer;
        transition: background 0.15s;
    }

        .eds-user-chip:hover {
            background: rgba(255,255,255,0.14);
        }

    .eds-user-chip-name {
        font-size: 0.78rem;
        font-weight: 600;
        color: #ffffff;
        font-family: 'Plus Jakarta Sans', sans-serif;
        max-width: 140px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .eds-profile-menu-head {
        padding: 1.125rem 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        border-bottom: 1px solid #eef1f6;
        min-width: 220px;
    }

    .eds-profile-menu-name {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        color: #1a2d45;
        margin-top: 0.5rem;
    }

    .eds-profile-menu-role {
        font-size: 0.63rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #456990;
        margin-top: 2px;
    }

    .eds-drawer .mud-drawer-content {
        border-right: 1px solid #eef1f6 !important;
    }

    .eds-main-content {
        background: #f0f3f8;
        min-height: 100vh;
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    }

    .eds-error-card {
        max-width: 580px;
        margin: 4rem auto;
        border-top: 3px solid #EF767A;
        border-radius: 10px;
        padding: 2.5rem;
        text-align: center;
        background: #ffffff;
        box-shadow: 0 2px 8px rgba(26,45,69,0.08);
    }
</style>

<MudLayout>

    <MudAppBar Elevation="0" Fixed="true" Class="eds-appbar" Style="z-index:1300;">

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       Class="mr-2 eds-appbar-icon-btn"
                       OnClick="ToggleDrawer" />

        <div style="display:flex; flex-direction:column; justify-content:center;">
            <span class="eds-appbar-title">EduSys</span>
            <span class="eds-appbar-sub">Gestión Universitaria</span>
        </div>

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-center" style="gap:0.5rem;">

                    <NotificacionesMenu />

                    <MudTooltip Text="Mensajería" Arrow="true">
                        <MudIconButton Icon="@Icons.Material.Outlined.Email"
                                       Color="Color.Inherit"
                                       Class="eds-appbar-icon-btn" />
                    </MudTooltip>

                    @* Botón de Soporte Técnico vinculado al modal *@
                    <MudTooltip Text="Soporte técnico" Arrow="true">
                        <MudIconButton Icon="@Icons.Material.Outlined.SupportAgent"
                                       Color="Color.Inherit"
                                       Class="eds-appbar-icon-btn"
                                       OnClick="AbrirSoporteInterno" />
                    </MudTooltip>

                    <MudMenu AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             LockScroll="true"
                             Class="ml-1 mr-1">
                        <ActivatorContent>
                            <div class="eds-user-chip">
                                <MudAvatar Size="Size.Small" Color="@GetAvatarColor(context.User)">
                                    @if (!string.IsNullOrEmpty(ObtenerFotoPerfil(context.User)))
                                    {
                                        <MudImage Src="@ObtenerFotoPerfil(context.User)"
                                                  Style="width:100%;height:100%;object-fit:cover;" />
                                    }
                                    else
                                    {

                                        @GetUserInitial(context.User)
                                    }
                                </MudAvatar>
                                <span class="eds-user-chip-name d-none d-sm-block">
                                    @GetFullUserName(context.User)
                                </span>
                                <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                         Size="Size.Small"
                                         Style="color:rgba(255,255,255,0.6);" />
                            </div>
                        </ActivatorContent>
                        <ChildContent>
                            <div class="eds-profile-menu-head">
                                <MudAvatar Style="width:56px;height:56px;border:2px solid #dde3ec;"
                                           Color="@GetAvatarColor(context.User)">
                                    @if (!string.IsNullOrEmpty(ObtenerFotoPerfil(context.User)))
                                    {
                                        <MudImage Src="@ObtenerFotoPerfil(context.User)"
                                                  Style="width:100%;height:100%;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <span style="font-size:1.4rem;">@GetUserInitial(context.User)</span>
                                    }
                                </MudAvatar>
                                <div class="eds-profile-menu-name">@GetFullUserName(context.User)</div>
                                <div class="eds-profile-menu-role">@GetRoleLabel(context.User)</div>
                            </div>
                            <MudMenuItem Icon="@Icons.Material.Filled.AccountCircle"
                                         OnClick="AbrirPerfil">
                                Mi Perfil
                            </MudMenuItem>
                            <MudDivider Class="my-1" />
                            <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                                         IconColor="Color.Error"
                                         OnClick="CerrarSesionAsync">
                                Cerrar Sesión
                            </MudMenuItem>
                        </ChildContent>
                    </MudMenu>

                </div>
            </Authorized>
        </AuthorizeView>

    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Always"
               Elevation="1"
               Width="268px"
               Class="eds-drawer"
               Style="z-index:1200;">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="eds-main-content">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-6 pb-10 px-4">

            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="eds-error-card">
                        <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline"
                                 Style="font-size:3rem; color:#EF767A;"
                                 Class="mb-3" />
                        <MudText Typo="Typo.h6"
                                 Style="font-weight:700; color:#1a2d45; margin-bottom:0.5rem;">
                            Algo salió mal en esta pantalla
                        </MudText>
                        <MudText Typo="Typo.body2"
                                 Style="color:#6a7d98; line-height:1.6; margin-bottom:1.5rem;">
                            Se produjo un error inesperado. El resto del sistema sigue funcionando
                            con normalidad. Podés intentar recargar esta pantalla.
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   OnClick="RecargarPagina"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   Style="background:#456990; color:#fff; border-radius:8px; text-transform:none; font-weight:600;">
                            Recargar pantalla
                        </MudButton>
                    </div>
                </ErrorContent>
            </ErrorBoundary>

        </MudContainer>
    </MudMainContent>

</MudLayout>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; } = null!;

    private bool _drawerOpen = true;
    private bool _saliendo = false;
    private ErrorBoundary? _errorBoundary;

    private readonly MudTheme _theme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#456990",
            Secondary = "#EF767A",
            Tertiary = "#49BEAA",
            Success = "#49DCB1",
            Warning = "#EEB868",
            AppbarBackground = "#456990",
            Background = "#f0f3f8",
            DrawerBackground = "#ffffff",
            TextPrimary = "#1a2d45",
            TextSecondary = "#6a7d98",
        },
        Typography = new Typography
        {
            Default = new Default
            {
                FontFamily = new[] { "Plus Jakarta Sans", "Segoe UI", "system-ui", "sans-serif" }
            }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        _drawerOpen = true;
        await authenticationStateTask;
    }

    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void RecargarPagina()
    {
        _errorBoundary?.Recover();
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private void AbrirSoporteInterno()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var parameters = new DialogParameters { ["EsPublico"] = false };
        DialogService.Show<DialogoNuevoTicket>("Nuevo Ticket de Soporte", parameters, options);
    }

    private async Task CerrarSesionAsync()
    {
        try
        {
            _saliendo = true;
            StateHasChanged();
            await AuthService.LogoutAsync();
            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch
        {
            Snackbar.Add("Ocurrió un problema al cerrar sesión.", Severity.Error);
            _saliendo = false;
        }
    }

    private async Task AbrirPerfil()
    {
        var authState = await authenticationStateTask;
        var user = authState.User;

        if (user.IsInRole("Docente")) Navigation.NavigateTo("/docente/mi-perfil");
        else if (user.IsInRole("Alumno")) Navigation.NavigateTo("/alumno/perfil");
        else
        {
            var opts = new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                NoHeader = true,
                CloseButton = false,
                BackdropClick = true
            };
            DialogService.Show<DialogoPerfil>("", opts);
        }
    }

    private string GetFullUserName(ClaimsPrincipal user)
    {
        var nombre = user.FindFirst("Nombre")?.Value ?? user.FindFirst(ClaimTypes.GivenName)?.Value;
        var apellido = user.FindFirst("Apellido")?.Value ?? user.FindFirst(ClaimTypes.Surname)?.Value;
        return !string.IsNullOrEmpty(nombre) ? $"{nombre} {apellido}".Trim() : user.Identity?.Name ?? "Usuario";
    }

    private string GetUserInitial(ClaimsPrincipal user)
    {
        var name = GetFullUserName(user);
        return string.IsNullOrEmpty(name) ? "U" : name[0].ToString().ToUpper();
    }

    private string? ObtenerFotoPerfil(ClaimsPrincipal user)
    {
        var foto = user.FindFirst("FotoPerfilUrl")?.Value;
        return string.IsNullOrWhiteSpace(foto) || foto == "null" ? null : foto;
    }

    private Color GetAvatarColor(ClaimsPrincipal user)
    {
        if (user.IsInRole("Administrador") && user.IsInRole("Docente")) return Color.Dark;
        if (user.IsInRole("Docente")) return Color.Tertiary;
        if (user.IsInRole("Alumno")) return Color.Secondary;
        return Color.Primary;
    }

    private string GetRoleLabel(ClaimsPrincipal user)
    {
        var structural = new[] { "Administrador", "Secretaria Academica", "Coordinador", "Docente", "Alumno" };
        var assigned = user.FindAll(ClaimTypes.Role).Select(c => c.Value).Where(r => structural.Contains(r)).ToList();
        if (assigned.Count > 1) return "MULTIRROL";
        if (user.IsInRole("Administrador")) return "ADMINISTRADOR";
        if (user.IsInRole("Secretaria Academica")) return "SECRETARÍA";
        if (user.IsInRole("Coordinador")) return "COORDINADOR";
        if (user.IsInRole("Docente")) return "DOCENTE";
        if (user.IsInRole("Alumno")) return "ALUMNO REGULAR";
        return "USUARIO";
    }
}