@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Microsoft.JSInterop
@using EduSys.Web.Services.Interfaces

@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject IAuthService AuthService

@implements IDisposable

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Lora:wght@500&family=DM+Mono:wght@400&display=swap');

    :root {
        --eds-blue: #456990;
        --eds-teal: #49BEAA;
        --eds-mint: #49DCB1;
        --eds-amber: #EEB868;
        --eds-coral: #EF767A;
        --eds-dark: #1a2d45;
        --eds-darker: #132237;
    }

    .nm {
        height: 100%;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        user-select: none;
        overflow: hidden;
    }

    .nm-profile {
        padding: 1.125rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: 1px solid #eef1f6;
        background: linear-gradient(160deg, #f8fafc 0%, #ffffff 100%);
        flex-shrink: 0;
    }

    .nm-profile-info {
        flex: 1;
        overflow: hidden;
    }

    .nm-profile-name {
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--eds-dark);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.2;
        margin-bottom: 2px;
    }

    .nm-profile-email {
        font-size: 0.68rem;
        color: #8a9ab5;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 4px;
    }

    .nm-role-badge {
        display: inline-block;
        font-size: 0.58rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: var(--eds-blue);
        background: #eef4fb;
        border: 1px solid #d0dff0;
        padding: 2px 7px;
        border-radius: 4px;
    }

    .nm-search {
        margin: 0.75rem 1rem;
        padding: 0.5rem 0.75rem;
        background: #f4f6fa;
        border: 1px solid #e2e8f2;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        transition: border-color 0.15s, background 0.15s;
        flex-shrink: 0;
    }

        .nm-search:hover {
            border-color: var(--eds-teal);
            background: #ffffff;
        }

    .nm-search-text {
        flex: 1;
        font-size: 0.75rem;
        color: #a0aec0;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .nm-kbd {
        background: #ffffff;
        border: 1px solid #dde3ec;
        border-radius: 4px;
        padding: 1px 6px;
        font-size: 0.6rem;
        font-weight: 700;
        color: #a0aec0;
        font-family: 'DM Mono', monospace;
    }

    .nm-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 0.5rem 0.75rem 1rem;
    }

        .nm-scroll::-webkit-scrollbar {
            width: 3px;
        }

        .nm-scroll::-webkit-scrollbar-thumb {
            background: #dde3ec;
            border-radius: 3px;
        }

    .nm-section {
        font-size: 0.58rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.8px;
        color: #b0bcce;
        padding: 0.875rem 0.5rem 0.3rem;
        border-bottom: 1px solid #f0f3f8;
        margin-bottom: 0.2rem;
    }

        .nm-section:first-child {
            padding-top: 0.3rem;
        }

    .nm-link-wrap {
        position: relative;
        margin-bottom: 1px;
    }

        .nm-link-wrap .mud-nav-link {
            font-family: 'Plus Jakarta Sans', sans-serif !important;
            font-size: 0.79rem !important;
            font-weight: 500 !important;
            color: #3a4d65 !important;
            border-radius: 7px !important;
            padding: 0.55rem 0.625rem !important;
            transition: background 0.13s, color 0.13s, transform 0.13s !important;
            display: flex !important;
            align-items: center !important;
        }

            .nm-link-wrap .mud-nav-link:hover {
                background: #f0f5fb !important;
                color: var(--eds-dark) !important;
                transform: translateX(2px) !important;
            }

            .nm-link-wrap .mud-nav-link.active {
                background: #e8f2fb !important;
                color: var(--eds-blue) !important;
                font-weight: 600 !important;
            }

        .nm-link-wrap .mud-nav-link-icon {
            color: #8a9ab5 !important;
            min-width: 22px !important;
            margin-right: 10px !important;
            font-size: 1.1rem !important;
            transition: color 0.13s !important;
        }

        .nm-link-wrap .mud-nav-link.active .mud-nav-link-icon {
            color: var(--eds-teal) !important;
        }

    .nm-fav-btn {
        position: absolute;
        right: 6px;
        top: 50%;
        transform: translateY(-50%);
        opacity: 0;
        transition: opacity 0.15s;
        cursor: pointer;
        color: #c5cdd9;
        background: transparent;
        border: none;
        padding: 3px;
        border-radius: 4px;
        z-index: 10;
        line-height: 1;
    }

        .nm-link-wrap:hover .nm-fav-btn,
        .nm-fav-btn.pinned {
            opacity: 1;
        }

        .nm-fav-btn.pinned {
            color: var(--eds-amber);
        }

        .nm-fav-btn:hover {
            color: var(--eds-amber);
            transform: translateY(-50%) scale(1.15);
        }

    .nm-favs-section {
        margin-bottom: 0.75rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px dashed #e8edf5;
    }

    .nm-footer {
        padding: 0.75rem 1rem;
        border-top: 1px solid #eef1f6;
        background: #fafbfd;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .nm-footer-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.625rem;
        border-radius: 7px;
        font-size: 0.77rem;
        font-weight: 500;
        cursor: pointer;
        border: none;
        background: transparent;
        font-family: 'Plus Jakarta Sans', sans-serif;
        transition: background 0.12s;
        width: 100%;
        text-align: left;
        color: #4a5e75;
    }

        .nm-footer-btn:hover {
            background: #f0f3f8;
        }

        .nm-footer-btn.danger {
            color: var(--eds-coral);
        }

            .nm-footer-btn.danger:hover {
                background: #fff0f0;
            }

    .nm-overlay {
        position: fixed;
        inset: 0;
        background: rgba(26, 45, 69, 0.45);
        backdrop-filter: blur(4px);
        z-index: 2000;
        display: flex;
        justify-content: center;
        padding-top: 10vh;
        animation: nm-fade-in 0.18s ease-out;
    }

    .nm-palette {
        width: 580px;
        max-width: 92%;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 24px 48px -8px rgba(26,45,69,0.28), 0 0 0 1px #e2e8f2;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        max-height: 480px;
        animation: nm-slide-in 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .nm-palette-input-wrap {
        padding: 1rem 1.125rem;
        border-bottom: 1px solid #eef1f6;
        display: flex;
        align-items: center;
        gap: 0.625rem;
    }

    .nm-palette-input {
        flex: 1;
        font-size: 1rem;
        border: none;
        outline: none;
        color: var(--eds-dark);
        font-weight: 500;
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: transparent;
    }

        .nm-palette-input::placeholder {
            color: #b0bcce;
        }

    .nm-palette-results {
        flex: 1;
        overflow-y: auto;
        padding: 6px 0;
    }

        .nm-palette-results::-webkit-scrollbar {
            width: 3px;
        }

        .nm-palette-results::-webkit-scrollbar-thumb {
            background: #dde3ec;
        }

    .nm-palette-item {
        padding: 0.75rem 1.125rem;
        display: flex;
        align-items: center;
        gap: 0.875rem;
        cursor: pointer;
        border-left: 3px solid transparent;
        transition: background 0.1s, border-color 0.1s;
    }

        .nm-palette-item:hover,
        .nm-palette-item.sel {
            background: #f4f8fc;
            border-left-color: var(--eds-teal);
        }

    .nm-palette-item-title {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--eds-dark);
    }

    .nm-palette-item-cat {
        font-size: 0.68rem;
        color: #a0aec0;
        margin-top: 1px;
    }

    .nm-palette-empty {
        padding: 3rem;
        text-align: center;
        font-size: 0.8rem;
        color: #a0aec0;
    }

    @@keyframes nm-fade-in {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes nm-slide-in {
        from {
            opacity: 0;
            transform: translateY(-16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="nm">

    <AuthorizeView>
        <Authorized>
            <div class="nm-profile">
                <MudAvatar Size="Size.Medium" Elevation="1" Color="@GetAvatarColor(context.User)">
                    @if (!string.IsNullOrEmpty(FotoPerfilUsuario))
                    {
                        <MudImage Src="@FotoPerfilUsuario" Style="width:100%;height:100%;object-fit:cover;" />
                    }
                    else
                    {

                        @UserInitial
                    }
                </MudAvatar>
                <div class="nm-profile-info">
                    <div class="nm-profile-name">@NombreUsuario</div>
                    <div class="nm-profile-email">@UserEmail</div>
                    <span class="nm-role-badge">@RoleFull</span>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    <div class="nm-search" @onclick="OpenCommandPalette">
        <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Style="color:#a0aec0;" />
        <span class="nm-search-text">Buscar en EduSys...</span>
        <span class="nm-kbd">Ctrl K</span>
    </div>

    <div class="nm-scroll">

        @if (favoritePages.Any())
        {
            <div class="nm-favs-section">
                <div class="nm-section" style="padding-top:0.2rem;">Favoritos</div>
                @foreach (var fav in favoritePages)
                {
                    @RenderNavLink(fav.Url, fav.Title, fav.Icon)
                }
            </div>
        }

        <AuthorizeView Context="authCtx">
            <Authorized>

                @if (authCtx.User.IsInRole("Administrador") || authCtx.User.IsInRole("Secretaria Academica"))
                {
                    <div class="nm-section">Panel de Control</div>
                    @RenderNavLink("/admin/dashboard", "Dashboard", Icons.Material.Filled.Dashboard, true)
                }

                @if (HasPermission(authCtx.User, "ACA_CARRERA_ABM", "ACA_PLAN_ABM", "ACA_MATERIA_ABM", "CFG_PARAMETROS_ACA", "CFG_SEDES_ABM"))
                {
                    <div class="nm-section">Config. Institucional</div>
                    @if (HasPermission(authCtx.User, "ACA_CARRERA_ABM"))
                        @RenderNavLink("/carreras", "Carreras", Icons.Material.Filled.AccountBalance)
                        @if (HasPermission(authCtx.User, "ACA_PLAN_ABM"))
                            @RenderNavLink("/planes", "Planes de Estudio", Icons.Material.Filled.Map)
                            @if (HasPermission(authCtx.User, "ACA_MATERIA_ABM"))
                                @RenderNavLink("/materias", "Materias", Icons.Material.Filled.Book)
                                @if (HasPermission(authCtx.User, "CFG_PARAMETROS_ACA"))
                                    @RenderNavLink("/admin/estados-materia", "Estados de Materia", Icons.Material.Filled.RuleFolder)
                                    @if (HasPermission(authCtx.User, "CFG_SEDES_ABM"))
                                        @RenderNavLink("/sedes", "Sedes", Icons.Material.Filled.Place)
                                        @if (HasPermission(authCtx.User, "CFG_PARAMETROS_ACA"))
                                            @RenderNavLink("/modalidades", "Modalidades", Icons.Material.Filled.LaptopChromebook)
                                            @if (HasPermission(authCtx.User, "CFG_PARAMETROS_ACA"))
@RenderNavLink("/regimenes", "Regímenes", Icons.Material.Filled.Rule)
                }

                @if (HasPermission(authCtx.User, "PER_PERIODO_ABM", "PER_CALENDARIO_ABM", "COM_COMISION_ABM", "COM_HORARIOS_EDIT"))
                {
                    <div class="nm-section">Planificación Académica</div>
                    @if (HasPermission(authCtx.User, "PER_PERIODO_ABM"))
                        @RenderNavLink("/periodos", "Períodos Académicos", Icons.Material.Filled.DateRange)
                        @if (HasPermission(authCtx.User, "PER_CALENDARIO_ABM"))
                            @RenderNavLink("/calendario", "Ventanas y Calendario", Icons.Material.Filled.EventAvailable)
                            @if (HasPermission(authCtx.User, "COM_COMISION_ABM"))
                                @RenderNavLink("/comisiones", "Comisiones", Icons.Material.Filled.Groups)
                                @if (HasPermission(authCtx.User, "COM_HORARIOS_EDIT"))
@RenderNavLink("/horarios", "Horarios", Icons.Material.Filled.AccessTime)
                }

                @if (HasPermission(authCtx.User, "INS_CURSADA_GESTION", "ASIS_VER", "ASIS_CARGAR"))
                {
                    <div class="nm-section">Operaciones de Cursada</div>
                    @if (HasPermission(authCtx.User, "INS_CURSADA_GESTION"))
                        @RenderNavLink("/admin/inscripciones", "Forzar Inscripciones", Icons.Material.Filled.HowToReg)
                        @if (HasPermission(authCtx.User, "ASIS_VER", "ASIS_CARGAR"))
@RenderNavLink("/asistencia", "Auditoría Asistencias", Icons.Material.Filled.FactCheck)
                }

                @if (HasPermission(authCtx.User, "ALU_ABM", "DOC_ABM", "SOL_GESTION"))
                {
                    <div class="nm-section">Comunidad</div>
                    @if (HasPermission(authCtx.User, "ALU_ABM"))
                        @RenderNavLink("/alumnos", "Alumnos / Legajos", Icons.Material.Filled.Person)
                        @if (HasPermission(authCtx.User, "DOC_ABM"))
                            @RenderNavLink("/docentes", "Docentes", Icons.Material.Filled.Face)
                            @if (HasPermission(authCtx.User, "SOL_GESTION"))
@RenderNavLink("/admin/solicitudes", "Solicitudes Ingreso", Icons.Material.Filled.AssignmentInd)
                }

                @if (HasPermission(authCtx.User, "SEG_USUARIOS_ABM", "SEG_ROLES_ABM", "SOP_GESTION_TICKETS") || authCtx.User.IsInRole("Administrador") || authCtx.User.IsInRole("Secretaria Academica"))
                {
                    <div class="nm-section">Sistema</div>

                    @if (HasPermission(authCtx.User, "SOP_GESTION_TICKETS") || authCtx.User.IsInRole("Administrador") || authCtx.User.IsInRole("Secretaria Academica"))
                    {
                        @RenderNavLink("/admin/tickets", "Gestión de Tickets", Icons.Material.Filled.ConfirmationNumber)
                    }

                    @if (HasPermission(authCtx.User, "SEG_USUARIOS_ABM", "SEG_ROLES_ABM"))
                    {
                        <div class="nm-section">Seguridad</div>
                        @if (HasPermission(authCtx.User, "SEG_USUARIOS_ABM"))
                            @RenderNavLink("/usuarios", "Usuarios y Cuentas", Icons.Material.Filled.Security)
                            @if (HasPermission(authCtx.User, "SEG_ROLES_ABM"))
@RenderNavLink("/admin/roles", "Roles y Permisos", Icons.Material.Filled.AdminPanelSettings)
                    }
                }

                @if (authCtx.User.IsInRole("Alumno"))
                {
                    <div class="nm-section" style="color:#49BEAA;">Mi Espacio Alumno</div>
                    @RenderNavLink("/dashboard-alumno", "Inicio", Icons.Material.Filled.Home, true)
                    @RenderNavLink("/alumno/mis-cursadas", "Mis Notas", Icons.Material.Filled.Grade)
                    @RenderNavLink("/alumno/asistencias", "Mis Asistencias", Icons.Material.Filled.FactCheck)
                    @RenderNavLink("/horarios-alumno", "Mis Horarios", Icons.Material.Filled.AccessTime)
                    @RenderNavLink("/inscripcion-materias", "Cursar Materias", Icons.Material.Filled.Class)
                    @RenderNavLink("/alumno/inscripcion-finales", "Rendir Finales", Icons.Material.Filled.AssignmentTurnedIn)
                    @RenderNavLink("/historia-academica", "Historia Académica", Icons.Material.Filled.HistoryEdu)
                    @RenderNavLink("/tramites", "Trámites y Certificados", Icons.Material.Filled.Description)
                    @RenderNavLink("/mis-tickets", "Mis Tickets de Ayuda", Icons.Material.Filled.SupportAgent)
                }

                @if (authCtx.User.IsInRole("Docente"))
                {
                    <div class="nm-section" style="color:#EEB868;">Mi Espacio Docente</div>
                    @RenderNavLink("/dashboard-docente", "Inicio", Icons.Material.Filled.Home, true)
                    @RenderNavLink("/mis-comisiones", "Mis Comisiones", Icons.Material.Filled.Groups)
                    @RenderNavLink("/docente/tomar-asistencia", "Control de Asistencia", Icons.Material.Filled.FactCheck)
                    @RenderNavLink("/mis-tickets", "Soporte Técnico", Icons.Material.Filled.SupportAgent)
                }

            </Authorized>
        </AuthorizeView>

    </div>

    <div class="nm-footer">
        <button class="nm-footer-btn" @onclick="AbrirPerfil">
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Small" Style="color:#8a9ab5;" />
            Mi Perfil
        </button>
        <button class="nm-footer-btn danger" @onclick="CerrarSesion">
            <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" />
            Cerrar sesión
        </button>
    </div>

</div>

@if (showCommandPalette)
{
    <div class="nm-overlay" @onclick="CloseCommandPalette">
        <div class="nm-palette" @onclick:stopPropagation="true">

            <div class="nm-palette-input-wrap">
                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Style="color:#a0aec0; flex-shrink:0;" />
                <input class="nm-palette-input"
                       placeholder="Buscar sección, acción o página..."
                       value="@commandSearch"
                       @oninput="HandleSearchInput"
                       @ref="commandInputRef"
                       @onkeydown="HandleCommandKeyDown" />
                @if (!string.IsNullOrEmpty(commandSearch))
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                   Size="Size.Small"
                                   Style="color:#a0aec0; width:24px; height:24px;"
                                   OnClick="@(() => { commandSearch = string.Empty; filteredCommands = allCommands.ToList(); })" />
                }
            </div>

            <div class="nm-palette-results">
                @if (filteredCommands.Any())
                {
                    @foreach (var (cmd, idx) in filteredCommands.Select((x, i) => (x, i)))
                    {
                        <div class="nm-palette-item @(idx == selectedCommandIndex ? "sel" : "")"
                             @onclick="() => ExecuteCommand(cmd)">
                            <MudIcon Icon="@cmd.Icon" Size="Size.Small" Style="color:#456990; flex-shrink:0;" />
                            <div>
                                <div class="nm-palette-item-title">@cmd.Title</div>
                                <div class="nm-palette-item-cat">@cmd.Category</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="nm-palette-empty">
                        Sin resultados para "<strong>@commandSearch</strong>"
                    </div>
                }
            </div>

        </div>
    </div>
}

@code {
    private string FotoPerfilUsuario = "";
    private string NombreUsuario = "Cargando...";
    private string UserEmail = "";
    private string UserInitial = "U";
    private string RoleFull = "";
    private string UserId = "";

    private bool showCommandPalette = false;
    private string commandSearch = "";
    private int selectedCommandIndex = 0;
    private ElementReference commandInputRef;
    private List<CommandItem> allCommands = new();
    private List<CommandItem> filteredCommands = new();
    private DotNetObjectReference<NavMenu>? _dotNetRef;

    private List<NavPage> favoritePages = new();
    private string FavoritesKey => string.IsNullOrEmpty(UserId)
        ? "edusys_favorites_guest"
        : $"edusys_favorites_{UserId}";

    private RenderFragment RenderNavLink(string href, string title, string icon, bool matchAll = false) => __builder =>
    {
        <div class="nm-link-wrap">
            <MudNavLink Href="@href"
                        Match="@(matchAll ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                        Class="mud-nav-link">
                <MudIcon Icon="@icon" Class="mud-nav-link-icon" Size="Size.Small" />
                @title
            </MudNavLink>
            <button class="nm-fav-btn @(IsFavorite(href) ? "pinned" : "")"
                    @onclick="() => ToggleFavorite(href, title, icon)">
                <MudIcon Icon="@(IsFavorite(href) ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                         Size="Size.Small" />
            </button>
        </div>
    };

    private bool HasPermission(ClaimsPrincipal user, params string[] permissions)
        => user.IsInRole("Administrador") || permissions.Any(p => user.IsInRole(p));

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            NombreUsuario = GetFullUserName(user);
            UserEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? user.FindFirst("email")?.Value ?? "";
            UserInitial = string.IsNullOrEmpty(NombreUsuario) ? "U" : NombreUsuario[0].ToString().ToUpper();
            FotoPerfilUsuario = user.FindFirst("FotoPerfilUrl")?.Value ?? "";
            UserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? user.FindFirst("sub")?.Value ?? "";

            var structuralRoles = new[] { "Administrador", "Secretaria Academica", "Coordinador", "Docente", "Alumno" };
            var assigned = user.FindAll(ClaimTypes.Role).Select(c => c.Value).Where(r => structuralRoles.Contains(r)).ToList();

            RoleFull = assigned.Count > 1 ? "Perfil Multirrol"
                     : user.IsInRole("Administrador") ? "Administrador del Sistema"
                     : user.IsInRole("Secretaria Academica") ? "Secretaría Académica"
                     : user.IsInRole("Coordinador") ? "Coordinador de Carrera"
                     : user.IsInRole("Docente") ? "Docente Académico"
                     : user.IsInRole("Alumno") ? "Alumno Regular"
                     : "Personal Administrativo";

            InitializeCommands(user);
        }

        await LoadFavorites();
        NavManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("eval", @"
                    (function(ref) {
                        window.addEventListener('keydown', function(e) {
                            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                                e.preventDefault();
                                ref.invokeMethodAsync('OpenCommandPaletteInstance');
                            }
                        });
                    })(arguments[0]);
                ", _dotNetRef);
            }
            catch { }
        }

        if (showCommandPalette)
        {
            try { await commandInputRef.FocusAsync(); } catch { }
        }
    }

    [JSInvokable]
    public void OpenCommandPaletteInstance() => OpenCommandPalette();

    private string GetFullUserName(ClaimsPrincipal user)
    {
        var nombre = user.FindFirst("Nombre")?.Value ?? user.FindFirst(ClaimTypes.GivenName)?.Value;
        var apellido = user.FindFirst("Apellido")?.Value ?? user.FindFirst(ClaimTypes.Surname)?.Value;
        return !string.IsNullOrEmpty(nombre) ? $"{nombre} {apellido}".Trim() : user.Identity?.Name ?? "Usuario";
    }

    private Color GetAvatarColor(ClaimsPrincipal user)
    {
        if (user.FindAll(ClaimTypes.Role).Count() > 1 && user.IsInRole("Docente") && user.IsInRole("Administrador")) return Color.Dark;
        if (user.IsInRole("Docente")) return Color.Tertiary;
        if (user.IsInRole("Alumno")) return Color.Secondary;
        return Color.Primary;
    }

    private async Task CerrarSesion()
    {
        try { await AuthService.LogoutAsync(); } catch { }
        NavManager.NavigateTo("/", forceLoad: true);
    }

    private async Task LoadFavorites()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", FavoritesKey);
            if (!string.IsNullOrEmpty(json))
                favoritePages = System.Text.Json.JsonSerializer.Deserialize<List<NavPage>>(json) ?? new();
        }
        catch { }
    }

    private async Task ToggleFavorite(string url, string title, string icon)
    {
        if (favoritePages.Any(f => f.Url == url)) favoritePages.RemoveAll(f => f.Url == url);
        else favoritePages.Add(new NavPage(url, title, icon));
        var json = System.Text.Json.JsonSerializer.Serialize(favoritePages);
        await JS.InvokeVoidAsync("localStorage.setItem", FavoritesKey, json);
    }

    private bool IsFavorite(string url) => favoritePages.Any(f => f.Url == url);

