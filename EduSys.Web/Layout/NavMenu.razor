    private void OpenCommandPalette()
    {
        showCommandPalette = true;
        commandSearch = "";
        filteredCommands = allCommands.ToList();
        selectedCommandIndex = 0;
        StateHasChanged();
    }

    private void CloseCommandPalette() => showCommandPalette = false;

    private void ExecuteCommand(CommandItem cmd)
    {
        if (cmd.Action != null) cmd.Action.Invoke();
        else NavManager.NavigateTo(cmd.Url);
        CloseCommandPalette();
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        commandSearch = e.Value?.ToString() ?? "";
        filteredCommands = string.IsNullOrWhiteSpace(commandSearch)
            ? allCommands.ToList()
            : allCommands.Where(c =>
                c.Title.Contains(commandSearch, StringComparison.OrdinalIgnoreCase) ||
                c.Category.Contains(commandSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        selectedCommandIndex = 0;
    }

    private async Task HandleCommandKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown") selectedCommandIndex = Math.Min(selectedCommandIndex + 1, filteredCommands.Count - 1);
        else if (e.Key == "ArrowUp") selectedCommandIndex = Math.Max(selectedCommandIndex - 1, 0);
        else if (e.Key == "Enter" && filteredCommands.Any()) ExecuteCommand(filteredCommands[selectedCommandIndex]);
        else if (e.Key == "Escape") CloseCommandPalette();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => StateHasChanged();

    private async Task AbrirPerfil()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.IsInRole("Docente")) NavManager.NavigateTo("/docente/mi-perfil");
        else if (user.IsInRole("Alumno")) NavManager.NavigateTo("/alumno/perfil");
        else
        {
            var opts = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true, CloseButton = false, BackdropClick = true };
            DialogService.Show<DialogoPerfil>("", opts);
        }
        CloseCommandPalette();
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        _dotNetRef?.Dispose();
    }

    private record NavPage(string Url, string Title, string Icon);
    private class CommandItem
    {
        public string Title { get; set; } = "";
        public string Category { get; set; } = "";
        public string Url { get; set; } = "";
        public string Icon { get; set; } = "";
        public Func<Task>? Action { get; set; }
    }
