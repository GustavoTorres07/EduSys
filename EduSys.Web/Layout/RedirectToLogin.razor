@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components

@* Ocultamos el layout principal (menú lateral, etc.) por si el usuario no está logueado *@
@layout EmptyLayout

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="height: 100vh;">
    <MudPaper Elevation="4" Class="pa-8 text-center rounded-lg" Style="max-width: 450px; border-top: 4px solid #456990;">
        <MudIcon Icon="@Icons.Material.Filled.LockPerson" Color="Color.Primary" Style="font-size: 4rem;" Class="mb-4" />
        
        <MudText Typo="Typo.h5" Style="font-weight: 700; color: #1e293b;" Class="mb-2">
            Acceso Restringido
        </MudText>
        
        <MudText Typo="Typo.body1" Style="color: #64748b;" Class="mb-6">
            Tu sesión ha expirado o necesitas identificarte para ver esta página.
            Te estamos redirigiendo al inicio de sesión de forma segura...
        </MudText>
        
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
    </MudPaper>
</MudContainer>

@code {
    protected override async Task OnInitializedAsync()
    {
        // 1. Capturamos la ruta exacta a la que el usuario intentaba acceder
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);

        // 2. Le damos 1.5 segundos al usuario para leer el mensaje (Excelente UX)
        await Task.Delay(1500);

        // 3. Redirigimos al Login pasando el returnUrl como parámetro.
        // Ejemplo: /?returnUrl=alumno/mis-notas
        if (string.IsNullOrWhiteSpace(returnUrl))
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            // Usamos Uri.EscapeDataString para que los caracteres especiales (como / o ?) no rompan la URL
            Navigation.NavigateTo($"/?returnUrl={Uri.EscapeDataString(returnUrl)}");
        }
    }
}