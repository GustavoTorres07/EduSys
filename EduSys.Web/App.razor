@using Microsoft.AspNetCore.Components.Authorization
@using EduSys.Web.Layout

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-16">
                            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mt-4">
                                Acceso Denegado: No tienes los permisos o roles necesarios para ver esta página.
                            </MudAlert>
                        </MudContainer>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Página no encontrada</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-16 d-flex flex-column align-center">
                    <MudText Typo="Typo.h1" Color="Color.Primary" Class="mb-4">404</MudText>
                    <MudText Typo="Typo.h5" Class="mb-6">Lo sentimos, la página que intentas buscar no existe o fue movida.</MudText>
                    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">
                        Volver al Inicio
                    </MudButton>
                </MudContainer>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>